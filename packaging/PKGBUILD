# Maintainer: Ville Kivelä <5814559+villekivela@users.noreply.github.com>
#
# The engine Omaweb ships, built from Qt's released source with the patch
# series applied (ADR 0049). It installs into /usr/lib/omaweb and never
# replaces the distribution's qt6-webengine, so every other Qt application on
# the machine keeps the engine it had.
#
# This packages a tarball a builder already produced, because the build takes
# hours on a machine rented for it and signing happens where the key is. Run
# scripts/build-on-hetzner.sh, or scripts/build-locally.sh, to produce the
# tarball, then run makepkg from a directory holding both it and this file.

pkgname=omaweb-qtwebengine
pkgver=6.11.3
pkgrel=1
pkgdesc="QtWebEngine with Omaweb's extension patches, installed beside Omaweb"
arch=('x86_64' 'aarch64')
url="https://github.com/villekivela/omaweb-qtwebengine-patches"
# QtWebEngine is LGPL-3.0, and this is a modified build of it: the patches are
# published at the url above, and the library stays separate so it can be
# relinked. Chromium's own code is BSD-3-Clause.
license=('LGPL-3.0-only' 'BSD-3-Clause')
# What the engine's own libraries and QtWebEngineProcess link against, from
# their DT_NEEDED entries, less what glibc, gcc-libs and the Qt packages in the
# list already bring. A clean Arch install has none of the media and image
# libraries, so leaving one out fails at load time on the reader's machine.
#
# The engine uses Qt's private API, which promises nothing across a Qt minor.
# It is built against the Qt its readers have, Omarchy's stable mirror on
# x86_64 and Arch Linux ARM on aarch64, because an engine built against an
# older Qt runs on a newer one and not the other way round (omaweb#674). So Qt's
# floor is the Qt it was built against, which differs by architecture and is
# known only where it was built: `build-inside.sh` passes it in, and
# `package-locally.sh` reads it from the build's engine.json. A floor at the
# readers' own Qt holds nobody back. What held every Omarchy reader back in
# omaweb#674 was an engine built against a Qt they did not have. There is no
# upper bound, which would hold back a reader's system upgrade (omaweb#660).
_qt="${OMAWEB_ENGINE_QT:-}"
depends=("qt6-base>=${_qt}" "qt6-declarative>=${_qt}" 'qt6-positioning' 'qt6-webchannel' 'nss'
         'libxkbcommon' 'alsa-lib' 'dbus' 'expat' 'fontconfig' 'freetype2' 'harfbuzz' 'lcms2'
         'libglvnd' 'libjpeg-turbo' 'libpng' 'libtiff' 'libwebp' 'libxml2' 'libxslt' 'mesa'
         'minizip' 'openjpeg2' 'opus' 'snappy' 'systemd-libs' 'zlib')
# Only Qt Designer loads the QWebEngineView plugin, and it links libQt6Designer.
optdepends=('qt6-tools: the QWebEngineView plugin for Qt Designer')

# The notices travel with this file rather than with the tarball, so correcting
# one does not cost a rebuild.
source=('MODIFICATIONS.md' 'LGPL-3.0-only.txt' 'chromium-LICENSE.txt')
sha256sums=('3e683e8b6d581ae22e19ffc072a276a7aa1dac01982257d0bd4631519243d923'
            'da7eabb7bafdf7d3ae5e9f223aa5bdc1eece45ac569dc21b3b037520b4464768'
            '368cca1106be99d39ecd32a38d8305585d802a475effb66380b91ffc9bcf709b')

# Per architecture, because the tarball names the architecture it was built
# for. `uname -m` would name the machine running makepkg, which is not the same
# claim and is wrong the first time anything cross-builds.
source_x86_64=("omaweb-qtwebengine-${pkgver}-x86_64.tar.zst")
source_aarch64=("omaweb-qtwebengine-${pkgver}-aarch64.tar.zst")
# SKIP, and not because nobody got round to recording a hash. The tarball is
# not a download: it is an artifact a builder produced minutes earlier, and any
# rebuild of the same Qt version produces a different one, so a recorded hash
# would refuse every build after the one it was taken from. What checks the
# tarball is `SHA256SUMS`, written beside it by the build that made it and
# verified by `package-locally.sh` where the two have been apart.
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

# The tarball is a finished release install tree. Stripping it again would cost
# minutes and change nothing, and a debug package split out of someone else's
# build output is not a debug package.
options=('!strip')

package() {
    # A package without its Qt floor installs beside a Qt the engine was not
    # built for, and fails only when a reader starts it.
    if [ -z "${_qt}" ]; then
        echo "OMAWEB_ENGINE_QT is not set: name the Qt this engine was built against" >&2
        return 1
    fi

    # The tarball is already an install tree rooted at /usr/lib/omaweb.
    cp -a "${srcdir}/usr" "${pkgdir}/usr"

    # Object files from compiling the test mock delegates' resources. Qt's
    # install step copies them beside the plugin and nothing loads them.
    rm -rf "${pkgdir}/usr/lib/omaweb/lib/qt6/qml/QtWebEngine/TestMockDelegates/objects-Release"

    # A reader who has this binary is entitled to know it is a modified
    # QtWebEngine and to find the changes. No `|| true`: a package that
    # silently ships without its notices is the failure this guards against.
    install -Dm644 "${srcdir}/MODIFICATIONS.md" \
        "${pkgdir}/usr/share/licenses/${pkgname}/MODIFICATIONS.md"
    install -Dm644 "${srcdir}/LGPL-3.0-only.txt" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LGPL-3.0-only.txt"
    install -Dm644 "${srcdir}/chromium-LICENSE.txt" \
        "${pkgdir}/usr/share/licenses/${pkgname}/chromium-LICENSE.txt"
}
