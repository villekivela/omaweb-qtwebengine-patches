diff --git a/src/core/CMakeLists.txt b/src/core/CMakeLists.txt
index 5dc3029..38a90f0 100644
--- a/src/core/CMakeLists.txt
+++ b/src/core/CMakeLists.txt
@@ -341,6 +341,19 @@ foreach(arch ${archs})
         append_toolchain_setup(gnArgArg)
         append_pkg_config_setup(gnArgArg)
 
+        # Chrome's own profile for this Chromium, when one is given. Functions the series or Qt
+        # changed fall back to their unprofiled code, which clang reports and does not refuse.
+        if(OMAWEB_PGO_PROFILE)
+            list(APPEND gnArgArg chrome_pgo_phase=2 pgo_data_path="${OMAWEB_PGO_PROFILE}")
+        else()
+            list(APPEND gnArgArg chrome_pgo_phase=0)
+        endif()
+        # V8's own profile for its builtins, which V8 takes only with Chrome's unless asked. Its
+        # x64 profile applies on arm64 as well.
+        if(OMAWEB_V8_BUILTINS_PGO)
+            list(APPEND gnArgArg v8_enable_builtins_optimization=true)
+        endif()
+
         list(APPEND gnArgArg
             qtwebengine_target="${buildDir}/${config}/${arch}:QtWebEngineCore"
             build_dawn_tests=false
@@ -348,7 +361,6 @@ foreach(arch ${archs})
             webnn_use_tflite=false
             is_qtwebengine=true
             is_qtpdf=false
-            chrome_pgo_phase=0
             disable_fieldtrial_testing_config=true
             enable_background_contents=false
             enable_background_mode=false
