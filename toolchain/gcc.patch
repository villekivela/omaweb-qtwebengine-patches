diff --git a/src/3rdparty/chromium/build/config/compiler/BUILD.gn b/src/3rdparty/chromium/build/config/compiler/BUILD.gn
--- a/src/3rdparty/chromium/build/config/compiler/BUILD.gn
+++ b/src/3rdparty/chromium/build/config/compiler/BUILD.gn
@@ -711,6 +711,13 @@
     ldflags += [ "-Wl,-z,keep-text-section-prefix" ]
   }
 
+  # Chromium compiles without fused multiply-adds in the block below, which Qt skips. GCC fuses
+  # them by default and every aarch64 has FMA, so without this the GCC engine rounds otherwise
+  # than clang does (villekivela/omaweb-qtwebengine-patches#34).
+  if (!is_clang && !is_win) {
+    cflags += [ "-ffp-contract=off" ]
+  }
+
   if (is_clang && !is_qtwebengine) {
     cflags += [ "-fcrash-diagnostics-dir=" + clang_diagnostic_dir ]
     if (save_reproducers_on_lld_crash && use_lld) {
