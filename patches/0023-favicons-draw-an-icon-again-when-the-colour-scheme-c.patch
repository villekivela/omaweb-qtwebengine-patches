+// How light the opaque pixels of an icon are, from 0 to 255, or -1 for none.
+static int lightness(const QIcon &icon)
+{
+    const QImage image = icon.pixmap(QSize(32, 32)).toImage();
+    int opaque = 0;
+    qint64 sum = 0;
+    for (int y = 0; y < image.height(); ++y) {
+        for (int x = 0; x < image.width(); ++x) {
+            const QColor colour = image.pixelColor(x, y);
+            if (colour.alpha() > 128) {
+                ++opaque;
+                sum += colour.lightness();
+            }
+        }
+    }
+    return opaque ? int(sum / opaque) : -1;
+}
+
+// An SVG favicon that follows prefers-color-scheme is drawn under the scheme
+// the page is told. A page on show draws it again when that scheme changes.
+void tst_Favicon::redrawOnColorSchemeChange()
+{
+    QTemporaryDir tmpDir;
+    QWebEngineProfile profile("scheme");
+    profile.setPersistentStoragePath(tmpDir.path());
+    QWebEnginePage page(&profile);
+    QSignalSpy loadFinishedSpy(&page, &QWebEnginePage::loadFinished);
+    useColorScheme(Qt::ColorScheme::Light);
+
+    page.load(QUrl("qrc:/resources/favicon-scheme.html"));
+    QTRY_COMPARE_WITH_TIMEOUT(loadFinishedSpy.size(), 1, 30000);
+    QTRY_VERIFY(!page.icon().isNull());
+    QCOMPARE_LT(lightness(page.icon()), 64);
+
+    QSignalSpy iconChangedSpy(&page, &QWebEnginePage::iconChanged);
+    useColorScheme(Qt::ColorScheme::Dark);
+    QTRY_COMPARE(evaluateJavaScriptSync(&page, "matchMedia('(prefers-color-scheme: dark)').matches"),
+                 QVariant(true));
+    QTRY_VERIFY_WITH_TIMEOUT(lightness(page.icon()) > 192, 10000);
+    QTRY_VERIFY(!iconChangedSpy.isEmpty()
+                && lightness(iconChangedSpy.last().at(0).value<QIcon>()) > 192);
+}
+
+// A page not on show when the colour scheme changes draws its icon afresh on
+// its next visit, rather than showing the drawing the profile kept.
+void tst_Favicon::redrawOnNextVisitAfterColorSchemeChange()
+{
+    QTemporaryDir tmpDir;
+    QWebEngineProfile profile("schemeVisit");
+    profile.setPersistentStoragePath(tmpDir.path());
+    QWebEnginePage page(&profile);
+    QSignalSpy loadFinishedSpy(&page, &QWebEnginePage::loadFinished);
+    useColorScheme(Qt::ColorScheme::Light);
+
+    const QUrl schemePage("qrc:/resources/favicon-scheme.html");
+    page.load(schemePage);
+    QTRY_COMPARE_WITH_TIMEOUT(loadFinishedSpy.size(), 1, 30000);
+    QTRY_VERIFY(!page.icon().isNull());
+    QCOMPARE_LT(lightness(page.icon()), 64);
+
+    page.load(QUrl("qrc:/resources/test1.html"));
+    QTRY_COMPARE_WITH_TIMEOUT(loadFinishedSpy.size(), 2, 30000);
+    QTRY_VERIFY(page.icon().isNull());
+    useColorScheme(Qt::ColorScheme::Dark);
+
+    QSignalSpy iconChangedSpy(&page, &QWebEnginePage::iconChanged);
+    page.load(schemePage);
+    QTRY_COMPARE_WITH_TIMEOUT(loadFinishedSpy.size(), 3, 30000);
+    QTRY_VERIFY_WITH_TIMEOUT(lightness(page.icon()) > 192, 10000);
+    QTRY_VERIFY(!iconChangedSpy.isEmpty()
+                && lightness(iconChangedSpy.last().at(0).value<QIcon>()) > 192);
+}
+
+// Whether the profile has an icon for a page, asked and answered.
+static bool hasIconFor(QWebEngineProfile &profile, const QUrl &pageUrl)
+{
+    bool answered = false;
+    bool known = false;
+    profile.requestIconForPageURL(pageUrl, 0, [&](const QIcon &icon, const QUrl &, const QUrl &) {
+        known = !icon.isNull();
+        answered = true;
+    });
+    return QTest::qWaitFor([&] { return answered; }, 5000) && known;
+}
+
+// A page can be built while the engine still tells pages another scheme than
+// the application's, as the first page of a run is. It draws its icon under
+// the scheme it is then told, and draws it again on the next change.
+void tst_Favicon::redrawAfterAPageStartsUnderAnotherScheme()
+{
+    if (QGuiApplication::styleHints()->colorScheme() != Qt::ColorScheme::Unknown)
+        QSKIP("This needs a platform that answers no colour scheme, as the offscreen one does.");
+    QTemporaryDir tmpDir;
+    QWebEngineProfile profile("schemeStart");
+    profile.setPersistentStoragePath(tmpDir.path());
+
+    // A page tells the engine to follow the application's scheme, and the
+    // dark one is then announced, so the next page is built under it.
+    QWebEnginePage first(&profile);
+    QSignalSpy firstLoaded(&first, &QWebEnginePage::loadFinished);
+    first.load(QUrl("qrc:/resources/test1.html"));
+    QTRY_COMPARE_WITH_TIMEOUT(firstLoaded.size(), 1, 30000);
+    Q_EMIT QGuiApplication::styleHints()->colorSchemeChanged(Qt::ColorScheme::Dark);
+
+    // Built under the dark scheme, the page is then told the application's,
+    // which answers none and so is light.
+    QWebEnginePage page(&profile);
+    QSignalSpy loadFinishedSpy(&page, &QWebEnginePage::loadFinished);
+    page.load(QUrl("qrc:/resources/favicon-scheme.html"));
+    QTRY_COMPARE_WITH_TIMEOUT(loadFinishedSpy.size(), 1, 30000);
+    QTRY_VERIFY(!page.icon().isNull());
+    QCOMPARE_LT(lightness(page.icon()), 64);
+
+    Q_EMIT QGuiApplication::styleHints()->colorSchemeChanged(Qt::ColorScheme::Dark);
+    QTRY_VERIFY_WITH_TIMEOUT(lightness(page.icon()) > 192, 10000);
+}
+
+// The engine fetches a page's icon again on a same-document navigation and
+// finds the same drawing, which is not a new icon to report.
+void tst_Favicon::sameDrawingIsNotReportedAgain()
+{
+    QTemporaryDir tmpDir;
+    QWebEngineProfile profile("sameDrawing");
+    profile.setPersistentStoragePath(tmpDir.path());
+    QWebEnginePage page(&profile);
+    QSignalSpy loadFinishedSpy(&page, &QWebEnginePage::loadFinished);
+    useColorScheme(Qt::ColorScheme::Light);
+    page.load(QUrl("qrc:/resources/favicon-scheme.html"));
+    QTRY_COMPARE_WITH_TIMEOUT(loadFinishedSpy.size(), 1, 30000);
+    QTRY_VERIFY(!page.icon().isNull());
+
+    QSignalSpy iconUrlChangedSpy(&page, &QWebEnginePage::iconUrlChanged);
+    const QUrl pushed("qrc:/resources/favicon-scheme-pushed.html");
+    evaluateJavaScriptSync(&page, "history.pushState(null, '', 'favicon-scheme-pushed.html')");
+    QTRY_COMPARE(page.url(), pushed);
+    // The engine has fetched the icon for the pushed address once the profile
+    // knows one for it. A report it makes then is queued for the next turn.
+    QTRY_VERIFY_WITH_TIMEOUT(hasIconFor(profile, pushed), 10000);
+    QTest::qWait(100);
+    QCOMPARE(iconUrlChangedSpy.size(), 0);
+}
