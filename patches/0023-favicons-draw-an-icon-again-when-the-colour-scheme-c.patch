diff --git a/src/core/web_contents_adapter.cpp b/src/core/web_contents_adapter.cpp
index 05c3632dc7..5925050797 100644
--- a/src/core/web_contents_adapter.cpp
+++ b/src/core/web_contents_adapter.cpp
@@ -459,6 +459,26 @@ ui::NativeTheme::PreferredColorScheme toWeb(Qt::ColorScheme colorScheme) {
     return colorScheme == Qt::ColorScheme::Dark ? ui::NativeTheme::PreferredColorScheme::kDark : ui::NativeTheme::PreferredColorScheme::kLight;
 }
 
+// Tells pages the application's colour scheme from now on. Setting the web
+// theme's scheme alone reached a page only when it next computed its
+// preferences, so a page on show kept the scheme it loaded under. The web
+// theme's observers hear of a change, and only of a change: the favicon
+// drivers and services draw icons again on every notice.
+static void followColorScheme()
+{
+    static bool following = false;
+    if (following)
+        return;
+    following = true;
+    QObject::connect(QGuiApplication::styleHints(), &QStyleHints::colorSchemeChanged, [](Qt::ColorScheme colorScheme) {
+        ui::NativeTheme *webTheme = ui::NativeTheme::GetInstanceForWeb();
+        if (webTheme->GetPreferredColorScheme() == toWeb(colorScheme))
+            return;
+        webTheme->set_preferred_color_scheme(toWeb(colorScheme));
+        webTheme->NotifyOnNativeThemeUpdated();
+    });
+}
