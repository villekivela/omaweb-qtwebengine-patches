+// An icon can draw itself for the colour scheme it is shown under, so when that
+// scheme changes every drawing the profile keeps is marked out of date, as a
+// reload marks one page's. A page not on show then draws its icon afresh on its
+// next visit, rather than showing the drawing made under the earlier scheme.
+class FaviconServiceQt : public favicon::FaviconServiceImpl, public ui::NativeThemeObserver
+{
+public:
+    FaviconServiceQt(std::unique_ptr<favicon::FaviconClient> faviconClient,
+                     history::HistoryService *historyService)
+        : favicon::FaviconServiceImpl(std::move(faviconClient), historyService)
+    {
+        m_themeObservation.Observe(ui::NativeTheme::GetInstanceForWeb());
+    }
+
+    void Shutdown() override
+    {
+        m_themeObservation.Reset();
+        m_tracker.TryCancelAll();
+        favicon::FaviconServiceImpl::Shutdown();
+    }
+
+    // The web theme notifies its observers when the colour scheme pages are
+    // told changes.
+    void OnNativeThemeUpdated(ui::NativeTheme *observed_theme) override
+    {
+        Q_UNUSED(observed_theme);
+        // The profile hands the service its history once it has a path, and
+        // none while it is off the record.
+        if (history::HistoryService *historyService = HistoryService())
+            historyService->SetFaviconsOutOfDateBetween(base::Time(), base::Time::Max(),
+                                                        base::DoNothing(), &m_tracker);
+    }
+
+private:
+    base::CancelableTaskTracker m_tracker;
+    base::ScopedObservation<ui::NativeTheme, ui::NativeThemeObserver> m_themeObservation{ this };
+};
+
