     FetchFavicon(url, navigation_handle->IsSameDocument());
 }
 
+// An icon can draw itself for the colour scheme it is shown under, as an SVG
+// with a prefers-color-scheme rule does, so a page on show draws its icon again
+// when that scheme changes, as a reload would.
+void FaviconDriverQt::OnNativeThemeUpdated(ui::NativeTheme *observed_theme)
+{
+    Q_UNUSED(observed_theme);
+    redrawFavicon();
+}
+
+void FaviconDriverQt::redrawFavicon()
+{
+    content::NavigationEntry *entry = web_contents()->GetController().GetLastCommittedEntry();
+    if (!entry)
+        return;
+
+    content::RenderFrameHost *rfh = web_contents()->GetPrimaryMainFrame();
+    const GURL url = rfh->GetLastCommittedURL();
+    if (!IsOffTheRecord())
+        SetFaviconOutOfDateForPage(url, false);
+
+    // The icon on show stays until the new drawing replaces it. A page still
+    // loading reports its icon's candidates once it has loaded, as it would
+    // have, and the fetch started here takes them.
+    m_completedHandlersCount = 0;
+    m_latestFavicon = FaviconStatusQt();
+    FetchFavicon(url, false);
+    if (rfh->IsDocumentOnLoadCompletedInMainFrame()) {
+        OnUpdateCandidates(url, favicon::FaviconURLsFromContentFaviconURLs(rfh->FaviconURLs()),
+                           GetManifestURL(rfh));
+    }
+}
+
 void FaviconDriverQt::SetFaviconOutOfDateForPage(const GURL &url, bool force_reload)
 {
     if (m_faviconService) {
@@ -413,13 +450,38 @@ void FaviconDriverQt::emitIconChangedIfNeeded()
     content::NavigationEntry *entry = web_contents()->GetController().GetLastCommittedEntry();
     DCHECK(entry);
 
-    if (entry->GetFavicon().url != m_latestFavicon.url) {
+    // An icon can be drawn again at the address it had: an expired one is
+    // shown from the profile and then downloaded afresh, and one that follows
+    // the colour scheme is redrawn when the scheme changes. The same drawing
+    // fetched again, as on a same-document navigation, is not new.
+    const gfx::Image &shown = entry->GetFavicon().image;
+    const gfx::Image &latest = m_latestFavicon.image;
+    const bool redrawn = entry->GetFavicon().url == m_latestFavicon.url
+            && !(shown.IsEmpty() && latest.IsEmpty())
+            && (shown.IsEmpty() || latest.IsEmpty()
+                || !gfx::BitmapsAreEqual(*shown.ToSkBitmap(), *latest.ToSkBitmap()));
+    if (entry->GetFavicon().url != m_latestFavicon.url || redrawn) {
         entry->GetFavicon().valid = m_latestFavicon.valid;
         entry->GetFavicon().url = m_latestFavicon.url;
         entry->GetFavicon().image = m_latestFavicon.image;
         web_contents()->NotifyNavigationStateChanged(content::INVALIDATE_TYPE_TAB);
     }
 
+    if (redrawn) {
+        // A view reports an icon only when its address changes, and the Quick
+        // view reads the address a turn of the event loop later. So a redrawn
+        // icon is cleared now, and its address is reported again on the next
+        // turn, unless the page has moved on by then.
+        m_viewClient->iconChanged(QUrl());
+        QMetaObject::invokeMethod(
+                QCoreApplication::instance(),
+                [driver = m_weakFactory.GetWeakPtr(), url = m_latestFavicon.url] {
+                    if (driver && driver->m_latestFavicon.url == url)
+                        driver->m_viewClient->iconChanged(toQt(url));
+                },
+                Qt::QueuedConnection);
+        return;
+    }
     m_viewClient->iconChanged(toQt(m_latestFavicon.url));
 }
 
