diff --git a/src/3rdparty/chromium/qtwebengine/browser/extensions/api/notifications/notifications_api.cc b/src/3rdparty/chromium/qtwebengine/browser/extensions/api/notifications/notifications_api.cc
new file mode 100644
index 0000000000..cc93e2a50c
--- /dev/null
+++ b/src/3rdparty/chromium/qtwebengine/browser/extensions/api/notifications/notifications_api.cc
@@ -0,0 +1,80 @@
+// Copyright (C) 2026 The Qt Company Ltd.
+// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only
+
+#include "qtwebengine/browser/extensions/api/notifications/notifications_api.h"
+
+#include "base/strings/string_number_conversions.h"
+#include "extensions/common/extension.h"
+#include "qtwebengine/browser/extensions/notification_registry_qt.h"
+#include "qtwebengine/common/extensions/api/notifications.h"
+
+namespace extensions {
+
+namespace {
+
+namespace notifications = api::notifications;
+
+// What the application is given to show. Chrome draws these itself and so honours buttons, images
+// and progress; QtWebEngine hands the notification over, and what an application can show is a
+// title, a message and where it came from. The rest of the options are read and not passed on.
+NotificationRequestQt RequestFrom(const notifications::NotificationOptions& options,
+                                  const Extension* extension) {
+  NotificationRequestQt request;
+  if (options.title) {
+    request.title = *options.title;
+  }
+  if (options.message) {
+    request.message = *options.message;
+  }
+  request.origin = extension->url();
+  return request;
+}
+
+}  // namespace
+
+ExtensionFunction::ResponseAction NotificationsCreateFunction::Run() {
+  std::optional<notifications::Create::Params> params =
+      notifications::Create::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  // An extension may leave the id to the browser, and is told which one it got.
+  std::string id = params->notification_id.value_or(std::string());
+  if (id.empty()) {
+    static int next = 0;
+    id = "qtwebengine-" + base::NumberToString(++next);
+  }
+  NotificationRegistryQt::Get()->Show(browser_context(), extension()->id(), id,
+                                      RequestFrom(params->options, extension()));
+  return RespondNow(ArgumentList(notifications::Create::Results::Create(id)));
+}
+
+ExtensionFunction::ResponseAction NotificationsUpdateFunction::Run() {
+  std::optional<notifications::Update::Params> params =
+      notifications::Update::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  const bool updated = NotificationRegistryQt::Get()->Update(
+      browser_context(), extension()->id(), params->notification_id,
+      RequestFrom(params->options, extension()));
+  return RespondNow(ArgumentList(notifications::Update::Results::Create(updated)));
+}
+
+ExtensionFunction::ResponseAction NotificationsClearFunction::Run() {
+  std::optional<notifications::Clear::Params> params =
+      notifications::Clear::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  const bool cleared = NotificationRegistryQt::Get()->Clear(browser_context(), extension()->id(),
+                                                            params->notification_id);
+  return RespondNow(ArgumentList(notifications::Clear::Results::Create(cleared)));
+}
+
+ExtensionFunction::ResponseAction NotificationsGetAllFunction::Run() {
+  base::Value::Dict ids;
+  for (const std::string& id : NotificationRegistryQt::Get()->GetAll(browser_context(), extension()->id())) {
+    ids.Set(id, true);
+  }
+  return RespondNow(WithArguments(std::move(ids)));
+}
+
+}  // namespace extensions
