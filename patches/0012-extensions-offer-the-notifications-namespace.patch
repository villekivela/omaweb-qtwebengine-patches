+// Copyright (C) 2026 The Qt Company Ltd.
+// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only
+
+#ifndef QTWEBENGINE_BROWSER_EXTENSIONS_API_NOTIFICATIONS_NOTIFICATIONS_API_H_
+#define QTWEBENGINE_BROWSER_EXTENSIONS_API_NOTIFICATIONS_NOTIFICATIONS_API_H_
+
+#include "extensions/browser/extension_function.h"
+
+namespace extensions {
+
+// A notification an extension asks for is handed to the application the way a page's is. A
+// password manager uses these to say what it just saved, and registers its listeners at the top
+// level of its worker, so the namespace has to be there before it has anything to show.
+class NotificationsCreateFunction : public ExtensionFunction {
+  ~NotificationsCreateFunction() override {}
+  ResponseAction Run() override;
+  DECLARE_EXTENSION_FUNCTION("notifications.create", NOTIFICATIONS_CREATE)
+};
+
+class NotificationsUpdateFunction : public ExtensionFunction {
+  ~NotificationsUpdateFunction() override {}
+  ResponseAction Run() override;
+  DECLARE_EXTENSION_FUNCTION("notifications.update", NOTIFICATIONS_UPDATE)
+};
+
+class NotificationsClearFunction : public ExtensionFunction {
+  ~NotificationsClearFunction() override {}
+  ResponseAction Run() override;
+  DECLARE_EXTENSION_FUNCTION("notifications.clear", NOTIFICATIONS_CLEAR)
+};
+
+class NotificationsGetAllFunction : public ExtensionFunction {
+  ~NotificationsGetAllFunction() override {}
+  ResponseAction Run() override;
+  DECLARE_EXTENSION_FUNCTION("notifications.getAll", NOTIFICATIONS_GET_ALL)
+};
+
+}  // namespace extensions
+
+#endif  // QTWEBENGINE_BROWSER_EXTENSIONS_API_NOTIFICATIONS_NOTIFICATIONS_API_H_
diff --git a/src/3rdparty/chromium/qtwebengine/browser/extensions/notification_registry_qt.cc b/src/3rdparty/chromium/qtwebengine/browser/extensions/notification_registry_qt.cc
new file mode 100644
index 0000000000..861fc24e08
--- /dev/null
+++ b/src/3rdparty/chromium/qtwebengine/browser/extensions/notification_registry_qt.cc
@@ -0,0 +1,160 @@
+// Copyright (C) 2026 The Qt Company Ltd.
+// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only
+
+#include "qtwebengine/browser/extensions/notification_registry_qt.h"
+
+#include <iterator>
+
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/values.h"
+#include "extensions/browser/event_router.h"
+#include "extensions/browser/extension_registry.h"
+#include "qtwebengine/common/extensions/api/notifications.h"
+
+namespace extensions {
+
+// static
+NotificationRegistryQt* NotificationRegistryQt::Get() {
+  static base::NoDestructor<NotificationRegistryQt> registry;
+  return registry.get();
+}
+
+void NotificationRegistryQt::SetDelegate(NotificationsDelegateQt* delegate) {
+  delegate_ = delegate;
+  if (!delegate) {
+    showing_.clear();
+  }
+}
+
+std::map<std::string, NotificationRegistryQt::Showing>::iterator NotificationRegistryQt::Find(
+    content::BrowserContext* context, const ExtensionId& extension_id, const std::string& id) {
+  for (auto it = showing_.begin(); it != showing_.end(); ++it) {
+    if (it->second.context == context && it->second.extension_id == extension_id &&
+        it->second.id == id) {
+      return it;
+    }
+  }
+  return showing_.end();
+}
+
+void NotificationRegistryQt::Forget() {
+  for (auto it = showing_.begin(); it != showing_.end();) {
+    ExtensionRegistry* registry = ExtensionRegistry::Get(it->second.context);
+    if (registry && registry->enabled_extensions().Contains(it->second.extension_id)) {
+      ++it;
+      continue;
+    }
+    if (delegate_) {
+      delegate_->Close(it->second.context, it->first);
+    }
+    it = showing_.erase(it);
+  }
+}
+
+void NotificationRegistryQt::ForgetContext(content::BrowserContext* context) {
+  // Dropped rather than closed. This runs while the context is being destroyed, and the
+  // application it would be asked to take them back from is going down with it.
+  for (auto it = showing_.begin(); it != showing_.end();) {
+    it = it->second.context == context ? showing_.erase(it) : std::next(it);
+  }
+}
+
+bool NotificationRegistryQt::Show(content::BrowserContext* context,
+                                  const ExtensionId& extension_id, const std::string& id,
+                                  const NotificationRequestQt& request) {
+  Forget();
+  if (!delegate_) {
+    return false;
+  }
+  // Chrome clears a notification it is about to replace, rather than showing two.
+  auto existing = Find(context, extension_id, id);
+  if (existing != showing_.end()) {
+    delegate_->Close(context, existing->first);
+    showing_.erase(existing);
+  }
+  const std::string scoped_id = "n" + base::NumberToString(++next_);
+  showing_[scoped_id] = Showing{extension_id, id, context};
+  delegate_->Show(context, scoped_id, request);
+  return true;
+}
+
+bool NotificationRegistryQt::Update(content::BrowserContext* context,
+                                    const ExtensionId& extension_id, const std::string& id,
+                                    const NotificationRequestQt& request) {
+  Forget();
+  if (Find(context, extension_id, id) == showing_.end()) {
+    return false;
+  }
+  return Show(context, extension_id, id, request);
+}
+
+bool NotificationRegistryQt::Clear(content::BrowserContext* context,
+                                   const ExtensionId& extension_id, const std::string& id) {
+  Forget();
+  auto showing = Find(context, extension_id, id);
+  if (showing == showing_.end()) {
+    return false;
+  }
+  if (delegate_) {
+    delegate_->Close(context, showing->first);
+  }
+  showing_.erase(showing);
+  return true;
+}
+
+std::vector<std::string> NotificationRegistryQt::GetAll(content::BrowserContext* context,
+                                                        const ExtensionId& extension_id) {
+  Forget();
+  std::vector<std::string> ids;
+  for (const auto& [scoped_id, showing] : showing_) {
+    if (showing.context == context && showing.extension_id == extension_id) {
+      ids.push_back(showing.id);
+    }
+  }
+  return ids;
+}
+
+void NotificationRegistryQt::Clicked(const std::string& scoped_id) {
+  auto showing = showing_.find(scoped_id);
+  if (showing == showing_.end()) {
+    return;
+  }
+  EventRouter* router = EventRouter::Get(showing->second.context);
+  if (!router) {
+    return;
+  }
+  base::Value::List args;
+  args.Append(showing->second.id);
+  router->DispatchEventToExtension(
+      showing->second.extension_id,
+      std::make_unique<Event>(events::NOTIFICATIONS_ON_CLICKED,
+                              api::notifications::OnClicked::kEventName, std::move(args)));
+}
+
+void NotificationRegistryQt::Closed(const std::string& scoped_id, bool by_user) {
+  auto showing = showing_.find(scoped_id);
+  if (showing == showing_.end()) {
+    return;
+  }
+  const ExtensionId extension_id = showing->second.extension_id;
+  const std::string id = showing->second.id;
+  content::BrowserContext* context = showing->second.context;
+  // Gone before the extension hears about it, so a listener that asks what is showing is answered
+  // with what is showing.
+  showing_.erase(showing);
+
+  EventRouter* router = EventRouter::Get(context);
+  if (!router) {
+    return;
+  }
+  base::Value::List args;
+  args.Append(id);
+  args.Append(by_user);
+  router->DispatchEventToExtension(
+      extension_id, std::make_unique<Event>(events::NOTIFICATIONS_ON_CLOSED,
+                                            api::notifications::OnClosed::kEventName,
+                                            std::move(args)));
+}
+
+}  // namespace extensions
diff --git a/src/3rdparty/chromium/qtwebengine/browser/extensions/notification_registry_qt.h b/src/3rdparty/chromium/qtwebengine/browser/extensions/notification_registry_qt.h
new file mode 100644
index 0000000000..b3bc968059
--- /dev/null
+++ b/src/3rdparty/chromium/qtwebengine/browser/extensions/notification_registry_qt.h
@@ -0,0 +1,97 @@
+// Copyright (C) 2026 The Qt Company Ltd.
+// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only
+
+#ifndef QTWEBENGINE_BROWSER_EXTENSIONS_NOTIFICATION_REGISTRY_QT_H_
+#define QTWEBENGINE_BROWSER_EXTENSIONS_NOTIFICATION_REGISTRY_QT_H_
+
+#include <map>
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "extensions/common/extension_id.h"
+#include "url/gurl.h"
+
+namespace content {
+class BrowserContext;
+}
+
+namespace extensions {
+
+// What a notification says, as an extension asked for it.
+struct NotificationRequestQt {
+  std::string title;
+  std::string message;
+  GURL origin;
+};
+
+// QtWebEngine hands a notification to the application rather than drawing one, and a page's
+// notification already goes that way. An extension's goes the same way, through this delegate, so
+// an application that shows one shows both and the reader is not asked to tell them apart.
+class NotificationsDelegateQt {
+ public:
+  virtual ~NotificationsDelegateQt() = default;
+
+  // Show |request| under |scoped_id|. The registry is told when the reader answers it.
+  virtual void Show(content::BrowserContext* context, const std::string& scoped_id,
+                    const NotificationRequestQt& request) = 0;
+  // Take it back, because the extension cleared it or replaced it.
+  virtual void Close(content::BrowserContext* context, const std::string& scoped_id) = 0;
+};
+
+// The notifications each extension has showing. Chrome keeps ids per extension, so two extensions
+// may both call one "login-saved" without colliding; the scoped id is what the application sees.
+class NotificationRegistryQt {
+ public:
+  static NotificationRegistryQt* Get();
+
+  void SetDelegate(NotificationsDelegateQt* delegate);
+
+  // Show, replacing any notification this extension already has under |id|.
+  bool Show(content::BrowserContext* context, const ExtensionId& extension_id,
+            const std::string& id, const NotificationRequestQt& request);
+  // Update an existing one, answering whether there was one to update.
+  bool Update(content::BrowserContext* context, const ExtensionId& extension_id,
+              const std::string& id, const NotificationRequestQt& request);
+  // Clear one, answering whether there was one to clear.
+  bool Clear(content::BrowserContext* context, const ExtensionId& extension_id,
+             const std::string& id);
+  std::vector<std::string> GetAll(content::BrowserContext* context,
+                                  const ExtensionId& extension_id);
+
+  // Everything |context| was showing, because its extension system is going away and the
+  // pointers this holds are about to be stale.
+  void ForgetContext(content::BrowserContext* context);
+
+  // The reader answered a notification, or it went away. Called by the delegate, and passed on to
+  // the extension as notifications.onClicked and notifications.onClosed.
+  void Clicked(const std::string& scoped_id);
+  void Closed(const std::string& scoped_id, bool by_user);
+
+ private:
+  struct Showing {
+    ExtensionId extension_id;
+    std::string id;
+    raw_ptr<content::BrowserContext> context;
+  };
+
+  // Drop what an extension that is no longer enabled was showing. An extension that is turned
+  // off, reloaded or uninstalled has nothing on screen the reader can still answer, and its ids
+  // are not the next extension's to inherit.
+  void Forget();
+  // What this extension is showing under |id| in |context|, or the end.
+  std::map<std::string, Showing>::iterator Find(content::BrowserContext* context,
+                                                const ExtensionId& extension_id,
+                                                const std::string& id);
+
+  // The id the application sees is this registry's own, so two extensions, or two profiles
+  // running the same extension, never collide on a name either of them chose.
+  int next_ = 0;
+  // That id to what is showing under it.
+  std::map<std::string, Showing> showing_;
+  raw_ptr<NotificationsDelegateQt> delegate_ = nullptr;
+};
+
+}  // namespace extensions
+
+#endif  // QTWEBENGINE_BROWSER_EXTENSIONS_NOTIFICATION_REGISTRY_QT_H_
diff --git a/src/3rdparty/chromium/qtwebengine/common/extensions/api/notifications.idl b/src/3rdparty/chromium/qtwebengine/common/extensions/api/notifications.idl
new file mode 100644
