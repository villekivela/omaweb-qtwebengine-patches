+namespace {
+
+// The reader's answer to a notification, on its way back to the extension. Chromium's own
+// notifications carry a delegate of this shape, and an extension's is told the same things.
+class ExtensionNotificationDelegate : public QtWebEngineCore::UserNotificationController::Delegate
+{
+public:
+    explicit ExtensionNotificationDelegate(std::string scopedId) : m_scopedId(std::move(scopedId)) { }
+
+    void shown() override { }
+    void clicked() override { NotificationRegistryQt::Get()->Clicked(m_scopedId); }
+    void closed(bool byUser) override { NotificationRegistryQt::Get()->Closed(m_scopedId, byUser); }
+
+private:
+    std::string m_scopedId;
+};
+
+} // namespace
