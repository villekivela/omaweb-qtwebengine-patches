+void tst_QWebEngineExtension::anExtensionNotificationReachesTheProfilesPresenter()
+{
+    // An extension's notification is a notification. It goes where a page's does, so an
+    // application that already shows one shows this one, and the reader is not asked to tell them
+    // apart. A password manager uses them to say what it just saved.
+    QWebEngineExtensionInfo extension =
+            loadExtensionSync(resourcesPath() + "notifications_ext"_L1);
+    QVERIFY2(extension.isLoaded(), qPrintable(extension.error()));
+    m_manager->setExtensionEnabled(extension, true);
+
+    std::unique_ptr<QWebEngineNotification> shown;
+    m_profile->setNotificationPresenter([&](std::unique_ptr<QWebEngineNotification> notification) {
+        shown = std::move(notification);
+    });
+
+    // Asked for from the extension's own page, which is how an extension asks.
+    QWebEnginePage popup(m_profile);
+    QSignalSpy popupSpy(&popup, SIGNAL(loadFinished(bool)));
+    popup.load(extension.actionPopupUrl());
+    QTRY_COMPARE(popupSpy.size(), 1);
+    evaluateJavaScriptSync(&popup, "chrome.runtime.sendMessage('notify')");
+
+    QTRY_VERIFY(shown);
+    QCOMPARE(shown->title(), "A title"_L1);
+    QCOMPARE(shown->message(), "A message"_L1);
+    QCOMPARE(shown->origin().host(), extension.id());
+}
+
+void tst_QWebEngineExtension::anExtensionKeepsTrackOfTheNotificationsItIsShowing()
+{
+    // getAll, clear and update answer about this extension's own notifications: an extension that
+    // asks what it is showing is told, and one that clears something it never showed is told no.
+    QWebEngineExtensionInfo extension =
+            loadExtensionSync(resourcesPath() + "notifications_ext"_L1);
+    QVERIFY2(extension.isLoaded(), qPrintable(extension.error()));
+    m_manager->setExtensionEnabled(extension, true);
+
+    std::vector<std::unique_ptr<QWebEngineNotification>> shown;
+    m_profile->setNotificationPresenter([&](std::unique_ptr<QWebEngineNotification> notification) {
+        shown.push_back(std::move(notification));
+    });
+
+    QWebEnginePage popup(m_profile);
+    QSignalSpy popupSpy(&popup, SIGNAL(loadFinished(bool)));
+    popup.load(extension.actionPopupUrl());
+    QTRY_COMPARE(popupSpy.size(), 1);
+
+    // evaluateJavaScriptSync does not await, so the sequence runs in the page and records what it
+    // saw; the assertions read the record afterwards.
+    evaluateJavaScriptSync(&popup, R"((async () => {
+        const seen = {};
+        seen.before = await chrome.notifications.getAll();
+        seen.created = await chrome.notifications.create(
+            'mine', {type: 'basic', iconUrl: 'icon.png', title: 'T', message: 'M'});
+        seen.showing = await chrome.notifications.getAll();
+        seen.updatedOther = await chrome.notifications.update('other', {title: 'T2'});
+        seen.clearedOther = await chrome.notifications.clear('other');
+        seen.updatedMine = await chrome.notifications.update('mine', {title: 'T2'});
+        seen.clearedMine = await chrome.notifications.clear('mine');
+        seen.after = await chrome.notifications.getAll();
+        window.seen = seen;
+    })())");
+    QTRY_VERIFY(evaluateJavaScriptSync(&popup, "window.seen !== undefined").toBool());
+
+    const auto seen = [this, &popup](const QString &name) {
+        return evaluateJavaScriptSync(&popup, "window.seen." + name);
+    };
+    QCOMPARE(seen("before"_L1).toMap(), QVariantMap());
+    QCOMPARE(seen("created"_L1), "mine"_L1);
+    QCOMPARE(seen("showing"_L1).toMap(), QVariantMap({ { "mine"_L1, true } }));
+
+    // An id it never showed is not its to update or clear.
+    QCOMPARE(seen("updatedOther"_L1).toBool(), false);
+    QCOMPARE(seen("clearedOther"_L1).toBool(), false);
+
+    QCOMPARE(seen("updatedMine"_L1).toBool(), true);
+    QCOMPARE(seen("clearedMine"_L1).toBool(), true);
+    QCOMPARE(seen("after"_L1).toMap(), QVariantMap());
+
+    // Two reached the application for one notification: what it was shown as, and what the update
+    // replaced it with. A QWebEngineNotification cannot be changed after it is handed over, so an
+    // update is the old one taken back and a new one given.
+    QCOMPARE(shown.size(), 2u);
+}
+
+void tst_QWebEngineExtension::theReadersAnswerToANotificationReachesTheExtension()
+{
+    // A notification nobody can answer is a notice. A password manager registers onClicked at the
+    // top level of its worker and acts on it, so the click the application reports has to arrive
+    // as that event, and the notification going away has to arrive as onClosed.
+    QWebEngineExtensionInfo extension =
+            loadExtensionSync(resourcesPath() + "notifications_ext"_L1);
+    QVERIFY2(extension.isLoaded(), qPrintable(extension.error()));
+    m_manager->setExtensionEnabled(extension, true);
+
+    std::unique_ptr<QWebEngineNotification> shown;
+    m_profile->setNotificationPresenter([&](std::unique_ptr<QWebEngineNotification> notification) {
+        shown = std::move(notification);
+    });
+
+    QWebEnginePage popup(m_profile);
+    QSignalSpy popupSpy(&popup, SIGNAL(loadFinished(bool)));
+    popup.load(extension.actionPopupUrl());
+    QTRY_COMPARE(popupSpy.size(), 1);
+
+    // The worker asked, so the worker is what hears the answer.
+    evaluateJavaScriptSync(&popup, "chrome.runtime.sendMessage('notify')");
+    QTRY_VERIFY(shown);
+
+    shown->click();
+    const auto events = [this, &popup] {
+        evaluateJavaScriptSync(&popup,
+                               "chrome.runtime.sendMessage('events', r => { window.events = r })");
+        return evaluateJavaScriptSync(&popup, "JSON.stringify(window.events)").toString();
+    };
+    QTRY_COMPARE(events(), R"([["clicked","first"]])"_L1);
+
+    // byUser is true because that is what the engine says: QWebEngineNotification::close() is the
+    // platform reporting a close "either by the underlying platform or by the user", and the
+    // controller cannot tell those apart. Passing that through is better than inventing a
+    // distinction the application never made.
+    shown->close();
+    QTRY_COMPARE(events(), R"([["clicked","first"],["closed","first",true]])"_L1);
+}
