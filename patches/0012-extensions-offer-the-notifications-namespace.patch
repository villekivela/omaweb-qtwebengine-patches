+void ExtensionsBrowserClientQt::Show(content::BrowserContext *context, const std::string &scopedId,
+                                     const NotificationRequestQt &request)
+{
+    QtWebEngineCore::ProfileQt *profile = static_cast<QtWebEngineCore::ProfileQt *>(context);
+    if (!profile)
+        return;
+
+    blink::PlatformNotificationData data;
+    data.title = base::UTF8ToUTF16(request.title);
+    data.body = base::UTF8ToUTF16(request.message);
+
+    QSharedPointer<QtWebEngineCore::UserNotificationController> controller(
+            new QtWebEngineCore::UserNotificationController(
+            data, blink::NotificationResources(), request.origin,
+            new ExtensionNotificationDelegate(scopedId)));
+    profile->profileAdapter()->ephemeralNotifications().insert(
+            QByteArray::fromStdString(scopedId), controller);
+
+    const QList<QtWebEngineCore::ProfileAdapterClient *> clients =
+            profile->profileAdapter()->clients();
+    for (QtWebEngineCore::ProfileAdapterClient *client : clients)
+        client->showNotification(controller);
+}
+
+void ExtensionsBrowserClientQt::Close(content::BrowserContext *context, const std::string &scopedId)
+{
+    QtWebEngineCore::ProfileQt *profile = static_cast<QtWebEngineCore::ProfileQt *>(context);
+    if (!profile)
+        return;
+    auto &notifications = profile->profileAdapter()->ephemeralNotifications();
+    const QByteArray key = QByteArray::fromStdString(scopedId);
+    if (QSharedPointer<QtWebEngineCore::UserNotificationController> controller =
+                notifications.take(key))
+        controller->closeNotification();
 }
 
