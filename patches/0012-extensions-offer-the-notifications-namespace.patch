+// A password manager registers these at its top level, before it has anything
+// to notify about, and the worker never starts if they are not there.
+const seen = []
+chrome.notifications.onClicked.addListener(id => seen.push(["clicked", id]))
+chrome.notifications.onButtonClicked.addListener((id, index) => seen.push(["button", id, index]))
+chrome.notifications.onClosed.addListener((id, byUser) => seen.push(["closed", id, byUser]))
+
+chrome.runtime.onMessage.addListener((message, _, sendResponse) => {
+    if (message === "events") {
+        sendResponse(seen)
+        return true
+    }
+    if (message === "notify") {
+        chrome.notifications.create("first", {
+            type: "basic",
+            iconUrl: "icon.png",
+            title: "A title",
+            message: "A message"
+        }, id => sendResponse(id))
+        return true
+    }
+    return false
+})
