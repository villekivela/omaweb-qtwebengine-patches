+void tst_QWebEngineExtension::aPageCanLoadAWebAccessibleResource()
+{
+    // A resource an extension declares web accessible is one an ordinary page may ask for, by
+    // fetch or as a script. Extensions rely on it to get their real work into a document: a
+    // content script small enough to be declared statically imports the bundle that does the job.
+    // An extension whose scripts are all declared in the manifest never notices; one that imports
+    // reaches nothing, and nothing it was meant to do in the page happens.
+    HttpServer server;
+    server.setResourceDirs({ resourcesPath() });
+    QVERIFY(server.start());
+
+    QWebEngineExtensionInfo extension =
+            loadExtensionSync(resourcesPath() + "web_accessible_ext"_L1);
+    QVERIFY2(extension.isLoaded(), qPrintable(extension.error()));
+    m_manager->setExtensionEnabled(extension, true);
+
+    QSignalSpy loadSpy(m_page, SIGNAL(loadFinished(bool)));
+    m_page->load(server.url("/index.html"_L1));
+    QTRY_COMPARE(loadSpy.size(), 1);
+
+    const QString resource = "chrome-extension://"_L1 + extension.id() + "/shared.txt"_L1;
+    evaluateJavaScriptSync(m_page, "fetch(\"" + resource + "\")"
+                                   ".then(async r => window.fetched = r.ok ? await r.text() : "
+                                   "\"status \" + r.status)"
+                                   ".catch(e => window.fetched = \"threw: \" + e.message)");
+    QTRY_VERIFY(evaluateJavaScriptSync(m_page, "window.fetched !== undefined").toBool());
+    QCOMPARE(evaluateJavaScriptSync(m_page, "window.fetched.trim()"), "shared"_L1);
+
+    // And as a script element, which is the shape an injected bundle arrives in.
+    const QString script = "chrome-extension://"_L1 + extension.id() + "/shared.js"_L1;
+    evaluateJavaScriptSync(m_page,
+                           "const el = document.createElement('script');"
+                           "el.onload = () => window.scriptRan = globalThis.sharedLoaded === true;"
+                           "el.onerror = () => window.scriptRan = false;"
+                           "el.src = \"" + script + "\"; document.head.appendChild(el)");
+    QTRY_VERIFY(evaluateJavaScriptSync(m_page, "window.scriptRan !== undefined").toBool());
+    QCOMPARE(evaluateJavaScriptSync(m_page, "window.scriptRan").toBool(), true);
+}
+
+void tst_QWebEngineExtension::aResourceWithADynamicUrlIsReachableOnlyUnderIt()
+{
+    // An extension may declare a resource reachable only under an id given to it at runtime,
+    // rather than its own, so a page cannot tell from a fixed URL which extensions are installed.
+    // Bitwarden declares its resources this way, so a refusal of the static URL is correct and the
+    // dynamic one has to work. Both halves are asserted, because passing one while failing the
+    // other is the shape of both the bug and the overcorrection.
+    HttpServer server;
+    server.setResourceDirs({ resourcesPath() });
+    QVERIFY(server.start());
+
+    QWebEngineExtensionInfo extension =
+            loadExtensionSync(resourcesPath() + "web_accessible_ext"_L1);
+    QVERIFY2(extension.isLoaded(), qPrintable(extension.error()));
+    m_manager->setExtensionEnabled(extension, true);
+
+    QSignalSpy loadSpy(m_page, SIGNAL(loadFinished(bool)));
+    m_page->load(server.url("/index.html"_L1));
+    QTRY_COMPARE(loadSpy.size(), 1);
+
+    // The content script reports both URLs, because the page cannot ask for either itself.
+    QTRY_VERIFY(evaluateJavaScriptSync(
+                        m_page, "document.documentElement.dataset.dynamicUrl !== undefined")
+                        .toBool());
+    const QString dynamic =
+            evaluateJavaScriptSync(m_page, "document.documentElement.dataset.dynamicUrl").toString();
+    const QString fixed =
+            evaluateJavaScriptSync(m_page, "document.documentElement.dataset.staticUrl").toString();
+    QVERIFY(!dynamic.isEmpty());
+    QVERIFY2(dynamic != fixed, qPrintable(dynamic));
+
+    const auto fetched = [this](const QString &url, const QString &into) {
+        evaluateJavaScriptSync(m_page, "fetch(\"" + url + "\").then(async r => window." + into
+                                               + " = r.ok ? (await r.text()).trim() : \"status \" "
+                                                 "+ r.status).catch(e => window."
+                                               + into + " = \"threw\")");
+        QTest::qWait(0);
+    };
+    fetched(dynamic, "underDynamic"_L1);
+    fetched(fixed, "underFixed"_L1);
+    QTRY_VERIFY(evaluateJavaScriptSync(m_page, "window.underDynamic !== undefined").toBool());
+    QTRY_VERIFY(evaluateJavaScriptSync(m_page, "window.underFixed !== undefined").toBool());
+
+    QCOMPARE(evaluateJavaScriptSync(m_page, "window.underDynamic"), "dynamic"_L1);
+    QCOMPARE(evaluateJavaScriptSync(m_page, "window.underFixed"), "threw"_L1);
+}
