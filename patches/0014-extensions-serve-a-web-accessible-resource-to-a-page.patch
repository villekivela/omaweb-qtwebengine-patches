+// The page cannot ask for its own dynamic URL, so the content script hands it over. A resource
+// declared with use_dynamic_url is reachable only under the id the extension is given at runtime,
+// which is the whole point of the flag.
+document.documentElement.dataset.dynamicUrl = chrome.runtime.getURL("dynamic.txt")
+document.documentElement.dataset.staticUrl =
+    "chrome-extension://" + chrome.runtime.id + "/dynamic.txt"
