diff --git a/src/3rdparty/chromium/qtwebengine/browser/extensions/tab_registry_qt.cc b/src/3rdparty/chromium/qtwebengine/browser/extensions/tab_registry_qt.cc
index 923c4e6504..9c4ba1d98c 100644
--- a/src/3rdparty/chromium/qtwebengine/browser/extensions/tab_registry_qt.cc
+++ b/src/3rdparty/chromium/qtwebengine/browser/extensions/tab_registry_qt.cc
@@ -60,6 +60,19 @@ class ScriptExecutorData : public content::WebContentsUserData<ScriptExecutorDat
 
 WEB_CONTENTS_USER_DATA_KEY_IMPL(ScriptExecutorData);
 
+// The application said it shows the page as one of the reader's tabs. The mark lives on the
+// WebContents, so it holds from before windows.create registers the page and dies with it.
+class ShownAsTabData : public content::WebContentsUserData<ShownAsTabData> {
+ private:
+  friend class content::WebContentsUserData<ShownAsTabData>;
+  explicit ShownAsTabData(content::WebContents* web_contents)
+      : content::WebContentsUserData<ShownAsTabData>(*web_contents) {}
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(ShownAsTabData);
+
 // A listener that filters windows.onRemoved by type hears about a window of a type it asked for,
 // and one that does not filter hears about every window, as Chrome's WindowsEventRouter tells
 // them. The router sends a copy of the event for each listener's filter, and the renderer matches
@@ -161,11 +174,27 @@ content::WebContents* TabRegistryQt::GetWebContents(content::BrowserContext* con
 
 void TabRegistryQt::OpenWindow(content::WebContents* web_contents,
                                api::windows::WindowType type) {
+  // The application took the page as a tab while it was being opened.
+  if (IsShownAsTab(web_contents))
+    return;
   const int window_id = ++last_window_id_;
   windows_[window_id] =
       std::make_unique<OpenedWindow>(web_contents, window_id, GetTabId(web_contents), type);
 }
 
+void TabRegistryQt::ShowAsTab(content::WebContents* web_contents) {
+  ShownAsTabData::CreateForWebContents(web_contents);
+  // The window goes without a word: the page is still open, and an extension that hears its
+  // window was removed ends what it was showing there.
+  std::erase_if(windows_, [web_contents](const auto& entry) {
+    return entry.second->web_contents() == web_contents;
+  });
+}
+
+bool TabRegistryQt::IsShownAsTab(content::WebContents* web_contents) const {
+  return ShownAsTabData::FromWebContents(web_contents) != nullptr;
+}
+
 bool TabRegistryQt::IsWindowOfItsOwn(content::WebContents* web_contents) const {
   return FindWindow(web_contents) != nullptr;
 }
diff --git a/src/3rdparty/chromium/qtwebengine/browser/extensions/tab_registry_qt.h b/src/3rdparty/chromium/qtwebengine/browser/extensions/tab_registry_qt.h
index 7bf421f6bd..62aa36d96c 100644
--- a/src/3rdparty/chromium/qtwebengine/browser/extensions/tab_registry_qt.h
+++ b/src/3rdparty/chromium/qtwebengine/browser/extensions/tab_registry_qt.h
@@ -70,6 +70,12 @@ class TabRegistryQt {
   // every extension listening hears tabs.onRemoved for its tab and then windows.onRemoved for the
   // window, as Chrome raises them, and the id answers nothing after that.
   void OpenWindow(content::WebContents* web_contents, api::windows::WindowType type);
+  // The application shows |web_contents| as one of the browser window's tabs, for as long as it
+  // lives. A window of its own that it was is gone, and no extension hears about it, then or
+  // when the page closes. Before windows.create registers the page, it is never a window at all.
+  void ShowAsTab(content::WebContents* web_contents);
+  // Whether the application said it shows |web_contents| as a tab.
+  bool IsShownAsTab(content::WebContents* web_contents) const;
   // Whether |web_contents| is a window of its own rather than a tab of the browser's window.
   bool IsWindowOfItsOwn(content::WebContents* web_contents) const;
   // The page holding the window |window_id| of |context|, or null.
diff --git a/src/core/api/qwebengineextensionmanager.cpp b/src/core/api/qwebengineextensionmanager.cpp
index 70b18f3e53..4fd8016929 100644
--- a/src/core/api/qwebengineextensionmanager.cpp
+++ b/src/core/api/qwebengineextensionmanager.cpp
@@ -208,5 +208,29 @@ void QWebEngineExtensionManager::setWindowGeometryProvider(
     d_ptr->setWindowGeometryProvider(std::move(provider));
 }
 
+/*!
+    Tells the extensions that \a page is one of the browser window's tabs.
+
+    \a page is a QWebEnginePage, or a WebEngineView in Qt Quick, of this
+    manager's profile. A page an extension opened with \c chrome.windows.create
+    is a window of its own until the application says it shows the page as a tab.
+    From then on the page is in the browser's window: \c chrome.tabs.query lists it
+    there, \c chrome.windows.get no longer answers for the window it was in, and
+    \c chrome.tabs.remove refuses it, as it refuses every tab the application
+    keeps. No event is raised for the window it leaves, and none when it closes.
+
+    Said while the page is being handed to the application, before
+    \c chrome.windows.create answers, the page is a tab from the start and the
+    extension is answered with the browser's window.
+
+    A page is a tab for as long as it lives. Saying so of a page that was never a
+    window of its own changes nothing an extension sees, unless it shows one of
+    the extension's own pages, which is then listed as a tab too.
+*/
+void QWebEngineExtensionManager::setPageIsTab(QObject *page)
+{
+    d_ptr->setPageIsTab(page);
+}
+
 QT_END_NAMESPACE
 #endif // QT_CONFIG(webengine_extensions)
