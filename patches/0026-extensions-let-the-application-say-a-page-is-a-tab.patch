index 454bc4c7ca..2f7e9302b7 100644
--- a/src/core/extensions/extension_manager.cpp
+++ b/src/core/extensions/extension_manager.cpp
@@ -13,7 +13,11 @@
 #include "extension_loader.h"
 #include "extension_installer.h"
 #include "extension_system_qt.h"
