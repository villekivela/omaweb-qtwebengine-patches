+void tst_QWebEngineExtension::aWindowTheApplicationShowsAsATabJoinsTheBrowsersWindow_data()
+{
+    QTest::addColumn<QString>("path");
+    QTest::addColumn<bool>("extensionPage");
+    QTest::newRow("an extension page") << u"/control.html"_s << true;
+    QTest::newRow("a web page") << u"/index.html"_s << false;
+}
+
+void tst_QWebEngineExtension::aWindowTheApplicationShowsAsATabJoinsTheBrowsersWindow()
+{
+    // An application may show a page an extension opened as one of the reader's tabs, as Omaweb
+    // does when the reader keeps a Glance. The page then leaves the window it was opened in for
+    // the browser's, where the extension finds it and may not close it, and the extension hears
+    // nothing: Bitwarden ends a passkey request when its prompt's window is removed, and the
+    // prompt is still open.
+    QFETCH(QString, path);
+    QFETCH(bool, extensionPage);
+    const int browserWindowId = 1;
+    HttpServer server;
+    server.setResourceDirs({ resourcesPath() });
+    QVERIFY(server.start());
+
+    QWebEngineExtensionInfo opener = loadExtensionSync(resourcesPath() + "window_closing_ext"_L1);
+    QVERIFY(opener.isLoaded());
+    m_manager->setExtensionEnabled(opener, true);
+
+    QSignalSpy loadSpy(m_page, SIGNAL(loadFinished(bool)));
+    m_page->load(server.url("/index.html"_L1));
+    QTRY_COMPARE(loadSpy.size(), 1);
+    std::vector<std::unique_ptr<QWebEnginePage>> opened;
+    connect(m_page, &QWebEnginePage::newWindowRequested, this,
+            [&opened, this](QWebEngineNewWindowRequest &request) {
+                opened.push_back(std::make_unique<QWebEnginePage>(m_profile));
+                request.openIn(opened.back().get());
+            });
+
+    QWebEnginePage control(m_profile);
+    QSignalSpy controlSpy(&control, SIGNAL(loadFinished(bool)));
+    control.load(QUrl("chrome-extension://"_L1 + opener.id() + "/control.html"_L1));
+    QTRY_COMPARE(controlSpy.size(), 1);
+
+    const QString address = extensionPage
+            ? "chrome.runtime.getURL('control.html?popout')"_L1
+            : QStringLiteral("'%1'").arg(server.url(path).toString() + "?popout"_L1);
+    const QString pattern = extensionPage
+            ? "chrome.runtime.getURL('control.html') + '?popout*'"_L1
+            : "'*://*/index.html?popout*'"_L1;
+    const QVariantMap created = askExtension(
+            &control, "created"_L1,
+            QStringLiteral("chrome.windows.create({ url: %1, type: 'popup' })").arg(address));
+    QVERIFY2(created.contains("value"_L1), qPrintable(created.value("error"_L1).toString()));
+    const QVariantMap window = created["value"_L1].toMap();
+    const int windowId = window["id"_L1].toInt();
+    QVERIFY(windowId != browserWindowId);
+    const int tabId = window["tabs"_L1].toList().first().toMap()["id"_L1].toInt();
+    QTRY_COMPARE(opened.size(), size_t(1));
+    QTRY_COMPARE(opened.front()->url().query(), "popout"_L1);
+
+    m_manager->setPageIsTab(opened.front().get());
+
+    const auto tabs = [](const QVariantMap &answer) {
+        QList<QPair<int, int>> tabs;
+        for (const QVariant &tab : answer.value("value"_L1).toList())
+            tabs.append({ tab.toMap()["id"_L1].toInt(), tab.toMap()["windowId"_L1].toInt() });
+        return tabs;
+    };
+    const QList<QPair<int, int>> inTheBrowsersWindow = { { tabId, browserWindowId } };
+    QCOMPARE(tabs(askExtension(&control, "found"_L1,
+                               QStringLiteral("chrome.tabs.query({ url: %1 })").arg(pattern))),
+             inTheBrowsersWindow);
+    QVERIFY(tabs(askExtension(&control, "browserWindow"_L1,
+                              "chrome.tabs.query({ windowId: 1 })"_L1))
+                    .contains(inTheBrowsersWindow.first()));
+    QCOMPARE(askExtension(&control, "gone"_L1,
+                          QStringLiteral("chrome.windows.get(%1)").arg(windowId))
+                     .value("error"_L1)
+                     .toString(),
+             QStringLiteral("No window with id: %1.").arg(windowId));
+    QCOMPARE(askExtension(&control, "removed"_L1,
+                          QStringLiteral("chrome.tabs.remove(%1)").arg(tabId))
+                     .value("error"_L1)
+                     .toString(),
+             "The application keeps its own tabs open."_L1);
+    QCOMPARE(askExtension(&control, "windowRemoved"_L1,
+                          QStringLiteral("chrome.windows.remove(%1)").arg(windowId))
+                     .value("error"_L1)
+                     .toString(),
+             QStringLiteral("No window with id: %1.").arg(windowId));
+    QVERIFY(opened.front());
+
+    // The reader closes the tab, and then a window the extension opened after it. The extension
+    // hears about the window, and nothing before it.
+    opened.front().reset();
+    const QVariantMap next = askExtension(
+            &control, "next"_L1, "chrome.windows.create({ url: 'blank.html', type: 'popup' })"_L1);
+    QVERIFY2(next.contains("value"_L1), qPrintable(next.value("error"_L1).toString()));
+    const int nextWindowId = next["value"_L1].toMap()["id"_L1].toInt();
+    const int nextTabId =
+            next["value"_L1].toMap()["tabs"_L1].toList().first().toMap()["id"_L1].toInt();
+    QTRY_COMPARE(opened.size(), size_t(2));
+    opened.back().reset();
+    QTRY_COMPARE(heardByWorker(&control), removalOf(nextTabId, nextWindowId));
+}
+
+void tst_QWebEngineExtension::aPageTakenAsATabWhileItOpensIsNeverAWindow()
+{
+    // An application may decide what a page an extension opens is while it is handed the page, as
+    // Omaweb opens every page as a tab when the reader has turned Glance off. Such a page is a tab
+    // of the browser's window from the start: windows.create answers with that window, and the
+    // extension hears nothing when the page closes.
+    const int browserWindowId = 1;
+    HttpServer server;
+    server.setResourceDirs({ resourcesPath() });
+    QVERIFY(server.start());
+
+    QWebEngineExtensionInfo opener = loadExtensionSync(resourcesPath() + "window_closing_ext"_L1);
+    QVERIFY(opener.isLoaded());
+    m_manager->setExtensionEnabled(opener, true);
+
+    QSignalSpy loadSpy(m_page, SIGNAL(loadFinished(bool)));
+    m_page->load(server.url("/index.html"_L1));
+    QTRY_COMPARE(loadSpy.size(), 1);
+    std::vector<std::unique_ptr<QWebEnginePage>> opened;
+    bool asTabs = true;
+    connect(m_page, &QWebEnginePage::newWindowRequested, this,
+            [&opened, &asTabs, this](QWebEngineNewWindowRequest &request) {
+                opened.push_back(std::make_unique<QWebEnginePage>(m_profile));
+                request.openIn(opened.back().get());
+                if (asTabs)
+                    m_manager->setPageIsTab(opened.back().get());
+            });
+
+    QWebEnginePage control(m_profile);
+    QSignalSpy controlSpy(&control, SIGNAL(loadFinished(bool)));
+    control.load(QUrl("chrome-extension://"_L1 + opener.id() + "/control.html"_L1));
+    QTRY_COMPARE(controlSpy.size(), 1);
+
+    const QVariantMap created = askExtension(
+            &control, "created"_L1,
+            "chrome.windows.create({ url: 'control.html?popout', type: 'popup' })"_L1);
+    QVERIFY2(created.contains("value"_L1), qPrintable(created.value("error"_L1).toString()));
+    const QVariantMap window = created["value"_L1].toMap();
+    QCOMPARE(window["id"_L1].toInt(), browserWindowId);
+    QCOMPARE(window["type"_L1].toString(), "normal"_L1);
+    const QVariantMap tab = window["tabs"_L1].toList().first().toMap();
+    QCOMPARE(tab["windowId"_L1].toInt(), browserWindowId);
+    const int tabId = tab["id"_L1].toInt();
+    QCOMPARE(opened.size(), size_t(1));
+    QTRY_COMPARE(opened.front()->url().query(), "popout"_L1);
+
+    // The extension finds its page among the browser's tabs, and not the control page, which the
+    // application never said is a tab.
+    const QVariantMap listed = askExtension(&control, "listed"_L1,
+                                            "chrome.tabs.query({ windowId: 1 })"_L1);
+    QList<QUrl> addresses;
+    for (const QVariant &listedTab : listed.value("value"_L1).toList())
+        addresses.append(QUrl(listedTab.toMap()["url"_L1].toString()));
+    QVERIFY(addresses.contains(opened.front()->url()));
+    QVERIFY(!addresses.contains(control.url()));
+    QCOMPARE(askExtension(&control, "removed"_L1,
+                          QStringLiteral("chrome.tabs.remove(%1)").arg(tabId))
+                     .value("error"_L1)
+                     .toString(),
+             "The application keeps its own tabs open."_L1);
+
+    // The reader closes the tab, and then a window the extension opened after it. The extension
+    // hears about the window, and nothing before it.
+    opened.front().reset();
+    asTabs = false;
+    const QVariantMap next = askExtension(
+            &control, "next"_L1, "chrome.windows.create({ url: 'blank.html', type: 'popup' })"_L1);
+    QVERIFY2(next.contains("value"_L1), qPrintable(next.value("error"_L1).toString()));
+    const int nextWindowId = next["value"_L1].toMap()["id"_L1].toInt();
+    QVERIFY(nextWindowId != browserWindowId);
+    const int nextTabId =
+            next["value"_L1].toMap()["tabs"_L1].toList().first().toMap()["id"_L1].toInt();
+    QTRY_COMPARE(opened.size(), size_t(2));
+    opened.back().reset();
+    QTRY_COMPARE(heardByWorker(&control), removalOf(nextTabId, nextWindowId));
+}
+
 QTEST_MAIN(tst_QWebEngineExtension)
 #include "tst_qwebengineextension.moc"
