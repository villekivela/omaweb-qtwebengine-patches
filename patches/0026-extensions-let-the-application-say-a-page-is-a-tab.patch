 using namespace extensions;
 
@@ -155,6 +160,23 @@ QList<QWebEngineExtensionInfo> ExtensionManager::extensions()
     return extension_list;
 }
 
+// The page is known by the object the application holds it in, a QWebEnginePage or a
+// WebEngineView, as the window geometry provider is asked about it.
+void ExtensionManager::setPageIsTab(QObject *page)
+{
+    ProfileAdapter *adapter = static_cast<ProfileQt *>(m_context)->profileAdapter();
+    if (!page || !adapter)
+        return;
+    for (WebContentsAdapterClient *client : adapter->webContentsAdapterClients()) {
+        if (client->holdingQObject() != page)
+            continue;
+        WebContentsAdapter *contents = client->webContentsAdapter();
+        if (contents && contents->isInitialized() && contents->webContents())
+            TabRegistryQt::Get()->ShowAsTab(contents->webContents());
+        return;
+    }
+}
+
 void ExtensionManager::onExtensionLoaded(const Extension *extension)
 {
     Q_Q(QWebEngineExtensionManager);
