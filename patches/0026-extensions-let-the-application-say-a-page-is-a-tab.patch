     void onExtensionLoaded(const extensions::Extension *);
     void onExtensionInstalled(const extensions::Extension *);
     void onExtensionUninstalled(const std::string &id);
diff --git a/src/core/extensions/extensions_browser_client_qt.cpp b/src/core/extensions/extensions_browser_client_qt.cpp
index fdd963841d..8d1a15f287 100644
--- a/src/core/extensions/extensions_browser_client_qt.cpp
+++ b/src/core/extensions/extensions_browser_client_qt.cpp
@@ -364,10 +364,12 @@ void ExtensionsBrowserClientQt::Close(content::BrowserContext *context, const st
 // A page the extension itself put on show, such as the view an application loads
 // QWebEngineExtensionInfo::actionPopupUrl() into, is not a tab. Chrome does not list its own
 // extension views either, and an extension that finds its popup in tabs.query() answers the popup
-// instead of the page the reader is looking at.
+// instead of the page the reader is looking at. One the application says it shows as a tab, such
+// as a prompt an extension opened that the reader kept, is a tab like any other.
 static bool isExtensionPage(content::WebContents *contents)
 {
-    return contents->GetLastCommittedURL().SchemeIs(extensions::kExtensionScheme);
+    return contents->GetLastCommittedURL().SchemeIs(extensions::kExtensionScheme)
+            && !TabRegistryQt::Get()->IsShownAsTab(contents);
 }
 
 std::vector<content::WebContents *> ExtensionsBrowserClientQt::GetTabs(content::BrowserContext *context)
