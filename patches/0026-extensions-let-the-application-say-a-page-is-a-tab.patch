--- a/src/core/api/qwebengineextensionmanager.h
+++ b/src/core/api/qwebengineextensionmanager.h
@@ -41,6 +41,7 @@ public:
     QList<QWebEngineExtensionInfo> extensions() const;
 
     void setWindowGeometryProvider(std::function<QRect(const QObject *page)> provider);
