+
+// A profile's recent answers, so a page's second request to a host waits for
+// neither a proxy check nor a lookup. Kept per profile, because one profile's
+// answers say which hosts it has visited, and dropped with the profile. Only an
+// answer the proxy check let through is kept, so a hit makes no lookup that a
+// proxy set since could have ruled out. A minute is shorter than most CNAME
+// records live, and the bound keeps a page that names thousands of hosts from
+// growing the table without end.
+class DnsAliasCache
+{
+public:
+    static DnsAliasCache &instance()
+    {
+        static DnsAliasCache cache;
+        return cache;
+    }
+
+    std::optional<std::vector<std::string>> find(ProfileAdapter *profile, const std::string &host)
+    {
+        const auto entry = entries_.find({ profile, host });
+        if (entry == entries_.end())
+            return std::nullopt;
+        if (entry->second.expires <= base::TimeTicks::Now()) {
+            entries_.erase(entry);
+            return std::nullopt;
+        }
+        return entry->second.aliases;
+    }
+
+    void store(ProfileAdapter *profile, const std::string &host, std::vector<std::string> aliases)
+    {
+        if (watched_.insert(profile).second) {
+            QObject::connect(profile, &QObject::destroyed, [this, profile] { forget(profile); });
+        }
+        if (entries_.size() >= kLimit) {
+            const auto now = base::TimeTicks::Now();
+            std::erase_if(entries_, [now](const auto &entry) { return entry.second.expires <= now; });
+            if (entries_.size() >= kLimit)
+                entries_.clear();
+        }
+        entries_[{ profile, host }] = { std::move(aliases), base::TimeTicks::Now() + kLifetime };
+    }
+
+private:
+    void forget(ProfileAdapter *profile)
+    {
+        watched_.erase(profile);
+        std::erase_if(entries_, [profile](const auto &entry) { return entry.first.first == profile; });
+    }
+
+    struct Entry
+    {
+        std::vector<std::string> aliases;
+        base::TimeTicks expires;
+    };
+    static constexpr base::TimeDelta kLifetime = base::Minutes(1);
+    static constexpr size_t kLimit = 4096;
+    std::map<std::pair<ProfileAdapter *, std::string>, Entry> entries_;
+    std::set<ProfileAdapter *> watched_;
+};
+
+// Resolves one request's host for an interceptor that asked for its DNS
+// aliases. The proxy check comes first: behind a proxy a local lookup would
+// leak the query, and could disagree with the address the proxy connects to.
+// The lookup itself goes through the profile's own resolver and host cache, so
+// it honours the profile's secure DNS configuration and warms the cache for the
+// request that follows.
+class DnsAliasLookup : public network::mojom::ProxyLookupClient
+{
+public:
+    // The names, and whether a lookup was made at all: an answer the proxy
+    // check ruled out is not one to remember.
+    using Callback = base::OnceCallback<void(std::vector<std::string>, bool looked_up)>;
+
+    DnsAliasLookup(network::mojom::NetworkContext *context, const GURL &url,
+                   const net::NetworkAnonymizationKey &key, Callback callback)
+        : context_(context), url_(url), key_(key), callback_(std::move(callback))
+    {
+        context_->LookUpProxyForURL(url_, key_, receiver_.BindNewPipeAndPassRemote());
+        receiver_.set_disconnect_handler(base::BindOnce(&DnsAliasLookup::Finish,
+                                                        base::Unretained(this),
+                                                        std::vector<std::string>(), false));
+    }
+
+    void OnProxyLookupComplete(int32_t net_error,
+                               const std::optional<net::ProxyInfo> &proxy_info) override
+    {
+        receiver_.reset();
+        if (net_error != net::OK || !proxy_info || !proxy_info->is_direct())
+            return Finish({}, false);
+        if (const auto &resolveForTesting = dnsAliasResolverForTesting()) {
+            std::vector<std::string> aliases;
+            if (const auto answer = resolveForTesting(QString::fromStdString(url_.host())))
+                for (const QString &alias : *answer)
+                    aliases.push_back(alias.toStdString());
+            return Finish(std::move(aliases), true);
+        }
+        resolver_ = network::SimpleHostResolver::Create(context_);
+        resolver_->ResolveHost(network::mojom::HostResolverHost::NewSchemeHostPort(
+                                       url::SchemeHostPort(url_)),
+                               key_, parameters(),
+                               base::BindOnce(&DnsAliasLookup::OnResolved, base::Unretained(this)));
+    }
+
+private:
+    // Qt leaves Chromium's own DNS client off, so without secure DNS every
+    // lookup goes through the system resolver, which reports no alias unless
+    // it is asked for the canonical name, and then reports only that one. The
+    // question is asked only then: Chromium sends any lookup that asks it to
+    // the system resolver, which would take a secure DNS lookup off DoH.
+    static network::mojom::ResolveHostParametersPtr parameters()
+    {
+        if (QWebEngineGlobalSettingsPrivate::instance()->dnsMode
+            != QWebEngineGlobalSettings::SecureDnsMode::SystemOnly)
+            return nullptr;
+        auto parameters = network::mojom::ResolveHostParameters::New();
+        parameters->include_canonical_name = true;
+        return parameters;
+    }
+
+    void OnResolved(int result, const net::ResolveErrorInfo &, const net::AddressList &addresses,
+                    const net::HostResolverEndpointResults &)
+    {
+        Finish(result == net::OK ? addresses.dns_aliases() : std::vector<std::string>(), true);
+    }
+
+    // Delivered as a task of its own, so the request that owns this lookup can
+    // destroy it from the callback.
+    void Finish(std::vector<std::string> aliases, bool looked_up)
+    {
+        if (!callback_)
+            return;
+        base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+                FROM_HERE, base::BindOnce(std::move(callback_), std::move(aliases), looked_up));
+    }
+
+    raw_ptr<network::mojom::NetworkContext> context_;
+    const GURL url_;
+    const net::NetworkAnonymizationKey key_;
+    Callback callback_;
+    mojo::Receiver<network::mojom::ProxyLookupClient> receiver_{ this };
+    std::unique_ptr<network::SimpleHostResolver> resolver_;
+};
+
