+// The real resolver rather than the stand-in, against hosts whose CNAME chains
+// are public and end at a CDN. It needs the internet, so it runs only when
+// asked for; scripts/check-real-dns.sh in the patch series asks. Without
+// secure DNS the system resolver answers, and it names the chain's last name
+// only. With it, Chromium's own client answers with the whole chain.
+void tst_QWebEngineUrlRequestInterceptor::dnsAliasesFromTheResolver_data()
+{
+    QTest::addColumn<QWebEngineGlobalSettings::SecureDnsMode>("mode");
+    QTest::addColumn<int>("fewestNames");
+    QTest::newRow("system resolver") << QWebEngineGlobalSettings::SecureDnsMode::SystemOnly << 1;
+    QTest::newRow("secure DNS") << QWebEngineGlobalSettings::SecureDnsMode::SecureOnly << 2;
+}
+
+void tst_QWebEngineUrlRequestInterceptor::dnsAliasesFromTheResolver()
+{
+    if (qEnvironmentVariableIsEmpty("OMAWEB_CHECK_REAL_DNS"))
+        QSKIP("Reaches the internet; set OMAWEB_CHECK_REAL_DNS to run it.");
+    QFETCH(QWebEngineGlobalSettings::SecureDnsMode, mode);
+    QFETCH(int, fewestNames);
+    QVERIFY(QWebEngineGlobalSettings::setDnsMode(
+            { mode, { QStringLiteral("https://cloudflare-dns.com/dns-query") } }));
+    const auto restore = qScopeGuard([] {
+        QWebEngineGlobalSettings::setDnsMode({ QWebEngineGlobalSettings::SecureDnsMode::SystemOnly, {} });
+    });
+
+    const QList<QUrl> icons{ QUrl(QStringLiteral("https://www.apple.com/favicon.ico")),
+                             QUrl(QStringLiteral("https://www.ibm.com/favicon.ico")),
+                             QUrl(QStringLiteral("https://www.microsoft.com/favicon.ico")) };
+    QString html;
+    for (const QUrl &icon : icons)
+        html += QStringLiteral("<img src='%1'>").arg(icon.toString());
+    QWebEngineProfile profile;
+    DnsAliasInterceptor interceptor;
+    profile.setUrlRequestInterceptor(&interceptor);
+    QWebEnginePage page(&profile);
+    QSignalSpy loaded(&page, &QWebEnginePage::loadFinished);
+    page.setHtml(html, QUrl(QStringLiteral("http://site.test/")));
+    QTRY_COMPARE_WITH_TIMEOUT(loaded.size(), 1, 30000);
+
+    for (const QUrl &icon : icons) {
+        const auto calls = interceptor.callsFor(icon);
+        QVERIFY2(calls.size() == 2, qPrintable(icon.host() + QStringLiteral(": no second call")));
+        const QStringList names = calls.at(1).aliases;
+        qInfo() << icon.host() << names;
+        QVERIFY2(names.size() >= fewestNames, qPrintable(icon.host()));
+        QVERIFY2(std::any_of(names.cbegin(), names.cend(),
+                             [](const QString &name) { return name.endsWith(QStringLiteral(".akamaiedge.net")); }),
+                 qPrintable(icon.host()));
+    }
+}
