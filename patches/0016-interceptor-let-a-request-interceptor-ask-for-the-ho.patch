+/*!
+    \since 6.12
+    Asks for the DNS aliases of the request's host.
+
+    Call this from QWebEngineUrlRequestInterceptor::interceptRequest() on a request the
+    interceptor does not block or redirect. The host is then resolved through the profile's
+    own resolver and host cache, and when the lookup returns an alias other than the host
+    itself, interceptRequest() is called once more for the same request, with dnsAliases()
+    set. The request waits for the lookup before it starts.
+
+    No lookup is made for a main-frame navigation, for a host that is an IP address, or when
+    a proxy applies to the request. A failed lookup leaves the first call's decision standing.
+
+    \sa dnsAliases()
+*/
+void QWebEngineUrlRequestInfo::requestDnsAliases()
+{
+    d_ptr->dnsAliasesRequested = true;
+}
+
+/*!
+    \since 6.12
+    Returns the names in the CNAME chain of the request's host, not including the host
+    itself. The order is not significant: the canonical name is among them, but the
+    resolver does not say which it is.
+
+    The list is empty unless the interceptor asked for it with requestDnsAliases() on an
+    earlier call for the same request, so a non-empty list also marks the second call.
+
+    \sa requestDnsAliases()
+*/
+QStringList QWebEngineUrlRequestInfo::dnsAliases() const
+{
+    return d_ptr->dnsAliases;
+}
