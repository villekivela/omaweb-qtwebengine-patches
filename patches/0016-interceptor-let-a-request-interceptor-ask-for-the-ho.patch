+// A host a profile has just resolved is not resolved again: the second
+// request is judged by the same answer, and waits for no lookup at all.
+void tst_QWebEngineUrlRequestInterceptor::dnsAliasesAreRememberedForAHost()
+{
+    TestResolver resolver(QStringList{ QStringLiteral("collect.tracker.test") });
+    QWebEngineProfile profile;
+    DnsAliasInterceptor interceptor;
+    profile.setUrlRequestInterceptor(&interceptor);
+    loadCloakedPixel(profile);
+    loadCloakedPixel(profile);
+
+    const auto calls = interceptor.callsFor(cloakedPixel);
+    QCOMPARE(calls.size(), 4);
+    QCOMPARE(calls.at(3).aliases, QStringList{ QStringLiteral("collect.tracker.test") });
+    QCOMPARE(resolver.lookups, 1);
+}
