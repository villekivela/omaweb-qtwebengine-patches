+// Asks for the DNS aliases of every subresource it lets through, and records
+// each call it gets: the address, and the aliases the call came with.
+class DnsAliasInterceptor : public QWebEngineUrlRequestInterceptor
+{
+public:
+    struct Call
+    {
+        QUrl url;
+        QStringList aliases;
+    };
+    QList<Call> calls;
+    bool ask = true;
+    bool block = false;
+
+    void interceptRequest(QWebEngineUrlRequestInfo &info) override
+    {
+        if (info.resourceType() == QWebEngineUrlRequestInfo::ResourceTypeMainFrame)
+            return;
+        calls.append({ info.requestUrl(), info.dnsAliases() });
+        if (!info.dnsAliases().isEmpty())
+            return;
+        if (block)
+            info.block(true);
+        else if (ask)
+            info.requestDnsAliases();
+    }
+
+    QList<Call> callsFor(const QUrl &url) const
+    {
+        QList<Call> matching;
+        for (const Call &call : calls) {
+            if (call.url == url)
+                matching.append(call);
+        }
+        return matching;
+    }
+};
+
+static const QUrl cloakedPixel(QStringLiteral("http://metrics.site.test/pixel.png"));
+
+// Loads a page on a named host that asks for one image from a subdomain of
+// its own, and waits for it to finish. No request reaches a network: the
+// hosts do not resolve, and the image failing to load is not what is tested.
+static void loadCloakedPixel(QWebEngineProfile &profile)
+{
+    QWebEnginePage page(&profile);
+    QSignalSpy loaded(&page, &QWebEnginePage::loadFinished);
+    page.setHtml(QStringLiteral("<img src='%1'>").arg(cloakedPixel.toString()),
+                 QUrl(QStringLiteral("http://site.test/")));
+    QTRY_COMPARE_WITH_TIMEOUT(loaded.size(), 1, 20000);
+}
+
+// Stands in for the network service's resolver, and counts how often it is
+// asked about the image's host. The page's favicon is looked up too, at a
+// moment of the engine's choosing, so it is left out of the count.
+struct TestResolver
+{
+    int lookups = 0;
+    std::optional<QStringList> answer;
+
+    TestResolver(std::optional<QStringList> value) : answer(std::move(value))
+    {
+        QtWebEngineCore::setDnsAliasResolverForTesting([this](const QString &host) {
+            if (host == cloakedPixel.host())
+                ++lookups;
+            return answer;
+        });
+    }
+    ~TestResolver() { QtWebEngineCore::setDnsAliasResolverForTesting({}); }
+};
+
+void tst_QWebEngineUrlRequestInterceptor::dnsAliasesReachASecondCall()
+{
+    TestResolver resolver(QStringList{ QStringLiteral("collect.tracker.test"),
+                                       QStringLiteral("edge.tracker.test"),
+                                       cloakedPixel.host() });
+    QWebEngineProfile profile;
+    DnsAliasInterceptor interceptor;
+    profile.setUrlRequestInterceptor(&interceptor);
+    loadCloakedPixel(profile);
+
+    const auto calls = interceptor.callsFor(cloakedPixel);
+    QCOMPARE(calls.size(), 2);
+    QVERIFY(calls.at(0).aliases.isEmpty());
+    // The chain as the resolver gave it, less the host itself.
+    QCOMPARE(calls.at(1).aliases,
+             (QStringList{ QStringLiteral("collect.tracker.test"), QStringLiteral("edge.tracker.test") }));
+    QCOMPARE(resolver.lookups, 1);
+}
+
+void tst_QWebEngineUrlRequestInterceptor::dnsAliasesAreNotLookedUpUnlessAsked()
+{
+    TestResolver resolver(QStringList{ QStringLiteral("collect.tracker.test") });
+    QWebEngineProfile profile;
+    DnsAliasInterceptor interceptor;
+    interceptor.ask = false;
+    profile.setUrlRequestInterceptor(&interceptor);
+    loadCloakedPixel(profile);
+
+    QCOMPARE(interceptor.callsFor(cloakedPixel).size(), 1);
+    QCOMPARE(resolver.lookups, 0);
+}
+
+void tst_QWebEngineUrlRequestInterceptor::dnsAliasesAreNotLookedUpForABlockedRequest()
+{
+    TestResolver resolver(QStringList{ QStringLiteral("collect.tracker.test") });
+    QWebEngineProfile profile;
+    DnsAliasInterceptor interceptor;
+    interceptor.block = true;
+    profile.setUrlRequestInterceptor(&interceptor);
+    loadCloakedPixel(profile);
+
+    QCOMPARE(interceptor.callsFor(cloakedPixel).size(), 1);
+    QCOMPARE(resolver.lookups, 0);
+}
+
+// Behind a proxy a local lookup leaks the query, and can disagree with the
+// address the proxy connects to, so none is made.
+void tst_QWebEngineUrlRequestInterceptor::dnsAliasesAreNotLookedUpBehindAProxy()
+{
+    TestResolver resolver(QStringList{ QStringLiteral("collect.tracker.test") });
+    QNetworkProxy::setApplicationProxy(
+            QNetworkProxy(QNetworkProxy::HttpProxy, QStringLiteral("127.0.0.1"), 9));
+    const auto restore = qScopeGuard([] { QNetworkProxy::setApplicationProxy(QNetworkProxy()); });
+    QWebEngineProfile profile;
+    DnsAliasInterceptor interceptor;
+    profile.setUrlRequestInterceptor(&interceptor);
+    loadCloakedPixel(profile);
+
+    QCOMPARE(interceptor.callsFor(cloakedPixel).size(), 1);
+    QCOMPARE(resolver.lookups, 0);
+}
+
+void tst_QWebEngineUrlRequestInterceptor::dnsAliasesThatFailLeaveTheFirstDecision()
+{
+    TestResolver resolver(std::nullopt);
+    QWebEngineProfile profile;
+    DnsAliasInterceptor interceptor;
+    profile.setUrlRequestInterceptor(&interceptor);
+    loadCloakedPixel(profile);
+
+    QCOMPARE(interceptor.callsFor(cloakedPixel).size(), 1);
+    QCOMPARE(resolver.lookups, 1);
