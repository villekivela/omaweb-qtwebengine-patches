+    QWebEngineProfile second(QStringLiteral("dns-aliases-second"));
+    DnsAliasInterceptor interceptor;
+    first.setUrlRequestInterceptor(&interceptor);
+    second.setUrlRequestInterceptor(&interceptor);
+    loadCloakedPixel(first);
+    loadCloakedPixel(second);
+
+    QCOMPARE(resolver.lookups, 2);
+}
