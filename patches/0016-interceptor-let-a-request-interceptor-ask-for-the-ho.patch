     // This is called when the original URLLoaderClient has a connection error.
     void OnURLLoaderClientError();
@@ -177,6 +335,7 @@ private:
     };
 
     std::unique_ptr<QWebEngineUrlRequestInfo, RequestInfoDeleter> request_info_;
+    std::unique_ptr<DnsAliasLookup> dns_alias_lookup_;
 
     mojo::Receiver<network::mojom::URLLoader> proxied_loader_receiver_;
     mojo::Remote<network::mojom::URLLoaderClient> target_client_;
@@ -345,6 +504,68 @@ void InterceptedRequest::Restart()
     request_info_.reset(new QWebEngineUrlRequestInfo(info));
 
     InterceptOnUIThread();
+    if (WantsDnsAliases())
+        return LookUpDnsAliases();
+    ContinueAfterIntercept();
+}
+
+// An interceptor that let a request through may ask to see it again with the
+// host's DNS aliases, to judge it by the name the host resolves to. Only a
+// subresource of a named host is looked up: a navigation goes where the
+// reader asked, and an IP address has no aliases.
+bool InterceptedRequest::WantsDnsAliases() const
+{
+    if (!request_info_ || !profile_adapter_)
+        return false;
+    const QWebEngineUrlRequestInfoPrivate &info = *request_info_->d_ptr;
+    if (!info.dnsAliasesRequested || info.shouldBlockRequest || info.shouldRedirectRequest)
+        return false;
+    if (blink::mojom::ResourceType(request_.resource_type) == blink::mojom::ResourceType::kMainFrame)
+        return false;
+    if (!request_.url.SchemeIsHTTPOrHTTPS() && !request_.url.SchemeIsWSOrWSS())
+        return false;
+    return !request_.url.HostIsIPAddress();
+}
+
+void InterceptedRequest::LookUpDnsAliases()
+{
+    DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+    if (auto remembered = DnsAliasCache::instance().find(profile_adapter_, request_.url.host()))
+        return OnDnsAliases(std::move(*remembered), false);
+    net::NetworkAnonymizationKey key;
+    if (!frame_tree_node_id_.is_null()) {
+        if (auto *node = content::FrameTreeNode::GloballyFindByID(frame_tree_node_id_)) {
+            if (auto *frame = node->current_frame_host())
+                key = frame->GetIsolationInfoForSubresources().network_anonymization_key();
+        }
+    }
+    auto *context = profile_adapter_->profile()->GetDefaultStoragePartition()->GetNetworkContext();
+    dns_alias_lookup_ = std::make_unique<DnsAliasLookup>(
+            context, request_.url, key,
+            base::BindOnce(&InterceptedRequest::OnDnsAliases, weak_factory_.GetWeakPtr()));
+}
+
+// The second call happens only for an alias other than the host itself. With
+// none, or a lookup that failed, the first call's decision stands.
+void InterceptedRequest::OnDnsAliases(std::vector<std::string> aliases, bool looked_up)
+{
+    DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+    dns_alias_lookup_.reset();
+    if (looked_up && profile_adapter_)
+        DnsAliasCache::instance().store(profile_adapter_, request_.url.host(), aliases);
+    if (!request_info_)
+        return ContinueAfterIntercept();
+    QStringList names;
+    for (const std::string &alias : aliases) {
+        if (!base::EqualsCaseInsensitiveASCII(alias, request_.url.host()))
+            names.append(QString::fromStdString(alias));
+    }
+    if (!names.isEmpty()) {
+        QWebEngineUrlRequestInfoPrivate &info = *request_info_->d_ptr;
+        info.dnsAliasesRequested = false;
+        info.dnsAliases = names;
+        InterceptOnUIThread();
+    }
     ContinueAfterIntercept();
 }
 
