+static DnsAliasResolverForTesting &dnsAliasResolverForTesting()
+{
+    static DnsAliasResolverForTesting resolver;
+    return resolver;
+}
+
+void setDnsAliasResolverForTesting(DnsAliasResolverForTesting resolver)
+{
+    dnsAliasResolverForTesting() = std::move(resolver);
