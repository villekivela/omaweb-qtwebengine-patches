 };
 
+// Maps a color by the role it is drawn in, toward a ground color and a text
+// color, so a page is drawn dark as a designed dark theme would draw it rather
+// than with its lightness inverted. The mappings are Dark Reader's
+// (src/inject/dynamic-theme/modify-colors.ts, MIT licensed): each moves a
+// color's HSL lightness into a range of its own, and a near-grey color takes
+// the hue and saturation of the color it is drawn toward.
+//
+// The mappings carry this notice from Dark Reader's LICENSE:
+//
+// Copyright (c) 2026 Dark Reader Ltd.
+//
+// Permission is hereby granted, free of charge, to any person obtaining a copy
+// of this software and associated documentation files (the "Software"), to
+// deal in the Software without restriction, including without limitation the
+// rights to use, copy, modify, merge, publish, distribute, sublicense, and/or
+// sell copies of the Software, and to permit persons to whom the Software is
+// furnished to do so, subject to the following conditions:
+//
+// The above copyright notice and this permission notice shall be included in
+// all copies or substantial portions of the Software.
+//
+// THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+// IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+// FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
+// AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+// LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
+// FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS
+// IN THE SOFTWARE.
+class RoleAwareColorFilter : public DarkModeColorFilter {
+ public:
+  explicit RoleAwareColorFilter(const DarkModeSettings& settings)
+      : ground_(ToHSL(settings.ground_color)),
+        text_(ToHSL(settings.text_color)) {
+    // Images are classified and inverted as before.
+    SkHighContrastConfig config;
+    config.fInvertStyle = SkHighContrastConfig::InvertStyle::kInvertLightness;
+    config.fGrayscale = false;
+    config.fContrast = 0.0;
+    filter_ = cc::ColorFilter::MakeHighContrast(config);
+  }
+
+  SkColor4f InvertColor(const SkColor4f& color,
+                        DarkModeFilter::ElementRole role) const override {
+    // A color from another space, such as oklch(1 0 0), arrives with float
+    // noise around its channels, and near white that noise reads as a strong
+    // saturation. The mappings take 8 bits a channel, as Dark Reader does.
+    const HSL hsl = ToHSL(Drawn(color));
+    switch (role) {
+      case DarkModeFilter::ElementRole::kForeground:
+      case DarkModeFilter::ElementRole::kListSymbol:
+        return FromHSL(Foreground(hsl), color.fA);
+      case DarkModeFilter::ElementRole::kBorder:
+        return FromHSL(Border(hsl), color.fA);
+      case DarkModeFilter::ElementRole::kSVG:
+        // Fills, strokes and SVG text share one role. A light one is a shape
+        // the page is drawn on, and goes dark as a background does; a dark one
+        // is a logo, an icon or a stroke drawn on the page, which a background
+        // mapping would leave dark on the dark ground, so it goes light as
+        // text does.
+        return FromHSL(hsl.l < 0.5f ? Foreground(hsl) : Background(hsl),
+                       color.fA);
+      case DarkModeFilter::ElementRole::kBackground:
+      case DarkModeFilter::ElementRole::kSelection:
+        return FromHSL(Background(hsl), color.fA);
+    }
+    NOTREACHED();
+  }
+
+  // Moves the color's lightness away from the background's, by as little as
+  // reaches the ratio: lighter on a dark background, darker on a light one.
+  // The ratio is measured on the color as it is drawn, in 8 bits a channel,
+  // so rounding cannot take it back under.
+  SkColor4f AdjustColorForHigherConstrast(
+      const SkColor4f& adjusted_color,
+      const SkColor4f& background,
+      float reference_contrast_ratio) override {
+    if (color_utils::GetContrastRatio(adjusted_color, background) >=
+        reference_contrast_ratio) {
+      return adjusted_color;
+    }
+    // White and black reach the same contrast against a luminance of 0.179.
+    const bool lighten = color_utils::GetRelativeLuminance4f(background) < 0.179f;
+    HSL hsl = ToHSL(adjusted_color);
+    float low = hsl.l;
+    float high = lighten ? 1.0f : 0.0f;
+    hsl.l = high;
+    SkColor4f best_color = Drawn(FromHSL(hsl, adjusted_color.fA));
+    for (int step = 0; step < 16; ++step) {
+      hsl.l = (low + high) / 2;
+      const SkColor4f color = Drawn(FromHSL(hsl, adjusted_color.fA));
+      if (color_utils::GetContrastRatio(color, background) >=
+          reference_contrast_ratio) {
+        high = hsl.l;
+        best_color = color;
+      } else {
+        low = hsl.l;
+      }
+    }
+    return best_color;
+  }
+
+  sk_sp<cc::ColorFilter> ToColorFilter() const override { return filter_; }
+
+ private:
+  // Hue in degrees, saturation and lightness from 0 to 1.
+  struct HSL {
+    float h;
+    float s;
+    float l;
+  };
+
+  static HSL ToHSL(const SkColor4f& color) {
+    const float r = color.fR, g = color.fG, b = color.fB;
+    const float max = std::max({r, g, b});
+    const float min = std::min({r, g, b});
+    const float l = (max + min) / 2;
+    if (max == min)
+      return {0, 0, l};
+    const float d = max - min;
+    const float s = l > 0.5f ? d / (2 - max - min) : d / (max + min);
+    float h;
+    if (max == r)
+      h = std::fmod((g - b) / d + 6, 6.0f);
+    else if (max == g)
+      h = (b - r) / d + 2;
+    else
+      h = (r - g) / d + 4;
+    return {h * 60, s, l};
+  }
+
+  static SkColor4f FromHSL(const HSL& hsl, float alpha) {
+    const float c = (1 - std::abs(2 * hsl.l - 1)) * hsl.s;
+    const float x = c * (1 - std::abs(std::fmod(hsl.h / 60, 2.0f) - 1));
+    const float m = hsl.l - c / 2;
+    float r = 0, g = 0, b = 0;
+    if (hsl.h < 60) {
+      r = c;
+      g = x;
+    } else if (hsl.h < 120) {
+      r = x;
+      g = c;
+    } else if (hsl.h < 180) {
+      g = c;
+      b = x;
+    } else if (hsl.h < 240) {
+      g = x;
+      b = c;
+    } else if (hsl.h < 300) {
+      r = x;
+      b = c;
+    } else {
+      r = c;
+      b = x;
+    }
+    return {r + m, g + m, b + m, alpha};
+  }
+
+  // |color| rounded to 8 bits a channel, as the page is drawn.
+  static SkColor4f Drawn(const SkColor4f& color) {
+    SkColor4f drawn = SkColor4f::FromColor(color.toSkColor());
+    drawn.fA = color.fA;
+    return drawn;
+  }
+
+  // Maps |value| from the range |from_low| to |from_high| onto |to_low| to
+  // |to_high|.
+  static float Scale(float value,
+                     float from_low,
+                     float from_high,
+                     float to_low,
+                     float to_high) {
+    return (value - from_low) * (to_high - to_low) / (from_high - from_low) +
+           to_low;
+  }
+
+  // Dark Reader's modifyBgHSL: lightness 0 to 0.5 onto 0 to 0.4, and 0.5 to 1
+  // onto 0.4 down to the ground's, so white lands on the ground and a dark
+  // color stays dark.
+  HSL Background(const HSL& hsl) const {
+    constexpr float kMaxBackgroundLightness = 0.4f;
+    const bool blue = hsl.h > 200 && hsl.h < 280;
+    const bool neutral = hsl.s < 0.12f || (hsl.l > 0.8f && blue);
+    if (hsl.l < 0.5f) {
+      const float l = Scale(hsl.l, 0, 0.5f, 0, kMaxBackgroundLightness);
+      return neutral ? HSL{ground_.h, ground_.s, l} : HSL{hsl.h, hsl.s, l};
+    }
+    float l = Scale(hsl.l, 0.5f, 1, kMaxBackgroundLightness, ground_.l);
+    if (neutral)
