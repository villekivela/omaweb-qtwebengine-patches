+void tst_QWebEngineSettings::forceDarkModeColors()
+{
+    QWebEngineProfile profile;
+    QWebEnginePage page(&profile);
+
+    // Unset, the engine's own colors apply.
+    QVERIFY(!page.settings()->forceDarkModeGroundColor().isValid());
+    QVERIFY(!page.settings()->forceDarkModeTextColor().isValid());
+
+    // A page takes its profile's until it sets its own.
+    profile.settings()->setForceDarkModeGroundColor(QColor(0x28, 0x2a, 0x36));
+    profile.settings()->setForceDarkModeTextColor(QColor(0xf8, 0xf8, 0xf2));
+    QCOMPARE(page.settings()->forceDarkModeGroundColor(), QColor(0x28, 0x2a, 0x36));
+    QCOMPARE(page.settings()->forceDarkModeTextColor(), QColor(0xf8, 0xf8, 0xf2));
+    page.settings()->setForceDarkModeGroundColor(QColor(0x10, 0x10, 0x10));
+    QCOMPARE(page.settings()->forceDarkModeGroundColor(), QColor(0x10, 0x10, 0x10));
+    QCOMPARE(page.settings()->forceDarkModeTextColor(), QColor(0xf8, 0xf8, 0xf2));
+
+    // An invalid color is the parent's again.
+    page.settings()->setForceDarkModeGroundColor(QColor());
+    QCOMPARE(page.settings()->forceDarkModeGroundColor(), QColor(0x28, 0x2a, 0x36));
+    profile.settings()->setForceDarkModeGroundColor(QColor());
+    QVERIFY(!page.settings()->forceDarkModeGroundColor().isValid());
+}
+
+// One color in one role fills the middle of the view: a ground, a border, a
+// glyph that is a solid block of text, an SVG shape, a gradient.
+static QString rolePage(const QString &role, const QString &color)
+{
+    const QString box = QStringLiteral("position:absolute;left:100px;top:50px;width:200px;height:200px;");
+    if (role == u"ground")
+        return QStringLiteral("<body style=\"margin:0;background:%1\"></body>").arg(color);
+    if (role == u"element")
+        return QStringLiteral("<div style=\"%1background:%2\"></div>").arg(box, color);
+    if (role == u"border")
+        return QStringLiteral("<div style=\"%1box-sizing:border-box;border:100px solid %2\"></div>")
+                .arg(box, color);
+    if (role == u"text")
+        return QStringLiteral("<div style=\"position:absolute;left:100px;top:50px;"
+                              "font:200px/1 FreeMono,monospace;color:%1\">&#x2588;</div>")
+                .arg(color);
+    if (role == u"svg")
+        return QStringLiteral("<svg style=\"%1\" width=200 height=200><rect width=200 height=200 "
+                              "fill=\"%2\"/></svg>").arg(box, color);
+    if (role == u"gradient")
+        return QStringLiteral("<div style=\"%1background:linear-gradient(%2,%2)\"></div>")
+                .arg(box, color);
+    Q_UNREACHABLE_RETURN({});
+}
+
+static QColor centerColor(QWebEngineView &view)
+{
+    return view.grab().toImage().pixelColor(QPoint(200, 150));
+}
