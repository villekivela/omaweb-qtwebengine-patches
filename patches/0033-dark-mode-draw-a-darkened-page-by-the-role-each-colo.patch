+void tst_QWebEngineSettings::roleAwareDarkMode_data()
+{
+    QTest::addColumn<QString>("role");
+    QTest::addColumn<QString>("color");
+    QTest::addColumn<QColor>("ground");
+    QTest::addColumn<QColor>("text");
+    QTest::addColumn<QColor>("drawn");
+
+    // Worked from Dark Reader's color functions: a background's lightness goes
+    // from 0..0.5 onto 0..0.4 and from 0.5..1 onto 0.4 down to the ground's, a
+    // text's from 0..0.5 onto the text color's down to 0.55 and from 0.5..1
+    // onto 0.55 up to it, a border's onto 0.5 down to 0.2. A grey takes the
+    // hue and saturation of the color it is drawn toward.
+    const QColor none;
+    const QColor dracula(0x28, 0x2a, 0x36), draculaText(0xf8, 0xf8, 0xf2);
+    QTest::newRow("white ground") << "ground" << "#ffffff" << none << none << QColor(0x18, 0x1a, 0x1b);
+    // A color from another space reaches the filter with float noise around its channels.
+    QTest::newRow("white ground in oklch") << "ground" << "oklch(1 0 0)" << none << none
+                                           << QColor(0x18, 0x1a, 0x1b);
+    QTest::newRow("white ground, the application's") << "ground" << "#ffffff" << dracula << draculaText
+                                                     << dracula;
+    // Nothing is left light: no element is too dark to be mapped.
+    QTest::newRow("#cccccc element") << "element" << "#cccccc" << none << none << QColor(0x35, 0x39, 0x3b);
+    QTest::newRow("#d0d0d0 element") << "element" << "#d0d0d0" << none << none << QColor(0x33, 0x37, 0x39);
+    // A dark color stays dark, and a brand color keeps its hue.
+    QTest::newRow("#18181b element") << "element" << "#18181b" << none << none << QColor(0x13, 0x15, 0x16);
+    QTest::newRow("brand blue element") << "element" << "#0b63ce" << none << none << QColor(0x09, 0x4f, 0xa5);
+    QTest::newRow("light yellow element") << "element" << "#fff3cd" << none << none << QColor(0x3d, 0x2e, 0x00);
+    QTest::newRow("#222 text") << "text" << "#222222" << none << none << QColor(0xd3, 0xcf, 0xc9);
+    QTest::newRow("#222 text, the application's") << "text" << "#222222" << dracula << draculaText
+                                                  << QColor(0xe4, 0xe4, 0xce);
+    QTest::newRow("link blue text") << "text" << "#0b63ce" << none << none << QColor(0x53, 0xaa, 0xf6);
+    QTest::newRow("black border") << "border" << "#000000" << none << none << QColor(0x8c, 0x82, 0x73);
+    QTest::newRow("#ddd border") << "border" << "#dddddd" << none << none << QColor(0x3a, 0x3e, 0x41);
+    // A light SVG color is a shape the page is drawn on and goes dark; a dark one is a logo, an
+    // icon or a stroke drawn on the page, and goes light as text does.
+    QTest::newRow("white SVG shape") << "svg" << "#ffffff" << none << none << QColor(0x18, 0x1a, 0x1b);
+    QTest::newRow("black SVG shape") << "svg" << "#000000" << none << none << QColor(0xe8, 0xe6, 0xe3);
+    QTest::newRow("white gradient") << "gradient" << "#ffffff" << none << none << QColor(0x18, 0x1a, 0x1b);
+}
+
+void tst_QWebEngineSettings::roleAwareDarkMode()
+{
+    QFETCH(QString, role);
+    QFETCH(QString, color);
+    QFETCH(QColor, ground);
+    QFETCH(QColor, text);
+    QFETCH(QColor, drawn);
+
+    QWebEngineView view;
+    view.resize(400, 300);
+    view.show();
+    QVERIFY(QTest::qWaitForWindowExposed(&view));
+    view.settings()->setAttribute(QWebEngineSettings::ForceDarkMode, true);
+    view.settings()->setForceDarkModeGroundColor(ground);
+    view.settings()->setForceDarkModeTextColor(text);
+    QSignalSpy loadFinishedSpy(view.page(), SIGNAL(loadFinished(bool)));
+    view.setHtml(rolePage(role, color));
+    QVERIFY(loadFinishedSpy.wait());
+    QTRY_COMPARE(centerColor(view), drawn);
+}
+
+static double luminance(const QColor &color)
+{
+    const auto channel = [](double value) {
+        return value <= 0.03928 ? value / 12.92 : std::pow((value + 0.055) / 1.055, 2.4);
+    };
+    return 0.2126 * channel(color.redF()) + 0.7152 * channel(color.greenF())
+            + 0.0722 * channel(color.blueF());
+}
+
+static double contrast(const QColor &a, const QColor &b)
+{
+    const double la = luminance(a), lb = luminance(b);
+    return (std::max(la, lb) + 0.05) / (std::min(la, lb) + 0.05);
+}
+
+// A dim text color would leave black text at 2.6:1 on a black ground. It is
+// lightened until it reads at 4.5:1.
+void tst_QWebEngineSettings::roleAwareDarkModeRaisesTextContrast()
+{
+    QWebEngineView view;
+    view.resize(400, 300);
+    view.show();
+    QVERIFY(QTest::qWaitForWindowExposed(&view));
+    view.settings()->setAttribute(QWebEngineSettings::ForceDarkMode, true);
+    view.settings()->setForceDarkModeGroundColor(Qt::black);
+    view.settings()->setForceDarkModeTextColor(QColor(0x50, 0x50, 0x50));
+    QSignalSpy loadFinishedSpy(view.page(), SIGNAL(loadFinished(bool)));
+    view.setHtml(QStringLiteral("<body style=\"margin:0;background:#fff\">")
+                 + rolePage(u"text"_s, u"#000000"_s));
+    QVERIFY(loadFinishedSpy.wait());
+    QTRY_COMPARE(view.grab().toImage().pixelColor(QPoint(10, 10)), QColor(Qt::black));
+    QTRY_VERIFY(centerColor(view) != QColor(Qt::black));
+    const QColor drawn = centerColor(view);
+    QVERIFY2(contrast(drawn, Qt::black) >= 4.5, qPrintable(drawn.name()));
+    QVERIFY2(contrast(drawn, Qt::black) < 5.0, qPrintable(drawn.name()));
+}
+
+// The colors reach a page that is already showing, with no reload.
+void tst_QWebEngineSettings::roleAwareDarkModeFollowsAColorChange()
+{
+    QWebEngineView view;
+    view.resize(400, 300);
+    view.show();
+    QVERIFY(QTest::qWaitForWindowExposed(&view));
+    view.settings()->setAttribute(QWebEngineSettings::ForceDarkMode, true);
+    QSignalSpy loadFinishedSpy(view.page(), SIGNAL(loadFinished(bool)));
+    view.setHtml(rolePage(u"ground"_s, u"#ffffff"_s));
+    QVERIFY(loadFinishedSpy.wait());
+    QTRY_COMPARE(centerColor(view), QColor(0x18, 0x1a, 0x1b));
+
+    QSignalSpy loadStartedSpy(view.page(), SIGNAL(loadStarted()));
+    view.settings()->setForceDarkModeGroundColor(QColor(0x28, 0x2a, 0x36));
+    view.settings()->setForceDarkModeTextColor(QColor(0xf8, 0xf8, 0xf2));
+    QTRY_COMPARE(centerColor(view), QColor(0x28, 0x2a, 0x36));
+    view.settings()->setForceDarkModeGroundColor(QColor());
+    view.settings()->setForceDarkModeTextColor(QColor());
+    QTRY_COMPARE(centerColor(view), QColor(0x18, 0x1a, 0x1b));
+    QCOMPARE(loadStartedSpy.size(), 0);
+}
