+
+#include <QtCore/qbytearray.h>
+#include <QtCore/qtconfigmacros.h>
+
+#include <memory>
+#include <string>
+
+QT_FORWARD_DECLARE_CLASS(QWebEngineDevToolsSession)
+
+namespace QtWebEngineCore {
+
+// The engine's side of QWebEngineDevToolsSession: an untrusted protocol client of one page.
+// Chromium gives an untrusted client no Target discovery or attachment beyond the page's own
+// auto-attached children.
+class DevToolsSessionQt
+{
+public:
+    explicit DevToolsSessionQt(QWebEngineDevToolsSession *session);
+    ~DevToolsSessionQt();
+
+    bool attach(const std::string &devToolsId);
+    // Whether there was a session to end.
+    bool detach();
+    bool isAttached() const;
+    void sendMessage(const QByteArray &message);
+
+private:
+    class Client;
+    std::unique_ptr<Client> m_client;
+};
+
+} // namespace QtWebEngineCore
+
+#endif // DEVTOOLS_SESSION_QT_H
