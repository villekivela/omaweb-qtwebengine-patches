+#include <QtCore/qobject.h>
+#include <QtCore/qstring.h>
+
+#include <memory>
+
+namespace QtWebEngineCore {
+class DevToolsSessionQt;
+}
+
+QT_BEGIN_NAMESPACE
+
+class Q_WEBENGINECORE_EXPORT QWebEngineDevToolsSession : public QObject
+{
+    Q_OBJECT
+    Q_PROPERTY(bool attached READ isAttached NOTIFY attachedChanged FINAL)
+
+public:
+    explicit QWebEngineDevToolsSession(QObject *parent = nullptr);
+    ~QWebEngineDevToolsSession() override;
+
+    Q_INVOKABLE bool attach(const QString &devToolsId);
+    Q_INVOKABLE void detach();
+    bool isAttached() const;
+
+    Q_INVOKABLE void sendMessage(const QByteArray &message);
+
+Q_SIGNALS:
+    void messageReceived(const QByteArray &message);
+    void detached();
+    void attachedChanged();
+
+private:
+    Q_DISABLE_COPY(QWebEngineDevToolsSession)
+
+    std::unique_ptr<QtWebEngineCore::DevToolsSessionQt> d_ptr;
+};
+
+QT_END_NAMESPACE
+
+#endif // QWEBENGINEDEVTOOLSSESSION_H
diff --git a/src/core/devtools_session_qt.cpp b/src/core/devtools_session_qt.cpp
new file mode 100644
index 0000000000..e95f0e89e0
--- /dev/null
+++ b/src/core/devtools_session_qt.cpp
@@ -0,0 +1,112 @@
+// Copyright (C) 2026 The Qt Company Ltd.
+// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only
+
+#include "devtools_session_qt.h"
+
+#include "api/qwebenginedevtoolssession.h"
+
+#include "base/containers/span.h"
+#include "base/memory/scoped_refptr.h"
+#include "content/public/browser/devtools_agent_host.h"
+#include "content/public/browser/devtools_agent_host_client.h"
+#include "content/public/browser/web_contents.h"
+
+namespace QtWebEngineCore {
+
+class DevToolsSessionQt::Client : public content::DevToolsAgentHostClient
+{
+public:
+    explicit Client(QWebEngineDevToolsSession *session) : m_session(session) { }
+    ~Client() override { detach(); }
+
+    bool attach(scoped_refptr<content::DevToolsAgentHost> host)
+    {
+        detach();
+        if (!host->AttachClient(this))
+            return false;
+        m_host = std::move(host);
+        return true;
+    }
+
+    bool detach()
+    {
+        if (!m_host)
+            return false;
+        scoped_refptr<content::DevToolsAgentHost> host = std::move(m_host);
+        host->DetachClient(this);
+        return true;
+    }
+
+    bool isAttached() const { return !!m_host; }
+
+    void send(base::span<const uint8_t> message)
+    {
+        if (m_host)
+            m_host->DispatchProtocolMessage(this, message);
+    }
+
+    void DispatchProtocolMessage(content::DevToolsAgentHost *host,
+                                 base::span<const uint8_t> message) override
+    {
+        if (host != m_host.get())
+            return;
+        Q_EMIT m_session->messageReceived(
+                QByteArray(reinterpret_cast<const char *>(message.data()), message.size()));
+    }
+
+    void AgentHostClosed(content::DevToolsAgentHost *host) override
+    {
+        if (host != m_host.get())
+            return;
+        m_host = nullptr;
+        Q_EMIT m_session->detached();
+        Q_EMIT m_session->attachedChanged();
+    }
+
+    // What makes the session a page's and nothing more.
+    bool IsTrusted() override { return false; }
+    bool MayReadLocalFiles() override { return false; }
+    bool MayWriteLocalFiles() override { return false; }
+    bool AllowUnsafeOperations() override { return false; }
+
+private:
+    QWebEngineDevToolsSession *m_session;
+    scoped_refptr<content::DevToolsAgentHost> m_host;
+};
+
+DevToolsSessionQt::DevToolsSessionQt(QWebEngineDevToolsSession *session)
+    : m_client(std::make_unique<Client>(session))
+{
+}
+
+DevToolsSessionQt::~DevToolsSessionQt() = default;
+
+bool DevToolsSessionQt::attach(const std::string &devToolsId)
+{
+    scoped_refptr<content::DevToolsAgentHost> host =
+            content::DevToolsAgentHost::GetForId(devToolsId);
+    // Only a page's own host. An id for a worker, a frame or the browser is refused, as the
+    // session would be refused them once attached.
+    if (!host || host->GetType() != content::DevToolsAgentHost::kTypePage
+        || !host->GetWebContents()
+        || host != content::DevToolsAgentHost::GetOrCreateFor(host->GetWebContents()))
+        return false;
+    return m_client->attach(std::move(host));
+}
+
+bool DevToolsSessionQt::detach()
+{
+    return m_client->detach();
+}
+
+bool DevToolsSessionQt::isAttached() const
+{
+    return m_client->isAttached();
+}
+
+void DevToolsSessionQt::sendMessage(const QByteArray &message)
+{
+    m_client->send(base::as_byte_span(std::string_view(message.constData(), message.size())));
+}
+
+} // namespace QtWebEngineCore
