diff --git a/tests/auto/core/devtools/tst_devtools.cpp b/tests/auto/core/devtools/tst_devtools.cpp
index 7284f0d51e..6d263dd3b2 100644
--- a/tests/auto/core/devtools/tst_devtools.cpp
+++ b/tests/auto/core/devtools/tst_devtools.cpp
@@ -3,16 +3,61 @@
 
 #include <QtTest/QtTest>
 
+#include <qwebenginedevtoolssession.h>
 #include <qwebenginepage.h>
 
+#include <QtCore/qjsonarray.h>
+#include <QtCore/qjsondocument.h>
+#include <QtCore/qjsonobject.h>
+
+#include <httpserver.h>
+#include <httpreqrep.h>
+
 class tst_DevTools : public QObject {
     Q_OBJECT
 
 private Q_SLOTS:
     void attachAndDestroyPageFirst();
     void attachAndDestroyInspectorFirst();
+    void sessionAnswersOnItsPage();
+    void sessionRefusesAnUnknownPage();
+    void sessionCannotListTargets();
+    void sessionCannotAttachToAnotherPage();
+    void sessionSeesThePagesRequests();
+    void sessionEndsWhenThePageCloses();
+    void sessionEndsWhenDetached();
 };
 
+// Sends one protocol command on the session and waits for the answer with its id.
+static QJsonObject command(QWebEngineDevToolsSession &session, const QString &method,
+                           const QJsonObject &params = {})
+{
+    static int lastId = 0;
+    const int id = ++lastId;
+    QJsonObject answer;
+    auto connection = QObject::connect(&session, &QWebEngineDevToolsSession::messageReceived,
+                                       [&](const QByteArray &message) {
+        const QJsonObject object = QJsonDocument::fromJson(message).object();
+        if (object.value(QStringLiteral("id")).toInt() == id)
+            answer = object;
+    });
+    session.sendMessage(QJsonDocument(QJsonObject{ { QStringLiteral("id"), id },
+                                                   { QStringLiteral("method"), method },
+                                                   { QStringLiteral("params"), params } })
+                                .toJson(QJsonDocument::Compact));
+    // An empty object, which no answer is, when none came.
+    QTest::qWaitFor([&answer] { return !answer.isEmpty(); }, 12000);
+    QObject::disconnect(connection);
+    return answer;
+}
+
+static void loadAndWait(QWebEnginePage &page, const QUrl &url)
+{
+    QSignalSpy spy(&page, &QWebEnginePage::loadFinished);
+    page.load(url);
+    QTRY_COMPARE_WITH_TIMEOUT(spy.size(), 1, 12000);
+}
+
 void tst_DevTools::attachAndDestroyPageFirst()
 {
     // External inspector + manual destruction of page first
@@ -63,6 +108,139 @@ void tst_DevTools::attachAndDestroyInspectorFirst()
     delete page;
 }
 
+void tst_DevTools::sessionAnswersOnItsPage()
+{
+    QWebEnginePage page;
+    loadAndWait(page, QUrl("data:text/html,<title>here</title>"));
+
+    QWebEngineDevToolsSession session;
+    QSignalSpy attachedChanged(&session, &QWebEngineDevToolsSession::attachedChanged);
+    QVERIFY(session.attach(page.devToolsId()));
+    QVERIFY(session.isAttached());
+    QCOMPARE(attachedChanged.size(), 1);
+
+    const QJsonObject answer = command(session, QStringLiteral("Runtime.evaluate"),
+                                       { { QStringLiteral("expression"), QStringLiteral("document.title") } });
+    QVERIFY2(!answer.isEmpty(), "no answer");
+    QCOMPARE(answer[QStringLiteral("result")][QStringLiteral("result")][QStringLiteral("value")]
+                     .toString(),
+             QStringLiteral("here"));
+}
+
+void tst_DevTools::sessionRefusesAnUnknownPage()
+{
+    QWebEngineDevToolsSession session;
+    QVERIFY(!session.attach(QStringLiteral("no-such-page")));
+    QVERIFY(!session.isAttached());
+}
+
+// The session is not trusted, so it reaches its own page and no other target.
+void tst_DevTools::sessionCannotListTargets()
+{
+    QWebEnginePage page;
+    QWebEnginePage other;
+    loadAndWait(page, QUrl("data:text/plain,one"));
+    loadAndWait(other, QUrl("data:text/plain,two"));
+
+    QWebEngineDevToolsSession session;
+    QVERIFY(session.attach(page.devToolsId()));
+
+    const QJsonObject answer = command(session, QStringLiteral("Target.getTargets"));
+    QVERIFY2(!answer.isEmpty(), "no answer");
+    QVERIFY2(answer.contains(QStringLiteral("error")), QJsonDocument(answer).toJson());
+    QVERIFY(!answer.contains(QStringLiteral("result")));
+}
+
+void tst_DevTools::sessionCannotAttachToAnotherPage()
+{
+    QWebEnginePage page;
+    QWebEnginePage other;
+    loadAndWait(page, QUrl("data:text/plain,one"));
+    loadAndWait(other, QUrl("data:text/plain,two"));
+
+    QWebEngineDevToolsSession session;
+    QVERIFY(session.attach(page.devToolsId()));
+
+    for (const bool flatten : { true, false }) {
+        const QJsonObject answer = command(session, QStringLiteral("Target.attachToTarget"),
+                                           { { QStringLiteral("targetId"), other.devToolsId() },
+                                             { QStringLiteral("flatten"), flatten } });
+        QVERIFY2(answer.contains(QStringLiteral("error")), QJsonDocument(answer).toJson());
+        QVERIFY(!answer.contains(QStringLiteral("result")));
+    }
+    const QJsonObject browser = command(session, QStringLiteral("Target.attachToBrowserTarget"));
+    QVERIFY2(browser.contains(QStringLiteral("error")), QJsonDocument(browser).toJson());
+}
+
+void tst_DevTools::sessionSeesThePagesRequests()
+{
+    HttpServer server;
+    connect(&server, &HttpServer::newRequest, [](HttpReqRep *rr) {
+        rr->setResponseHeader(QByteArrayLiteral("content-type"), QByteArrayLiteral("text/html"));
+        rr->setResponseBody(QByteArrayLiteral("<p>served</p>"));
+        rr->sendResponse(200);
+    });
+    QVERIFY(server.start());
+
+    QWebEnginePage page;
+    loadAndWait(page, QUrl("data:text/plain,blank"));
+    QWebEngineDevToolsSession session;
+    QVERIFY(session.attach(page.devToolsId()));
+    QVERIFY(!command(session, QStringLiteral("Network.enable")).contains(QStringLiteral("error")));
+
+    QString requestId;
+    connect(&session, &QWebEngineDevToolsSession::messageReceived, [&](const QByteArray &message) {
+        const QJsonObject object = QJsonDocument::fromJson(message).object();
+        if (object[QStringLiteral("method")] == QStringLiteral("Network.responseReceived")
+            && object[QStringLiteral("params")][QStringLiteral("response")][QStringLiteral("url")]
+                            .toString()
+                    == server.url(QStringLiteral("/served")).toString())
+            requestId = object[QStringLiteral("params")][QStringLiteral("requestId")].toString();
+    });
+    loadAndWait(page, server.url(QStringLiteral("/served")));
+    QTRY_VERIFY_WITH_TIMEOUT(!requestId.isEmpty(), 12000);
+
+    const QJsonObject body = command(session, QStringLiteral("Network.getResponseBody"),
+                                     { { QStringLiteral("requestId"), requestId } });
+    QVERIFY2(!body.isEmpty(), "no answer");
+    QCOMPARE(body[QStringLiteral("result")][QStringLiteral("body")].toString(),
+             QStringLiteral("<p>served</p>"));
+    QVERIFY(server.stop());
+}
+
+void tst_DevTools::sessionEndsWhenThePageCloses()
+{
+    auto page = std::make_unique<QWebEnginePage>();
+    loadAndWait(*page, QUrl("data:text/plain,closing"));
+    QWebEngineDevToolsSession session;
+    QVERIFY(session.attach(page->devToolsId()));
+    QSignalSpy detached(&session, &QWebEngineDevToolsSession::detached);
+
+    QSignalSpy attachedChanged(&session, &QWebEngineDevToolsSession::attachedChanged);
+
+    page.reset();
+    QTRY_COMPARE_WITH_TIMEOUT(detached.size(), 1, 12000);
+    QVERIFY(!session.isAttached());
+    QCOMPARE(attachedChanged.size(), 1);
+}
+
+void tst_DevTools::sessionEndsWhenDetached()
+{
+    QWebEnginePage page;
+    loadAndWait(page, QUrl("data:text/plain,detaching"));
+    QWebEngineDevToolsSession session;
+    QVERIFY(session.attach(page.devToolsId()));
+    QSignalSpy detached(&session, &QWebEngineDevToolsSession::detached);
+    QSignalSpy messages(&session, &QWebEngineDevToolsSession::messageReceived);
+
+    session.detach();
+    QVERIFY(!session.isAttached());
+    QCOMPARE(detached.size(), 1);
+    // A message after the end goes nowhere and is not answered.
+    session.sendMessage(R"({"id":1,"method":"Runtime.evaluate","params":{"expression":"1"}})");
+    QTest::qWait(200);
+    QCOMPARE(messages.size(), 0);
+}
 
 QTEST_MAIN(tst_DevTools)
 
