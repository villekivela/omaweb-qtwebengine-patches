@@ -0,0 +1,110 @@
+// Copyright (C) 2026 The Qt Company Ltd.
+// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only
+// Qt-Security score:critical reason:data-parser
+
+#include "qwebenginedevtoolssession.h"
+
+#include "devtools_session_qt.h"
+
+QT_BEGIN_NAMESPACE
+
+/*!
+    \class QWebEngineDevToolsSession
+    \brief The QWebEngineDevToolsSession class speaks the Chrome DevTools Protocol to one page.
+    \since 6.140
+    \inmodule QtWebEngineCore
+
+    A session is attached to a page by its QWebEnginePage::devToolsId(), or the
+    \c devToolsId of a WebEngineView in Qt Quick. The application sends protocol
+    commands as JSON with sendMessage() and hears answers and events through
+    messageReceived().
+
+    The session is not trusted. It reaches the page and the frames the page
+    holds, and nothing else: \c Target.getTargets, \c Target.attachToTarget and
+    \c Target.attachToBrowserTarget are refused, so it can neither list nor reach
+    the browser, other pages, or the page's service workers. Its child targets
+    are those \c Target.setAutoAttach brings, such as a cross-site frame. It may
+    not read or write local files through the protocol, and is refused the
+    operations Chromium keeps for privileged automation clients.
+
+    Unlike the remote debugging server, a session needs no port and serves
+    nobody but the application that opened it.
+
+    The session ends when detach() is called, when the page closes, and when the
+    session is destroyed. detached() is emitted in the first two cases.
+*/
+
+/*!
+    \fn void QWebEngineDevToolsSession::messageReceived(const QByteArray &message)
+
+    The page sent \a message, a protocol answer or event as JSON.
+*/
+
+/*!
+    \fn void QWebEngineDevToolsSession::detached()
+
+    The session ended, because detach() was called or the page closed.
+*/
+
+/*!
+    \fn void QWebEngineDevToolsSession::attachedChanged()
+
+    The session was attached to a page, or ended.
+*/
+
+/*!
+    Constructs a session that is not attached, with \a parent.
+*/
+QWebEngineDevToolsSession::QWebEngineDevToolsSession(QObject *parent)
+    : QObject(parent), d_ptr(std::make_unique<QtWebEngineCore::DevToolsSessionQt>(this))
+{
+}
+
+QWebEngineDevToolsSession::~QWebEngineDevToolsSession() = default;
+
+/*!
+    Attaches the session to the page whose DevTools id is \a devToolsId, ending
+    any session it had. Returns \c false, and stays detached, when no page has
+    that id.
+*/
+bool QWebEngineDevToolsSession::attach(const QString &devToolsId)
+{
+    const bool wasAttached = d_ptr->isAttached();
+    const bool attached = d_ptr->attach(devToolsId.toStdString());
+    if (attached != wasAttached)
+        Q_EMIT attachedChanged();
+    return attached;
+}
+
+/*!
+    Ends the session. Nothing is sent after this and nothing is received.
+*/
+void QWebEngineDevToolsSession::detach()
+{
+    if (d_ptr->detach()) {
+        Q_EMIT detached();
+        Q_EMIT attachedChanged();
+    }
+}
+
+/*!
+    \property QWebEngineDevToolsSession::attached
+    \brief Whether the session is attached to a page.
+*/
+bool QWebEngineDevToolsSession::isAttached() const
+{
+    return d_ptr->isAttached();
+}
+
+/*!
+    Sends \a message, a protocol command as JSON, to the page. A session that is
+    not attached drops it.
+*/
+void QWebEngineDevToolsSession::sendMessage(const QByteArray &message)
+{
+    d_ptr->sendMessage(message);
+}
+
+QT_END_NAMESPACE
+
+#include "moc_qwebenginedevtoolssession.cpp"
