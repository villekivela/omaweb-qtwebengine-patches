@@ -19,6 +19,8 @@
 #include <QtWebEngineCore/qwebengineprofilebuilder.h>
 
 #include <QDir>
+#include <QDirIterator>
+#include <QJsonDocument>
 
 using namespace Qt::StringLiterals;
 
@@ -46,6 +48,12 @@ private Q_SLOTS:
     void loadOffTheRecord();
     void installOffTheRecord();
     void loadInstalledExtensions();
+    void aRegisteredContentScriptIsKeptAcrossARestart();
+    void aScriptNotPersistedAcrossSessionsIsGoneAfterARestart();
