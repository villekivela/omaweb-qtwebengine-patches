@@ -79,6 +87,25 @@ private:
     void uninstallExtensionSync(const QWebEngineExtensionInfo &extension);
     QString resourcesPath();
     QDir extensionsInstallDir();
+    struct ScriptingSession
+    {
+        std::unique_ptr<QWebEngineProfile> profile;
+        std::unique_ptr<QWebEnginePage> page;
+        // The page goes first: a profile deleted under a page that still uses it is not a
+        // restart but a crash.
+        void close()
+        {
+            page.reset();
+            profile.reset();
+        }
+        ~ScriptingSession() { close(); }
+    };
+    void openScriptingSession(ScriptingSession &session, const QString &storagePath,
+                              bool install = false);
+    void openControlPage(ScriptingSession &session, const QWebEngineExtensionInfo &extension);
+    static QWebEngineExtensionInfo keptScriptsExtension(QWebEngineExtensionManager *manager);
+    QString scripting(QWebEnginePage *page, const QString &call);
+    QStringList registeredIds(QWebEnginePage *page);
 
     QWebEnginePage *m_page;
     QWebEngineProfile *m_profile;
@@ -412,6 +439,300 @@ void tst_QWebEngineExtension::loadInstalledExtensions()
     QTRY_COMPARE(manager2->extensions().size(), extensionCount);
 }
 
+// A profile on `storagePath` with the kept-scripts fixture enabled, and the fixture's own page
+// open to call the scripting namespace from. Deleting the session and opening another on the
+// same path is a restart, as far as anything the profile keeps on disk can tell.
+void tst_QWebEngineExtension::openScriptingSession(ScriptingSession &session,
+                                                   const QString &storagePath, bool install)
+{
+    QWebEngineProfileBuilder profileBuilder;
+    profileBuilder.setPersistentStoragePath(storagePath);
+    session.profile.reset(profileBuilder.createProfile("KeptScripts"_L1));
+    QVERIFY(session.profile);
+    QWebEngineExtensionManager *manager = session.profile->extensionManager();
+
+    QSignalSpy spy(manager,
+                   install ? SIGNAL(installFinished(QWebEngineExtensionInfo))
+                           : SIGNAL(loadFinished(QWebEngineExtensionInfo)));
+    if (install)
+        manager->installExtension(resourcesPath() + "kept_scripts_ext"_L1);
+    else
+        manager->loadExtension(resourcesPath() + "kept_scripts_ext"_L1);
+    QTRY_COMPARE(spy.size(), 1);
+    QWebEngineExtensionInfo extension = spy.takeFirst().at(0).value<QWebEngineExtensionInfo>();
+    QVERIFY2(extension.isLoaded(), qPrintable(extension.error()));
+    manager->setExtensionEnabled(extension, true);
+    openControlPage(session, extension);
+}
+
+// The fixture as the manager has it now, or an empty info when it has none.
+QWebEngineExtensionInfo
+tst_QWebEngineExtension::keptScriptsExtension(QWebEngineExtensionManager *manager)
+{
+    for (const QWebEngineExtensionInfo &extension : manager->extensions()) {
+        if (extension.name() == "kept scripts"_L1)
+            return extension;
+    }
+    return QWebEngineExtensionInfo();
+}
+
+// The fixture's own page, opened in the session's profile in place of any it had.
+void tst_QWebEngineExtension::openControlPage(ScriptingSession &session,
+                                              const QWebEngineExtensionInfo &extension)
+{
+    session.page = std::make_unique<QWebEnginePage>(session.profile.get());
+    QSignalSpy loadSpy(session.page.get(), SIGNAL(loadFinished(bool)));
+    session.page->load(QUrl("chrome-extension://"_L1 + extension.id() + "/control.html"_L1));
+    QTRY_COMPARE(loadSpy.size(), 1);
+}
+
+// What a call to the scripting namespace resolved to, as JSON, or the error it failed with.
+QString tst_QWebEngineExtension::scripting(QWebEnginePage *page, const QString &call)
+{
+    evaluateJavaScriptSync(page, "run(() => "_L1 + call + ")"_L1);
+    if (!QTest::qWaitFor([page] {
+            return evaluateJavaScriptSync(page, "window.result !== undefined"_L1).toBool();
+        }))
+        return "timed out"_L1;
+    return evaluateJavaScriptSync(page, "window.result"_L1).toString();
+}
+
+QStringList tst_QWebEngineExtension::registeredIds(QWebEnginePage *page)
+{
+    const QString ids = scripting(
+            page, "chrome.scripting.getRegisteredContentScripts()"
+                  ".then(scripts => scripts.map(script => script.id).sort())"_L1);
+    return QJsonDocument::fromJson(ids.toUtf8()).toVariant().toStringList();
+}
+
+void tst_QWebEngineExtension::aRegisteredContentScriptIsKeptAcrossARestart()
+{
+    // A script registered without saying otherwise persists across sessions, as in Chrome. An
+    // extension that registers once, when it is installed or a setting changes, relies on that:
+    // it never registers again, and without the store its scripts are gone at the next start.
+    HttpServer server;
+    server.setResourceDirs({ resourcesPath() });
+    QVERIFY(server.start());
+    const QString matches = server.url("/*"_L1).toString();
+    QTemporaryDir storage(QDir::tempPath() + "/tst_QWebEngineExtension-XXXXXX"_L1);
+
+    ScriptingSession session;
+    openScriptingSession(session, storage.path());
+    if (QTest::currentTestFailed())
+        return;
+    QCOMPARE(scripting(session.page.get(),
+                       "chrome.scripting.registerContentScripts([{id: 'kept', matches: ['"_L1
+                               + matches
+                               + "'], js: ['marker.js'], runAt: 'document_end', "
+                                 "world: 'MAIN'}])"_L1),
+             "null"_L1);
+    // The store is written on the extension file thread. Waiting for it here keeps the test about
+    // what is kept rather than about how soon.
+    QTRY_VERIFY(QDir(storage.filePath("Extension Scripts"_L1)).exists());
+
+    session.close();
+    openScriptingSession(session, storage.path());
+    if (QTest::currentTestFailed())
+        return;
+    QTRY_COMPARE(registeredIds(session.page.get()), QStringList("kept"_L1));
+    const QVariantMap kept =
+            QJsonDocument::fromJson(
+                    scripting(session.page.get(),
+                              "chrome.scripting.getRegisteredContentScripts()"
+                              ".then(scripts => scripts[0])"_L1)
+                            .toUtf8())
+                    .toVariant()
+                    .toMap();
+    QCOMPARE(kept["matches"_L1].toStringList(), QStringList(matches));
+    QCOMPARE(kept["js"_L1].toStringList(), QStringList("marker.js"_L1));
+    QCOMPARE(kept["runAt"_L1].toString(), "document_end"_L1);
+    QCOMPARE(kept["world"_L1].toString(), "MAIN"_L1);
+    QCOMPARE(kept["persistAcrossSessions"_L1].toBool(), true);
+
+    // And it runs, which is what the reader would miss.
+    QWebEnginePage page(session.profile.get());
+    QSignalSpy loadSpy(&page, SIGNAL(loadFinished(bool)));
+    page.load(server.url("/index.html"_L1));
+    QTRY_COMPARE(loadSpy.size(), 1);
+    QTRY_COMPARE(evaluateJavaScriptSync(&page, "document.documentElement.dataset.kept"_L1),
+                 "yes"_L1);
+}
+
+void tst_QWebEngineExtension::aScriptNotPersistedAcrossSessionsIsGoneAfterARestart()
+{
+    // The witness persists, so once it is back after the restart the store has been read, and
+    // what is missing is missing because it was not kept.
+    QTemporaryDir storage(QDir::tempPath() + "/tst_QWebEngineExtension-XXXXXX"_L1);
+    ScriptingSession session;
+    openScriptingSession(session, storage.path());
+    if (QTest::currentTestFailed())
+        return;
+    QCOMPARE(scripting(session.page.get(),
+                       "chrome.scripting.registerContentScripts(["
+                       "{id: 'witness', matches: ['http://*/*'], js: ['marker.js']},"
+                       "{id: 'session', matches: ['http://*/*'], js: ['marker.js'], "
+                       "persistAcrossSessions: false}])"_L1),
+             "null"_L1);
+    QCOMPARE(registeredIds(session.page.get()), QStringList({ "session"_L1, "witness"_L1 }));
+    QTRY_VERIFY(QDir(storage.filePath("Extension Scripts"_L1)).exists());
+
+    session.close();
+    openScriptingSession(session, storage.path());
+    if (QTest::currentTestFailed())
+        return;
+    QTRY_VERIFY(registeredIds(session.page.get()).contains("witness"_L1));
+    QCOMPARE(registeredIds(session.page.get()), QStringList("witness"_L1));
+}
+
+void tst_QWebEngineExtension::whatIsKeptFollowsUnregisterAndUpdate()
+{
+    // A script unregistered before the restart stays unregistered, and one updated comes back as
+    // it was updated, not as it was first registered.
+    QTemporaryDir storage(QDir::tempPath() + "/tst_QWebEngineExtension-XXXXXX"_L1);
+    ScriptingSession session;
+    openScriptingSession(session, storage.path());
+    if (QTest::currentTestFailed())
+        return;
+    QCOMPARE(scripting(session.page.get(),
+                       "chrome.scripting.registerContentScripts(["
+                       "{id: 'witness', matches: ['http://*/*'], js: ['marker.js']},"
+                       "{id: 'removed', matches: ['http://*/*'], js: ['marker.js']},"
+                       "{id: 'changed', matches: ['http://*/*'], js: ['marker.js']},"
+                       "{id: 'dropped', matches: ['http://*/*'], js: ['marker.js']}])"_L1),
+             "null"_L1);
+    QCOMPARE(scripting(session.page.get(),
+                       "chrome.scripting.updateContentScripts(["
+                       "{id: 'changed', runAt: 'document_start'},"
+                       "{id: 'dropped', persistAcrossSessions: false}])"_L1),
+             "null"_L1);
+    // Last, so no later write of the store can make up for one the unregistering skipped.
+    QCOMPARE(scripting(session.page.get(),
+                       "chrome.scripting.unregisterContentScripts({ids: ['removed']})"_L1),
+             "null"_L1);
+    QCOMPARE(registeredIds(session.page.get()),
+             QStringList({ "changed"_L1, "dropped"_L1, "witness"_L1 }));
+    QTRY_VERIFY(QDir(storage.filePath("Extension Scripts"_L1)).exists());
+
+    session.close();
+    openScriptingSession(session, storage.path());
+    if (QTest::currentTestFailed())
+        return;
+    QTRY_VERIFY(registeredIds(session.page.get()).contains("witness"_L1));
+    QCOMPARE(registeredIds(session.page.get()), QStringList({ "changed"_L1, "witness"_L1 }));
+    QCOMPARE(scripting(session.page.get(),
+                       "chrome.scripting.getRegisteredContentScripts({ids: ['changed']})"
+                       ".then(scripts => scripts[0].runAt)"_L1),
+             "\"document_start\""_L1);
+}
+
+void tst_QWebEngineExtension::anUninstalledExtensionTakesItsKeptScriptsWithIt()
+{
+    // As in Chrome, uninstalling an extension forgets what it registered, so installing it again
+    // starts with nothing. The extension's key gives both installs the same id, which is what
+    // would bring the old scripts back. Installing again starts a new loader, whose first read of
+    // the store finishes before the witness is registered, so the witness alone shows the read.
+    QTemporaryDir storage(QDir::tempPath() + "/tst_QWebEngineExtension-XXXXXX"_L1);
+    ScriptingSession session;
+    openScriptingSession(session, storage.path(), /*install=*/true);
+    if (QTest::currentTestFailed())
+        return;
+    QCOMPARE(scripting(session.page.get(),
+                       "chrome.scripting.registerContentScripts(["
+                       "{id: 'forgotten', matches: ['http://*/*'], js: ['marker.js']}])"_L1),
+             "null"_L1);
+    QTRY_VERIFY(QDir(storage.filePath("Extension Scripts"_L1)).exists());
+
+    QWebEngineExtensionManager *manager = session.profile->extensionManager();
+    const auto installed = [manager] { return keptScriptsExtension(manager); };
+    QSignalSpy uninstallSpy(manager, SIGNAL(uninstallFinished(QWebEngineExtensionInfo)));
+    manager->uninstallExtension(installed());
+    QTRY_COMPARE(uninstallSpy.size(), 1);
+    QVERIFY(installed().name().isEmpty());
+
+    session.page.reset();
+    QSignalSpy installSpy(manager, SIGNAL(installFinished(QWebEngineExtensionInfo)));
+    manager->installExtension(resourcesPath() + "kept_scripts_ext"_L1);
+    QTRY_COMPARE(installSpy.size(), 1);
+    QWebEngineExtensionInfo extension =
+            installSpy.takeFirst().at(0).value<QWebEngineExtensionInfo>();
+    QVERIFY2(extension.isLoaded(), qPrintable(extension.error()));
+    manager->setExtensionEnabled(extension, true);
+    openControlPage(session, extension);
+    if (QTest::currentTestFailed())
+        return;
+
+    QCOMPARE(scripting(session.page.get(),
+                       "chrome.scripting.registerContentScripts(["
+                       "{id: 'witness', matches: ['http://*/*'], js: ['marker.js']}])"_L1),
+             "null"_L1);
+    QCOMPARE(registeredIds(session.page.get()), QStringList("witness"_L1));
+}
