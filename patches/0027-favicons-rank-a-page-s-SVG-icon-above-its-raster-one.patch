+++ b/src/3rdparty/chromium/components/favicon/core/favicon_handler.cc
@@ -16,6 +16,7 @@
 #include "base/memory/ref_counted_memory.h"
 #include "base/metrics/histogram_functions.h"
 #include "base/metrics/histogram_macros.h"
+#include "base/strings/string_util.h"
 #include "build/build_config.h"
 #include "components/favicon/core/core_favicon_service.h"
 #include "components/favicon_base/favicon_util.h"
@@ -24,6 +25,7 @@
 #include "ui/gfx/codec/png_codec.h"
 #include "ui/gfx/image/image_skia.h"
 #include "ui/gfx/image/image_util.h"
+#include "url/url_constants.h"
 
 namespace favicon {
 namespace {
@@ -111,6 +113,18 @@ bool HasAnySize(const std::vector<gfx::Size>& icon_sizes) {
   return std::ranges::any_of(icon_sizes, &gfx::Size::IsZero);
 }
 
+// Returns true if `icon_url` names an SVG. A candidate carries no type from its
+// <link>, so the address decides: a path ending in .svg, or a data: URL of
+// image/svg+xml, whose path is everything after the scheme.
+bool IsSvgUrl(const GURL& icon_url) {
+  if (icon_url.SchemeIs(url::kDataScheme)) {
+    return base::StartsWith(icon_url.path_piece(), "image/svg+xml",
+                            base::CompareCase::INSENSITIVE_ASCII);
+  }
+  return base::EndsWith(icon_url.path_piece(), ".svg",
+                        base::CompareCase::INSENSITIVE_ASCII);
+}
+
 }  // namespace
 
 ////////////////////////////////////////////////////////////////////////////////
@@ -124,6 +138,10 @@ FaviconHandler::FaviconCandidate::FromFaviconURL(
   FaviconCandidate candidate;
   candidate.icon_url = favicon_url.icon_url;
   candidate.icon_type = favicon_url.icon_type;
+  // A small icon is drawn from an SVG at each size it is shown at, and an SVG
+  // that follows the page's colour scheme is drawn under it, which a raster
+  // beside it is not. So a page's SVG icon is tried before its raster ones.
+  candidate.is_vector = !want_largest_icon && IsSvgUrl(favicon_url.icon_url);
 
   if (HasAnySize(favicon_url.icon_sizes)) {
     // For candidates which has the keyword "any" as part of their size
@@ -545,6 +563,14 @@ void FaviconHandler::OnDidDownloadFavicon(
                                           preferred_icon_size(), &score);
     }
 
+    // An SVG is drawn once, at the largest size wanted, and scored as that one
+    // bitmap. It draws as well at every size, so it is ideal, and no raster
+    // after it is downloaded.
+    if (!image_skia.isNull() &&
+        (*final_candidates_)[current_candidate_index_].is_vector) {
+      score = 1.0f;
+    }
+
     if (!image_skia.isNull() && score > best_favicon_.candidate.score) {
       best_favicon_.image = gfx::Image(image_skia);
       best_favicon_.candidate.icon_url = image_url;
diff --git a/src/3rdparty/chromium/components/favicon/core/favicon_handler.h b/src/3rdparty/chromium/components/favicon/core/favicon_handler.h
index 1c3938f33b..fb4ba485a1 100644
--- a/src/3rdparty/chromium/components/favicon/core/favicon_handler.h
+++ b/src/3rdparty/chromium/components/favicon/core/favicon_handler.h
@@ -184,14 +184,21 @@ class FaviconHandler {
         bool want_largest_icon);
 
     // Compare function used for std::stable_sort to sort in descending order.
+    // An SVG candidate comes before every raster one, whatever their scores.
     static bool CompareScore(const FaviconCandidate& lhs,
                              const FaviconCandidate& rhs) {
+      if (lhs.is_vector != rhs.is_vector) {
+        return lhs.is_vector;
+      }
       return lhs.score > rhs.score;
     }
 
     GURL icon_url;
     favicon_base::IconType icon_type = favicon_base::IconType::kInvalid;
     float score = 0;
+    // Whether the icon is an SVG, which draws exactly at any size and can
+    // follow the page's colour scheme. Only a handler for small icons sets it.
+    bool is_vector = false;
   };
 
   struct DownloadedFavicon {
