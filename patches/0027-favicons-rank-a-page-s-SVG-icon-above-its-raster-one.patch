+// Loads `page` from the test's resources with small icons only, and returns
+// the address of the icon the page reports.
+static QUrl iconUrlOf(QWebEnginePage *page, const QString &file)
+{
+    QSignalSpy loadFinishedSpy(page, &QWebEnginePage::loadFinished);
+    QSignalSpy iconUrlChangedSpy(page, &QWebEnginePage::iconUrlChanged);
+    page->settings()->setAttribute(QWebEngineSettings::TouchIconsEnabled, false);
+    page->load(QUrl::fromLocalFile(QDir(QT_TESTCASE_SOURCEDIR).canonicalPath()
+                                   + QLatin1String("/resources/") + file));
+    if (!QTest::qWaitFor([&] { return loadFinishedSpy.size() == 1; }, 30000)
+        || !QTest::qWaitFor([&] { return !page->iconUrl().isEmpty(); }, 10000))
+        return QUrl();
+    // A handler that went on past the first icon reports the next one later.
+    QTest::qWait(500);
+    return page->iconUrl();
+}
+
+// A page offers an ICO for any size, with exact 16 and 32 pixel frames, ahead
+// of an SVG that follows the colour scheme, as chatgpt.com does. Both rank as
+// ideal before they are fetched, and the one drawing of the SVG then scored
+// lower than the ICO's two frames, so the page showed the ICO and its icon
+// could not follow the scheme. The SVG ranks above the raster.
+void tst_Favicon::svgRanksAboveARasterBesideIt()
+{
+    if (!QDir(QDir(QT_TESTCASE_SOURCEDIR).canonicalPath()).exists())
+        QSKIP("This test requires access to its resources on disk");
+
+    const QUrl iconUrl = iconUrlOf(m_page, QStringLiteral("favicon-svg-raster.html"));
+    QCOMPARE(iconUrl,
+             QUrl::fromLocalFile(QDir(QT_TESTCASE_SOURCEDIR).canonicalPath()
+                                 + QLatin1String("/resources/icons/scheme.svg")));
+    QVERIFY(!m_page->icon().isNull());
+}
+
+// The same icons with the SVG declared first. Blink reports a page's icons
+// last first, so the ICO was fetched first and its exact frames left no
+// candidate worth fetching after it: the SVG was never asked for.
+void tst_Favicon::svgRanksAboveARasterDeclaredAfterIt()
+{
+    if (!QDir(QDir(QT_TESTCASE_SOURCEDIR).canonicalPath()).exists())
+        QSKIP("This test requires access to its resources on disk");
+
+    const QUrl iconUrl = iconUrlOf(m_page, QStringLiteral("favicon-svg-first.html"));
+    QCOMPARE(iconUrl,
+             QUrl::fromLocalFile(QDir(QT_TESTCASE_SOURCEDIR).canonicalPath()
+                                 + QLatin1String("/resources/icons/scheme.svg")));
+    QVERIFY(!m_page->icon().isNull());
+}
+
+// An SVG that cannot be fetched leaves the page the raster beside it.
+void tst_Favicon::rasterShownWhenTheSvgFails()
+{
+    if (!QDir(QDir(QT_TESTCASE_SOURCEDIR).canonicalPath()).exists())
+        QSKIP("This test requires access to its resources on disk");
+
+    const QUrl iconUrl = iconUrlOf(m_page, QStringLiteral("favicon-svg-missing.html"));
+    QCOMPARE(iconUrl,
+             QUrl::fromLocalFile(QDir(QT_TESTCASE_SOURCEDIR).canonicalPath()
+                                 + QLatin1String("/resources/icons/qtmulti.ico")));
+    QVERIFY(!m_page->icon().isNull());
+}
+
