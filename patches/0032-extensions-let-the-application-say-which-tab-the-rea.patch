diff --git a/src/core/extensions/extensions_browser_client_qt.cpp b/src/core/extensions/extensions_browser_client_qt.cpp
index 8d1a15f287..74f4f317b1 100644
--- a/src/core/extensions/extensions_browser_client_qt.cpp
+++ b/src/core/extensions/extensions_browser_client_qt.cpp
@@ -387,11 +387,16 @@ std::vector<content::WebContents *> ExtensionsBrowserClientQt::GetTabs(content::
     return tabs;
 }
 
+// The tab the application says the reader selected. Without one, the last page on show, which is
+// a guess whenever two are on show at once, side by side or in two windows.
 content::WebContents *ExtensionsBrowserClientQt::GetActiveTab(content::BrowserContext *context)
 {
-    QtWebEngineCore::ProfileAdapter *adapter = static_cast<QtWebEngineCore::ProfileQt *>(context)->profileAdapter();
+    auto *profile = static_cast<QtWebEngineCore::ProfileQt *>(context);
+    QtWebEngineCore::ProfileAdapter *adapter = profile->profileAdapter();
     if (!adapter)
         return nullptr;
+    QtWebEngineCore::ExtensionManager *manager = profile->extensionManager();
+    const QObject *selected = manager ? manager->selectedPage() : nullptr;
     content::WebContents *active = nullptr;
     for (QtWebEngineCore::WebContentsAdapterClient *client : adapter->webContentsAdapterClients()) {
         QtWebEngineCore::WebContentsAdapter *contents = client->webContentsAdapter();
@@ -400,6 +405,8 @@ content::WebContents *ExtensionsBrowserClientQt::GetActiveTab(content::BrowserCo
             || isExtensionPage(contents->webContents())
             || TabRegistryQt::Get()->IsWindowOfItsOwn(contents->webContents()))
             continue;
+        if (selected && client->holdingQObject() == selected)
+            return contents->webContents();
         if (!active || contents->isVisible())
             active = contents->webContents();
     }
