index db94534136..8176d94f6a 100644
--- a/tests/auto/widgets/extensions/tst_qwebengineextension.cpp
+++ b/tests/auto/widgets/extensions/tst_qwebengineextension.cpp
@@ -94,6 +94,9 @@ private Q_SLOTS:
     void aWindowTheApplicationShowsAsATabJoinsTheBrowsersWindow_data();
     void aWindowTheApplicationShowsAsATabJoinsTheBrowsersWindow();
