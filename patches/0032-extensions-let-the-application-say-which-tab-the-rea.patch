 src/core/api/qwebengineextensionmanager.cpp   |  22 +++
 src/core/api/qwebengineextensionmanager.h     |   1 +
 src/core/extensions/extension_manager.h       |   5 +
 .../extensions_browser_client_qt.cpp          |   9 +-
 .../extensions/tst_qwebengineextension.cpp    | 130 ++++++++++++++++++
 5 files changed, 166 insertions(+), 1 deletion(-)

diff --git a/src/core/api/qwebengineextensionmanager.cpp b/src/core/api/qwebengineextensionmanager.cpp
index 12c7ef42ce..e64e5da9be 100644
--- a/src/core/api/qwebengineextensionmanager.cpp
+++ b/src/core/api/qwebengineextensionmanager.cpp
@@ -229,5 +229,27 @@ void QWebEngineExtensionManager::setPageIsTab(QObject *page)
     d_ptr->setPageIsTab(page);
 }
 
+/*!
+    Tells the extensions that \a page is the tab the reader has selected.
+
+    \a page is a QWebEnginePage, or a WebEngineView in Qt Quick, of this
+    manager's profile. \c chrome.tabs.query reports it as the browser window's
+    active tab, and \c chrome.tabs.get reports it as active, until the
+    application selects another page or the page is deleted.
+
+    Without a selected page, the active tab is the page on show, and the last
+    of them when more than one is, as two pages side by side or in two windows
+    are. An application that shows more than one page at once says which one
+    the reader is using, every time that changes.
+
+    A page that is not one of the browser window's tabs, such as an extension's
+    popup or a window an extension opened, is not reported as active. Pass
+    \nullptr to leave the choice to the pages on show again.
+*/
+void QWebEngineExtensionManager::setSelectedPage(QObject *page)
+{
+    d_ptr->setSelectedPage(page);
+}
+
 QT_END_NAMESPACE
 #endif // QT_CONFIG(webengine_extensions)
