 private:
     int installedFiles();
@@ -2433,5 +2436,132 @@ void tst_QWebEngineExtension::aPageTakenAsATabWhileItOpensIsNeverAWindow()
     QTRY_COMPARE(heardByWorker(&control), removalOf(nextTabId, nextWindowId));
 }
 
+// A page loaded into |view| and titled |title|, which is how an extension tells it apart.
+static void showTitledPage(QWebEngineView *view, QWebEngineProfile *profile, const QUrl &url,
+                           const QString &title)
+{
+    view->setPage(new QWebEnginePage(profile, view));
+    QSignalSpy loadSpy(view, SIGNAL(loadFinished(bool)));
+    view->load(url);
+    view->resize(320, 240);
+    view->show();
+    QTRY_COMPARE(loadSpy.size(), 1);
+    evaluateJavaScriptSync(view->page(), QStringLiteral("document.title = '%1'").arg(title));
+    QTRY_COMPARE(view->page()->title(), title);
+}
+
+// The titles of the tabs |control|'s extension is told are active, asked as a password manager
+// asks for the page its suggestions are for.
+static QStringList activeTitles(QWebEnginePage *control)
+{
+    const QVariantMap answer =
+            askExtension(control, "active"_L1,
+                         "chrome.tabs.query({ active: true, currentWindow: true })"_L1);
+    QStringList titles;
+    for (const QVariant &tab : answer.value("value"_L1).toList())
+        titles.append(tab.toMap()["title"_L1].toString());
+    return titles;
+}
+
+void tst_QWebEngineExtension::theTabTheApplicationSelectedIsActive()
+{
+    // Two pages on show in one profile, as a split or a second window shows them, leave the
+    // engine no way to tell which one the reader is using: Bitwarden asked for the active tab
+    // and suggested a login for the other page. The application says which one it is.
+    HttpServer server;
+    server.setResourceDirs({ resourcesPath() });
+    QVERIFY(server.start());
+    QWebEngineExtensionInfo extension =
+            loadExtensionSync(resourcesPath() + "window_closing_ext"_L1);
+    QVERIFY(extension.isLoaded());
+    m_manager->setExtensionEnabled(extension, true);
+    QWebEnginePage control(m_profile);
+    QSignalSpy controlSpy(&control, SIGNAL(loadFinished(bool)));
+    control.load(QUrl("chrome-extension://"_L1 + extension.id() + "/control.html"_L1));
+    QTRY_COMPARE(controlSpy.size(), 1);
+
+    QWebEngineView first;
+    QWebEngineView second;
+    showTitledPage(&first, m_profile, server.url("/index.html"_L1), "first"_L1);
+    showTitledPage(&second, m_profile, server.url("/index.html"_L1), "second"_L1);
+    QVERIFY(first.page()->isVisible());
+    QVERIFY(second.page()->isVisible());
+
+    m_manager->setSelectedPage(first.page());
+    QCOMPARE(activeTitles(&control), QStringList{ "first"_L1 });
+    m_manager->setSelectedPage(second.page());
+    QCOMPARE(activeTitles(&control), QStringList{ "second"_L1 });
+    m_manager->setSelectedPage(first.page());
+    QCOMPARE(activeTitles(&control), QStringList{ "first"_L1 });
+
+    // Every other tab is reported as not active.
+    const QVariantMap all = askExtension(&control, "all"_L1, "chrome.tabs.query({})"_L1);
+    QMap<QString, bool> active;
+    for (const QVariant &tab : all.value("value"_L1).toList())
+        active.insert(tab.toMap()["title"_L1].toString(), tab.toMap()["active"_L1].toBool());
+    QCOMPARE(active.value("first"_L1), true);
+    QCOMPARE(active.value("second"_L1), false);
+    QCOMPARE(active.values().count(true), 1);
+}
+
+void tst_QWebEngineExtension::withNoTabSelectedThePageOnShowIsActive()
+{
+    // An application that never says, or takes its word back, leaves the answer to the pages on
+    // show. A page the application selects is active even while it is hidden, and an extension
+    // page is never a tab to select.
+    HttpServer server;
+    server.setResourceDirs({ resourcesPath() });
+    QVERIFY(server.start());
+    QWebEngineExtensionInfo extension =
+            loadExtensionSync(resourcesPath() + "window_closing_ext"_L1);
+    QVERIFY(extension.isLoaded());
+    m_manager->setExtensionEnabled(extension, true);
+    QWebEnginePage control(m_profile);
+    QSignalSpy controlSpy(&control, SIGNAL(loadFinished(bool)));
+    control.load(QUrl("chrome-extension://"_L1 + extension.id() + "/control.html"_L1));
+    QTRY_COMPARE(controlSpy.size(), 1);
+
+    QWebEngineView onShow;
+    QWebEngineView hidden;
+    showTitledPage(&hidden, m_profile, server.url("/index.html"_L1), "hidden"_L1);
+    showTitledPage(&onShow, m_profile, server.url("/index.html"_L1), "on show"_L1);
+    hidden.hide();
+    QTRY_VERIFY(!hidden.page()->isVisible());
+
+    QCOMPARE(activeTitles(&control), QStringList{ "on show"_L1 });
+    m_manager->setSelectedPage(hidden.page());
+    QCOMPARE(activeTitles(&control), QStringList{ "hidden"_L1 });
+    m_manager->setSelectedPage(nullptr);
+    QCOMPARE(activeTitles(&control), QStringList{ "on show"_L1 });
+    m_manager->setSelectedPage(&control);
+    QCOMPARE(activeTitles(&control), QStringList{ "on show"_L1 });
+}
+
+void tst_QWebEngineExtension::aSelectedTabThatClosesLeavesThePageOnShowActive()
+{
+    // The application deletes the page the reader selected before it says which one comes next.
+    HttpServer server;
+    server.setResourceDirs({ resourcesPath() });
+    QVERIFY(server.start());
+    QWebEngineExtensionInfo extension =
+            loadExtensionSync(resourcesPath() + "window_closing_ext"_L1);
+    QVERIFY(extension.isLoaded());
+    m_manager->setExtensionEnabled(extension, true);
+    QWebEnginePage control(m_profile);
+    QSignalSpy controlSpy(&control, SIGNAL(loadFinished(bool)));
+    control.load(QUrl("chrome-extension://"_L1 + extension.id() + "/control.html"_L1));
+    QTRY_COMPARE(controlSpy.size(), 1);
+
+    QWebEngineView remaining;
+    auto closing = std::make_unique<QWebEngineView>();
+    showTitledPage(closing.get(), m_profile, server.url("/index.html"_L1), "closing"_L1);
+    showTitledPage(&remaining, m_profile, server.url("/index.html"_L1), "remaining"_L1);
+    m_manager->setSelectedPage(closing->page());
+    QCOMPARE(activeTitles(&control), QStringList{ "closing"_L1 });
+
+    closing.reset();
+    QCOMPARE(activeTitles(&control), QStringList{ "remaining"_L1 });
+}
+
 QTEST_MAIN(tst_QWebEngineExtension)
 #include "tst_qwebengineextension.moc"
