   std::optional<windows::Get::Params> params = windows::Get::Params::Create(args());
   EXTENSION_FUNCTION_VALIDATE(params);
-  if (params->window_id != TabRegistryQt::kWindowId && params->window_id != kWindowIdCurrent)
-    return RespondNow(Error(NoWindowError(params->window_id)));
+  content::WebContents* asking = GetSenderWebContents();
