+// The test asks for something by name and reads the answer, or the error it
+// failed with, from window.answers once it arrives.
+window.answers = {}
+window.ask = (name, call) => {
+    delete window.answers[name]
+    Promise.resolve()
+        .then(call)
+        .then(value => { window.answers[name] = { value: value === undefined ? null : value } },
+              error => { window.answers[name] = { error: error.message } })
+}
