+// The window the call came from, which is a window of its own for a page an extension opened.
 ExtensionFunction::ResponseAction WindowsGetCurrentFunction::Run() {
   std::optional<windows::GetCurrent::Params> params =
       windows::GetCurrent::Params::Create(args());
   EXTENSION_FUNCTION_VALIDATE(params);
-  return RespondNow(WithArguments(
-      CreateWindowValue(browser_context(), GetSenderWebContents(), params->query_options)));
+  return RespondNow(WithArguments(CreateWindowValue(browser_context(), GetSenderWebContents(),
