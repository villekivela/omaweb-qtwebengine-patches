+// A listener that filters windows.onRemoved by type hears about a window of a type it asked for,
+// and one that does not filter hears about every window, as Chrome's WindowsEventRouter tells
+// them. The router sends a copy of the event for each listener's filter, and the renderer matches
+// every copy against every listener, so a copy carrying the window's type for a listener that did
+// not ask for it would reach another listener that did a second time. That copy is not sent.
+bool FilterByWindowType(api::windows::WindowType type,
+                        content::BrowserContext*,
+                        mojom::ContextType,
+                        const Extension*,
+                        const base::Value::Dict* listener_filter,
+                        std::optional<base::Value::List>&,
+                        mojom::EventFilteringInfoPtr& filtering_info) {
+  filtering_info = mojom::EventFilteringInfo::New();
+  const base::Value::List* types =
+      listener_filter ? listener_filter->FindList("windowTypes") : nullptr;
+  if (types) {
+    const std::string name = api::windows::ToString(type);
+    if (!base::Contains(*types, base::Value(name)))
+      return false;
+    filtering_info->window_type = name;
+  } else {
+    filtering_info->has_window_exposed_by_default = true;
+    filtering_info->window_exposed_by_default = true;
+  }
+  return true;
+}
+
 }  // namespace
 
+// A window of its own: the page an extension opened, watched until it closes.
+class TabRegistryQt::OpenedWindow : public content::WebContentsObserver {
+ public:
+  OpenedWindow(content::WebContents* web_contents,
+               int window_id,
+               int tab_id,
+               api::windows::WindowType type)
+      : content::WebContentsObserver(web_contents),
+        context_(web_contents->GetBrowserContext()),
+        window_id_(window_id),
+        tab_id_(tab_id),
+        type_(type) {}
+
+  content::BrowserContext* context() const { return context_; }
+  int window_id() const { return window_id_; }
+  int tab_id() const { return tab_id_; }
+  api::windows::WindowType type() const { return type_; }
+
+  // However the page closes, its WebContents goes, and this is the one place that sees all of
+  // them: the application deleting the page, the page closing itself, and an extension removing
+  // the window or the tab.
+  void WebContentsDestroyed() override { TabRegistryQt::Get()->WindowClosed(window_id_); }
+
+ private:
+  const raw_ptr<content::BrowserContext> context_;
+  const int window_id_;
+  const int tab_id_;
+  const api::windows::WindowType type_;
+};
+
+TabRegistryQt::TabRegistryQt() = default;
+TabRegistryQt::~TabRegistryQt() = default;
