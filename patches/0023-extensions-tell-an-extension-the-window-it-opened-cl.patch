+// A password manager listens in its worker for the window it opened to close,
+// and ends the request it was showing there when it does.
+const heard = []
+chrome.tabs.onRemoved.addListener((tabId, removeInfo) => {
+    heard.push({
+        event: "tabs.onRemoved",
+        tabId,
+        windowId: removeInfo.windowId,
+        isWindowClosing: removeInfo.isWindowClosing,
+    })
+})
+chrome.windows.onRemoved.addListener(windowId => {
+    heard.push({ event: "windows.onRemoved", windowId })
+})
+chrome.runtime.onMessage.addListener((message, sender, sendResponse) => {
+    if (message !== "heard")
+        return false
+    sendResponse(heard)
+    return false
+})
