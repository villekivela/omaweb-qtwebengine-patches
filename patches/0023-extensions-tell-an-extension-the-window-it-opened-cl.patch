+// Asks the extension page |page| to run |call| and waits for the answer: what it resolved with
+// under "value", or the message it failed with under "error".
+static QVariantMap askExtension(QWebEnginePage *page, const QString &name, const QString &call)
+{
+    evaluateJavaScriptSync(page, QStringLiteral("window.ask('%1', () => %2)").arg(name, call));
+    const QString answer = QStringLiteral("window.answers['%1']").arg(name);
+    if (!QTest::qWaitFor([&] {
+            return evaluateJavaScriptSync(page, answer + " !== undefined"_L1).toBool();
+        }))
+        return {};
+    return evaluateJavaScriptSync(page, answer).toMap();
+}
+
+// What the opening extension's worker has heard, in the order it heard it.
+static QString heardByWorker(QWebEnginePage *control)
+{
+    return askExtension(control, "heard"_L1,
+                        "chrome.runtime.sendMessage('heard').then(JSON.stringify)"_L1)
+            .value("value"_L1)
+            .toString();
+}
+
+// The two events Chrome raises when the window holding one tab closes, in its order.
+static QString removalOf(int tabId, int windowId)
+{
+    return QStringLiteral(R"([{"event":"tabs.onRemoved","tabId":%1,"windowId":%2,)"
+                          R"("isWindowClosing":true},{"event":"windows.onRemoved","windowId":%2}])")
+            .arg(tabId)
+            .arg(windowId);
+}
