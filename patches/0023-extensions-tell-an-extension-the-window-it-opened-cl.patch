+  if (IsWindowOfItsOwn(web_contents)) {
+    index = 0;
+    active = true;
+  }
 
   tab.id = GetTabId(web_contents);
   tab.index = index;
   tab.group_id = -1;
-  tab.window_id = kWindowId;
+  tab.window_id = GetWindowId(web_contents);
   tab.selected = active;
   tab.highlighted = active;
   tab.active = active;
