 constexpr int kWindowIdCurrent = -2;
 
-// The one window, placed where the application says the window holding |asking| is. |asking| is
-// the page the call came from, or null when no page is behind it. Chrome always reports the four
-// numbers, and an extension that places a window of its own from them gets NaN without them,
-// which windows.create then refuses.
-windows::Window DescribeWindow(content::BrowserContext* context, content::WebContents* asking) {
+// The window |holding| is in, placed where the application says it is. |holding| is a page of the
+// browser's window, a page an extension opened in a window of its own, or null for the browser's
+// window, which is placed where the window holding |asking| is. |asking| is the page the call came
+// from, or null when no page is behind it. Chrome always reports the four numbers, and an
+// extension that places a window of its own from them gets NaN without them, which
+// windows.create then refuses.
+windows::Window DescribeWindow(content::BrowserContext* context,
+                               content::WebContents* holding,
+                               content::WebContents* asking) {
+  TabRegistryQt* registry = TabRegistryQt::Get();
+  const bool of_its_own = holding && registry->IsWindowOfItsOwn(holding);
   windows::Window window;
-  window.id = TabRegistryQt::kWindowId;
+  window.id = of_its_own ? registry->GetWindowId(holding) : TabRegistryQt::kWindowId;
   window.focused = true;
   window.incognito = context->IsOffTheRecord();
-  window.type = windows::WindowType::kNormal;
+  window.type = of_its_own ? registry->GetWindowType(holding) : windows::WindowType::kNormal;
   window.state = windows::WindowState::kNormal;
   window.always_on_top = false;
-  const gfx::Rect bounds = TabRegistryQt::Get()->GetWindowBounds(context, asking);
+  // A window of its own is wherever the application put its page.
+  const gfx::Rect bounds = registry->GetWindowBounds(context, of_its_own ? holding : asking);
   window.left = bounds.x();
   window.top = bounds.y();
   window.width = bounds.width();
@@ -41,13 +48,15 @@ windows::Window DescribeWindow(content::BrowserContext* context, content::WebCon
 }
 
