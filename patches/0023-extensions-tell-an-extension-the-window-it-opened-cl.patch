diff --git a/src/3rdparty/chromium/qtwebengine/browser/extensions/api/tabs/tabs_api.cc b/src/3rdparty/chromium/qtwebengine/browser/extensions/api/tabs/tabs_api.cc
index bb52d21705..a83648fbd7 100644
--- a/src/3rdparty/chromium/qtwebengine/browser/extensions/api/tabs/tabs_api.cc
+++ b/src/3rdparty/chromium/qtwebengine/browser/extensions/api/tabs/tabs_api.cc
@@ -155,6 +155,10 @@ ExtensionFunction::ResponseAction TabsGetCurrentFunction::Run() {
   if (!contents)
     return RespondNow(NoArguments());
   contents = guest_view::GuestViewBase::GetTopLevelWebContents(contents);
+  // A page an extension opened is the one tab of its window, as a popup window's page is in
+  // Chrome.
+  if (TabRegistryQt::Get()->IsWindowOfItsOwn(contents))
+    return RespondNow(WithArguments(TabRegistryQt::Get()->CreateTabValue(contents)));
   for (content::WebContents* tab : TabRegistryQt::Get()->GetTabs(browser_context())) {
     if (tab == contents)
       return RespondNow(WithArguments(TabRegistryQt::Get()->CreateTabValue(contents)));
@@ -162,16 +166,51 @@ ExtensionFunction::ResponseAction TabsGetCurrentFunction::Run() {
   return RespondNow(NoArguments());
 }
 
+// The tab of a window an extension opened is closed as windows.remove closes the window, since the
+// window holds that one tab. The reader's tabs are the application's to close, so no tab closes
+// unless every tab asked for can.
+ExtensionFunction::ResponseAction TabsRemoveFunction::Run() {
+  std::optional<tabs::Remove::Params> params = tabs::Remove::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  std::vector<int> tab_ids;
+  if (params->tab_ids.as_integer)
+    tab_ids.push_back(*params->tab_ids.as_integer);
+  else if (params->tab_ids.as_integers)
+    tab_ids = *params->tab_ids.as_integers;
+
+  std::vector<content::WebContents*> closing;
+  for (int tab_id : tab_ids) {
+    content::WebContents* contents =
+        TabRegistryQt::Get()->GetWebContents(browser_context(), tab_id);
+    if (!contents)
+      return RespondNow(Error(TabNotFoundError(tab_id)));
+    if (!TabRegistryQt::Get()->IsWindowOfItsOwn(contents))
+      return RespondNow(Error("The application keeps its own tabs open."));
+    if (!base::Contains(closing, contents))
+      closing.push_back(contents);
+  }
+  for (content::WebContents* contents : closing)
+    contents->ClosePage();
+  return RespondNow(NoArguments());
+}
+
 ExtensionFunction::ResponseAction TabsQueryFunction::Run() {
   std::optional<tabs::Query::Params> params = tabs::Query::Params::Create(args());
   EXTENSION_FUNCTION_VALIDATE(params);
   const tabs::Query::Params::QueryInfo& query = params->query_info;
 
-  // Every tab of the context lives in the one window, so currentWindow, lastFocusedWindow and
-  // windowId all select it or nothing.
-  if (query.window_id && *query.window_id != TabRegistryQt::kWindowId &&
-      *query.window_id != -2 /* WINDOW_ID_CURRENT */) {
-    return RespondNow(WithArguments(base::Value::List()));
+  TabRegistryQt* registry = TabRegistryQt::Get();
+  // The window the call came from: a window of its own for a page an extension opened, and the
+  // browser's for any other page or for a worker. The engine does not know which window the
+  // reader last focused, so lastFocusedWindow is the same window, as windows.getLastFocused is.
+  content::WebContents* sender = GetSenderWebContents();
+  const int current_window =
+      sender ? registry->GetWindowId(guest_view::GuestViewBase::GetTopLevelWebContents(sender))
+             : TabRegistryQt::kWindowId;
