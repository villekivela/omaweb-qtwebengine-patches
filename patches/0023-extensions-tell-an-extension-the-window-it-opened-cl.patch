   std::optional<windows::GetLastFocused::Params> params =
       windows::GetLastFocused::Params::Create(args());
   EXTENSION_FUNCTION_VALIDATE(params);
-  return RespondNow(WithArguments(
-      CreateWindowValue(browser_context(), GetSenderWebContents(), params->query_options)));
+  return RespondNow(WithArguments(CreateWindowValue(browser_context(), nullptr,
+                                                    GetSenderWebContents(),
+                                                    params->query_options)));
 }
 
 ExtensionFunction::ResponseAction WindowsGetAllFunction::Run() {
   std::optional<windows::GetAll::Params> params = windows::GetAll::Params::Create(args());
   EXTENSION_FUNCTION_VALIDATE(params);
   base::Value::List result;
-  result.Append(
-      CreateWindowValue(browser_context(), GetSenderWebContents(), params->query_options));
+  result.Append(CreateWindowValue(browser_context(), nullptr, GetSenderWebContents(),
+                                  params->query_options));
+  for (content::WebContents* page :
+       TabRegistryQt::Get()->GetWindowsOfTheirOwn(browser_context())) {
+    result.Append(CreateWindowValue(browser_context(), page, GetSenderWebContents(),
+                                    params->query_options));
+  }
   return RespondNow(WithArguments(std::move(result)));
 }
 
+// A window an extension opened is closed the way its page would close itself: the page's unload
+// handlers run and the application is asked to close it. The browser's own window is the
+// application's to close, not an extension's.
+ExtensionFunction::ResponseAction WindowsRemoveFunction::Run() {
+  std::optional<windows::Remove::Params> params = windows::Remove::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  if (params->window_id == TabRegistryQt::kWindowId)
+    return RespondNow(Error("The application keeps its own window open."));
+  content::WebContents* page =
+      TabRegistryQt::Get()->GetWindowContents(browser_context(), params->window_id);
+  if (!page)
+    return RespondNow(Error(NoWindowError(params->window_id)));
+  page->ClosePage();
+  return RespondNow(NoArguments());
+}
+
 }  // namespace extensions
