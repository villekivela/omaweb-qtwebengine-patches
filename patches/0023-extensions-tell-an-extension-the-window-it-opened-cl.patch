+void TabRegistryQt::OpenWindow(content::WebContents* web_contents,
+                               api::windows::WindowType type) {
+  const int window_id = ++last_window_id_;
+  windows_[window_id] =
+      std::make_unique<OpenedWindow>(web_contents, window_id, GetTabId(web_contents), type);
+}
+
+bool TabRegistryQt::IsWindowOfItsOwn(content::WebContents* web_contents) const {
+  return FindWindow(web_contents) != nullptr;
+}
+
+content::WebContents* TabRegistryQt::GetWindowContents(content::BrowserContext* context,
+                                                       int window_id) const {
+  auto window = windows_.find(window_id);
+  if (window == windows_.end() || window->second->context() != context)
+    return nullptr;
+  return window->second->web_contents();
+}
+
+std::vector<content::WebContents*> TabRegistryQt::GetWindowsOfTheirOwn(
+    content::BrowserContext* context) const {
+  std::vector<content::WebContents*> windows;
+  for (const auto& [window_id, window] : windows_) {
+    if (window->context() == context)
+      windows.push_back(window->web_contents());
+  }
+  return windows;
+}
+
+api::windows::WindowType TabRegistryQt::GetWindowType(content::WebContents* web_contents) const {
+  const OpenedWindow* window = FindWindow(web_contents);
+  return window ? window->type() : api::windows::WindowType::kNormal;
+}
+
+const TabRegistryQt::OpenedWindow* TabRegistryQt::FindWindow(
+    content::WebContents* web_contents) const {
+  for (const auto& [window_id, window] : windows_) {
+    if (window->web_contents() == web_contents)
+      return window.get();
+  }
   return nullptr;
 }
 
+void TabRegistryQt::ForgetContext(content::BrowserContext* context) {
+  std::erase_if(windows_, [context](const auto& entry) {
+    return entry.second->context() == context;
+  });
+}
+
+void TabRegistryQt::WindowClosed(int window_id) {
+  auto window = windows_.find(window_id);
+  if (window == windows_.end())
+    return;
+  content::BrowserContext* context = window->second->context();
+  const int tab_id = window->second->tab_id();
+  const api::windows::WindowType type = window->second->type();
+  // Gone before anyone hears about it, so a listener that asks for the window is told there is
+  // none, as it is in Chrome.
+  windows_.erase(window);
+
+  EventRouter* router = EventRouter::Get(context);
+  if (!router)
+    return;
+  api::tabs::OnRemoved::RemoveInfo remove_info;
+  remove_info.window_id = window_id;
+  remove_info.is_window_closing = true;
+  router->BroadcastEvent(std::make_unique<Event>(
+      events::TABS_ON_REMOVED, api::tabs::OnRemoved::kEventName,
+      api::tabs::OnRemoved::Create(tab_id, remove_info), context));
+  auto removed = std::make_unique<Event>(events::WINDOWS_ON_REMOVED,
+                                         api::windows::OnRemoved::kEventName,
+                                         api::windows::OnRemoved::Create(window_id), context);
+  removed->will_dispatch_callback = base::BindRepeating(&FilterByWindowType, type);
+  router->BroadcastEvent(std::move(removed));
+}
