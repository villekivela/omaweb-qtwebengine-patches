+void tst_QWebEngineExtension::everyWayTheWindowClosesIsReported_data()
+{
+    QTest::addColumn<QString>("how");
+    // The reader closing it is anExtensionIsToldTheWindowItOpenedClosed.
+    QTest::newRow("the page closes itself") << u"window.close"_s;
+    QTest::newRow("the extension removes the window") << u"windows.remove"_s;
+    QTest::newRow("the extension removes the tab") << u"tabs.remove"_s;
+}
+
+void tst_QWebEngineExtension::everyWayTheWindowClosesIsReported()
+{
+    // A page asks the application to close it, and the application does, as Omaweb does when a
+    // Glance, a tab or a window is asked to close. Whoever asked, the extension is told.
+    QFETCH(QString, how);
+    HttpServer server;
+    server.setResourceDirs({ resourcesPath() });
+    QVERIFY(server.start());
+
+    QWebEngineExtensionInfo opener = loadExtensionSync(resourcesPath() + "window_closing_ext"_L1);
+    QVERIFY(opener.isLoaded());
+    m_manager->setExtensionEnabled(opener, true);
+
+    QSignalSpy loadSpy(m_page, SIGNAL(loadFinished(bool)));
+    m_page->load(server.url("/index.html"_L1));
+    QTRY_COMPARE(loadSpy.size(), 1);
+    std::unique_ptr<QWebEnginePage> opened;
+    connect(m_page, &QWebEnginePage::newWindowRequested, this,
+            [&opened, this](QWebEngineNewWindowRequest &request) {
+                opened = std::make_unique<QWebEnginePage>(m_profile);
+                // Later, as an application does: the page is still inside the call that asked.
+                connect(opened.get(), &QWebEnginePage::windowCloseRequested, this, [&opened, this] {
+                    QTimer::singleShot(0, this, [&opened] { opened.reset(); });
+                });
+                request.openIn(opened.get());
+            });
+
+    QWebEnginePage control(m_profile);
+    QSignalSpy controlSpy(&control, SIGNAL(loadFinished(bool)));
+    control.load(QUrl("chrome-extension://"_L1 + opener.id() + "/control.html"_L1));
+    QTRY_COMPARE(controlSpy.size(), 1);
+
+    const QVariantMap created =
+            askExtension(&control, "created"_L1,
+                         "chrome.windows.create({ url: 'blank.html', type: 'popup' })"_L1);
+    QVERIFY2(created.contains("value"_L1), qPrintable(created.value("error"_L1).toString()));
+    const QVariantMap window = created["value"_L1].toMap();
+    const int windowId = window["id"_L1].toInt();
+    const int tabId = window["tabs"_L1].toList().first().toMap()["id"_L1].toInt();
+    QTRY_VERIFY(opened);
+    QTRY_COMPARE(opened->url().path(), "/blank.html"_L1);
+
+    if (how == "window.close"_L1) {
+        evaluateJavaScriptSync(opened.get(), "window.close()"_L1);
+    } else {
+        const QString call = how == "windows.remove"_L1
+                ? QStringLiteral("chrome.windows.remove(%1)").arg(windowId)
+                : QStringLiteral("chrome.tabs.remove(%1)").arg(tabId);
+        const QVariantMap removed = askExtension(&control, "removed"_L1, call);
+        QVERIFY2(!removed.contains("error"_L1), qPrintable(removed.value("error"_L1).toString()));
+    }
+    QTRY_VERIFY(!opened);
+    QTRY_COMPARE(heardByWorker(&control), removalOf(tabId, windowId));
+}
+
 QTEST_MAIN(tst_QWebEngineExtension)
