+void tst_QWebEngineExtension::aWindowClosedWhileTheNextPageOpensIsNotAnswered()
+{
+    // windows.create with several addresses opens them one after another, and the application
+    // runs while each opens. One that closes the first page while the second opens leaves the
+    // call without a window to answer with, and it says so.
+    HttpServer server;
+    server.setResourceDirs({ resourcesPath() });
+    QVERIFY(server.start());
+
+    QWebEngineExtensionInfo opener = loadExtensionSync(resourcesPath() + "window_closing_ext"_L1);
+    QVERIFY(opener.isLoaded());
+    m_manager->setExtensionEnabled(opener, true);
+
+    QSignalSpy loadSpy(m_page, SIGNAL(loadFinished(bool)));
+    m_page->load(server.url("/index.html"_L1));
+    QTRY_COMPARE(loadSpy.size(), 1);
+    std::vector<std::unique_ptr<QWebEnginePage>> opened;
+    connect(m_page, &QWebEnginePage::newWindowRequested, this,
+            [&opened, this](QWebEngineNewWindowRequest &request) {
+                opened.clear();
+                opened.push_back(std::make_unique<QWebEnginePage>(m_profile));
+                request.openIn(opened.back().get());
+            });
+
+    QWebEnginePage control(m_profile);
+    QSignalSpy controlSpy(&control, SIGNAL(loadFinished(bool)));
+    control.load(QUrl("chrome-extension://"_L1 + opener.id() + "/control.html"_L1));
+    QTRY_COMPARE(controlSpy.size(), 1);
+
+    const QVariantMap created = askExtension(
+            &control, "created"_L1,
+            "chrome.windows.create({ url: ['blank.html', 'blank.html?second'] })"_L1);
+    QCOMPARE(created.value("error"_L1).toString(),
+             "The application closed the window it opened."_L1);
+}
