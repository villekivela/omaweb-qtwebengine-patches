diff --git a/src/3rdparty/chromium/qtwebengine/browser/extensions/api/tabs/tabs_api.cc b/src/3rdparty/chromium/qtwebengine/browser/extensions/api/tabs/tabs_api.cc
index bb52d21705..ef83536d25 100644
