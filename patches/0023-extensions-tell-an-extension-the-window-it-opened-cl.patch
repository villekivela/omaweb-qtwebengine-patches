+void tst_QWebEngineExtension::anExtensionIsToldTheWindowItOpenedClosed()
+{
+    // Bitwarden shows a passkey prompt in a window it opens with windows.create, and ends the
+    // request when that window is removed, so the site can fall back. The window gets an id of
+    // its own, and when its page closes, the extension that opened it and any other with the tabs
+    // permission hear tabs.onRemoved for its tab and then windows.onRemoved for it.
+    HttpServer server;
+    server.setResourceDirs({ resourcesPath() });
+    QVERIFY(server.start());
+
+    QWebEngineExtensionInfo opener = loadExtensionSync(resourcesPath() + "window_closing_ext"_L1);
+    QVERIFY(opener.isLoaded());
+    m_manager->setExtensionEnabled(opener, true);
+    QWebEngineExtensionInfo watcher = loadExtensionSync(resourcesPath() + "window_watcher_ext"_L1);
+    QVERIFY(watcher.isLoaded());
+    m_manager->setExtensionEnabled(watcher, true);
+
+    QSignalSpy loadSpy(m_page, SIGNAL(loadFinished(bool)));
+    m_page->load(server.url("/index.html"_L1));
+    QTRY_COMPARE(loadSpy.size(), 1);
+    std::vector<std::unique_ptr<QWebEnginePage>> opened;
+    connect(m_page, &QWebEnginePage::newWindowRequested, this,
+            [&opened, this](QWebEngineNewWindowRequest &request) {
+                opened.push_back(std::make_unique<QWebEnginePage>(m_profile));
+                request.openIn(opened.back().get());
+            });
+
+    QWebEnginePage control(m_profile);
+    QSignalSpy controlSpy(&control, SIGNAL(loadFinished(bool)));
+    control.load(QUrl("chrome-extension://"_L1 + opener.id() + "/control.html"_L1));
+    QTRY_COMPARE(controlSpy.size(), 1);
+    QWebEnginePage watching(m_profile);
+    QSignalSpy watchingSpy(&watching, SIGNAL(loadFinished(bool)));
+    watching.load(QUrl("chrome-extension://"_L1 + watcher.id() + "/watch.html"_L1));
+    QTRY_COMPARE(watchingSpy.size(), 1);
+
+    // A tab the reader opens and closes is not reported.
+    {
+        QWebEnginePage ordinary(m_profile);
+        QSignalSpy ordinarySpy(&ordinary, SIGNAL(loadFinished(bool)));
+        ordinary.load(server.url("/index.html"_L1));
+        QTRY_COMPARE(ordinarySpy.size(), 1);
+    }
+
+    const QVariantMap tab =
+            askExtension(&control, "tab"_L1,
+                         "chrome.tabs.query({}).then(tabs => tabs.find(tab => "
+                         "tab.url.endsWith('/index.html')))"_L1)
+                    .value("value"_L1)
+                    .toMap();
+    QVERIFY(!tab.isEmpty());
+    const int browserWindowId = tab["windowId"_L1].toInt();
+
+    const auto create = [&](const QString &name) {
+        const size_t before = opened.size();
+        const QVariantMap answer = askExtension(
+                &control, name, "chrome.windows.create({ url: 'blank.html', type: 'popup' })"_L1);
+        if (!QTest::qWaitFor([&] {
+                return opened.size() == before + 1
+                        && opened.back()->url().path() == "/blank.html"_L1;
+            }))
+            return QVariantMap();
+        return answer;
+    };
+    const QVariantMap first = create("first"_L1);
+    QVERIFY2(first.contains("value"_L1), qPrintable(first.value("error"_L1).toString()));
+    const QVariantMap window = first["value"_L1].toMap();
+    const int windowId = window["id"_L1].toInt();
+    QVERIFY(windowId != browserWindowId);
+    QCOMPARE(window["tabs"_L1].toList().size(), 1);
+    const int tabId = window["tabs"_L1].toList().first().toMap()["id"_L1].toInt();
+    QCOMPARE(window["tabs"_L1].toList().first().toMap()["windowId"_L1].toInt(), windowId);
+    QCOMPARE(opened.size(), size_t(1));
+
+    // windows.get answers for the window while its page is open, with its one tab.
+    const QVariantMap got = askExtension(
+            &control, "got"_L1,
+            QStringLiteral("chrome.windows.get(%1, { populate: true })").arg(windowId));
+    QVERIFY2(got.contains("value"_L1), qPrintable(got.value("error"_L1).toString()));
+    QCOMPARE(got["value"_L1].toMap()["id"_L1].toInt(), windowId);
+    QCOMPARE(got["value"_L1].toMap()["type"_L1].toString(), "popup"_L1);
+    const QVariantList gotTabs = got["value"_L1].toMap()["tabs"_L1].toList();
+    QCOMPARE(gotTabs.size(), 1);
+    QCOMPARE(gotTabs.first().toMap()["id"_L1].toInt(), tabId);
+
+    // A second window is a window of its own.
+    const QVariantMap second = create("second"_L1);
+    QVERIFY2(second.contains("value"_L1), qPrintable(second.value("error"_L1).toString()));
+    const int secondId = second["value"_L1].toMap()["id"_L1].toInt();
+    QVERIFY(secondId != windowId);
+    QVERIFY(secondId != browserWindowId);
+    QCOMPARE(opened.size(), size_t(2));
+
+    // The reader closes the first.
+    opened.front().reset();
+    QTRY_COMPARE(heardByWorker(&control), removalOf(tabId, windowId));
+    QTRY_COMPARE(evaluateJavaScriptSync(&watching, "JSON.stringify(window.heard)"),
+                 removalOf(tabId, windowId));
+    // The window is a popup, as the extension asked.
+    QCOMPARE(evaluateJavaScriptSync(&watching, "JSON.stringify(window.heardOfPopups)"),
+             QStringLiteral("[%1]").arg(windowId));
+    QCOMPARE(evaluateJavaScriptSync(&watching, "JSON.stringify(window.heardOfNormalWindows)"),
+             "[]"_L1);
+
+    const QVariantMap gone = askExtension(&control, "gone"_L1,
+                                          QStringLiteral("chrome.windows.get(%1)").arg(windowId));
+    QCOMPARE(gone.value("error"_L1).toString(),
+             QStringLiteral("No window with id: %1.").arg(windowId));
+    const QVariantMap still = askExtension(
+            &control, "still"_L1, QStringLiteral("chrome.windows.get(%1)").arg(secondId));
+    QCOMPARE(still["value"_L1].toMap()["id"_L1].toInt(), secondId);
+
+    // The browser's own window and the reader's tabs stay the application's to close.
+    const QVariantMap browserRemoved = askExtension(
+            &control, "browserRemoved"_L1,
+            QStringLiteral("chrome.windows.remove(%1)").arg(browserWindowId));
+    QVERIFY(browserRemoved.contains("error"_L1));
+    const QVariantMap tabRemoved = askExtension(
+            &control, "tabRemoved"_L1,
+            QStringLiteral("chrome.tabs.remove(%1)").arg(tab["id"_L1].toInt()));
+    QVERIFY(tabRemoved.contains("error"_L1));
+    QCOMPARE(m_page->url(), server.url("/index.html"_L1));
+}
