+
+void tst_QWebEngineExtension::anExtensionFindsItsWindowByAddressAndClosesIt()
+{
+    // Bitwarden closes its passkey prompt by finding it with tabs.query by its address and
+    // removing the tab it gets back. The tab is in the window windows.create answered with,
+    // wherever tabs and windows are asked about, and not in the browser's window.
+    QFETCH(QString, path);
+    QFETCH(bool, extensionPage);
+    HttpServer server;
+    server.setResourceDirs({ resourcesPath() });
+    QVERIFY(server.start());
+
+    QWebEngineExtensionInfo opener = loadExtensionSync(resourcesPath() + "window_closing_ext"_L1);
+    QVERIFY(opener.isLoaded());
+    m_manager->setExtensionEnabled(opener, true);
+
+    QSignalSpy loadSpy(m_page, SIGNAL(loadFinished(bool)));
+    m_page->load(server.url("/index.html"_L1));
+    QTRY_COMPARE(loadSpy.size(), 1);
+    std::unique_ptr<QWebEnginePage> opened;
+    connect(m_page, &QWebEnginePage::newWindowRequested, this,
+            [&opened, this](QWebEngineNewWindowRequest &request) {
+                opened = std::make_unique<QWebEnginePage>(m_profile);
+                connect(opened.get(), &QWebEnginePage::windowCloseRequested, this, [&opened, this] {
+                    QTimer::singleShot(0, this, [&opened] { opened.reset(); });
+                });
+                request.openIn(opened.get());
+            });
+
+    QWebEnginePage control(m_profile);
+    QSignalSpy controlSpy(&control, SIGNAL(loadFinished(bool)));
+    control.load(QUrl("chrome-extension://"_L1 + opener.id() + "/control.html"_L1));
+    QTRY_COMPARE(controlSpy.size(), 1);
+
+    const QString address = extensionPage
+            ? "chrome.runtime.getURL('control.html?popout')"_L1
+            : QStringLiteral("'%1'").arg(server.url(path).toString() + "?popout"_L1);
+    const QString pattern = extensionPage
+            ? "chrome.runtime.getURL('control.html') + '?popout*'"_L1
+            : "'*://*/index.html?popout*'"_L1;
+    const QVariantMap created = askExtension(
+            &control, "created"_L1,
+            QStringLiteral("chrome.windows.create({ url: %1, type: 'popup' })").arg(address));
+    QVERIFY2(created.contains("value"_L1), qPrintable(created.value("error"_L1).toString()));
+    const QVariantMap window = created["value"_L1].toMap();
+    const int windowId = window["id"_L1].toInt();
+    const int tabId = window["tabs"_L1].toList().first().toMap()["id"_L1].toInt();
+    QTRY_VERIFY(opened);
+    QTRY_COMPARE(opened->url().path(), path);
+    QTRY_COMPARE(opened->url().query(), "popout"_L1);
+
+    const auto ids = [](const QVariantMap &answer) {
+        QList<int> ids;
+        for (const QVariant &tab : answer.value("value"_L1).toList())
+            ids.append(tab.toMap()["id"_L1].toInt());
+        return ids;
+    };
+    const auto windows = [](const QVariantMap &answer) {
+        QList<int> ids;
+        for (const QVariant &tab : answer.value("value"_L1).toList())
+            ids.append(tab.toMap()["windowId"_L1].toInt());
+        return ids;
+    };
+
+    const QVariantMap found = askExtension(
+            &control, "found"_L1, QStringLiteral("chrome.tabs.query({ url: %1 })").arg(pattern));
+    QCOMPARE(ids(found), QList<int>{ tabId });
+    QCOMPARE(windows(found), QList<int>{ windowId });
+    const QVariantMap inWindow = askExtension(
+            &control, "inWindow"_L1,
+            QStringLiteral("chrome.tabs.query({ windowId: %1 })").arg(windowId));
+    QCOMPARE(ids(inWindow), QList<int>{ tabId });
+
+    // The page on show in the browser's window is still its active tab, and the browser's window
+    // does not hold the new page.
+    const QVariantMap browserActive = askExtension(
+            &control, "browserActive"_L1, "chrome.tabs.query({ active: true, windowId: 1 })"_L1);
+    QCOMPARE(browserActive.value("value"_L1).toList().size(), 1);
+    QCOMPARE(QUrl(browserActive["value"_L1].toList().first().toMap()["url"_L1].toString()),
+             server.url("/index.html"_L1));
+    const QVariantMap browserWindow = askExtension(
+            &control, "browserWindow"_L1, "chrome.tabs.query({ windowId: 1 })"_L1);
+    QVERIFY(!ids(browserWindow).contains(tabId));
+    QVERIFY(!windows(browserWindow).contains(windowId));
+    const QVariantMap populated = askExtension(
+            &control, "populated"_L1, "chrome.windows.get(1, { populate: true })"_L1);
+    QVERIFY(!ids(QVariantMap{ { "value"_L1, populated["value"_L1].toMap()["tabs"_L1] } })
+                     .contains(tabId));
+
+    if (extensionPage) {
+        // Asked from inside, the page's window is its own, whichever way the question is put.
+        QCOMPARE(askExtension(opened.get(), "current"_L1, "chrome.windows.getCurrent()"_L1)
+                         ["value"_L1].toMap()["id"_L1].toInt(),
+                 windowId);
+        QCOMPARE(askExtension(opened.get(), "focused"_L1, "chrome.windows.getLastFocused()"_L1)
+                         ["value"_L1].toMap()["id"_L1].toInt(),
+                 windowId);
+        QCOMPARE(askExtension(opened.get(), "tab"_L1, "chrome.tabs.getCurrent()"_L1)
+                         ["value"_L1].toMap()["id"_L1].toInt(),
+                 tabId);
+        QCOMPARE(ids(askExtension(opened.get(), "here"_L1,
+                                  "chrome.tabs.query({ currentWindow: true })"_L1)),
+                 QList<int>{ tabId });
+        QCOMPARE(ids(askExtension(opened.get(), "lastFocused"_L1,
+                                  "chrome.tabs.query({ lastFocusedWindow: true })"_L1)),
+                 QList<int>{ tabId });
+    }
+
+    const QVariantMap removed = askExtension(
+            &control, "removed"_L1,
+            QStringLiteral("chrome.tabs.query({ url: %1 })"
+                           ".then(tabs => chrome.tabs.remove(tabs.map(tab => tab.id)))")
+                    .arg(pattern));
+    QVERIFY2(!removed.contains("error"_L1), qPrintable(removed.value("error"_L1).toString()));
+    QTRY_VERIFY(!opened);
+    QTRY_COMPARE(heardByWorker(&control), removalOf(tabId, windowId));
+}
