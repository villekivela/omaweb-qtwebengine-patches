+const heard = []
+
+// Each start of the worker is counted where a page can read it without waking
+// the worker, so a test can tell a woken worker from one that kept running.
+chrome.storage.session.get("starts").then(({ starts = 0 }) =>
+    chrome.storage.session.set({ starts: starts + 1 }))
+chrome.tabs.onRemoved.addListener((tabId, removeInfo) => {
+    heard.push({
+        event: "tabs.onRemoved",
+        tabId,
+        windowId: removeInfo.windowId,
+        isWindowClosing: removeInfo.isWindowClosing,
+    })
+})
+chrome.windows.onRemoved.addListener(windowId => {
+    heard.push({ event: "windows.onRemoved", windowId })
+})
+chrome.runtime.onMessage.addListener((message, sender, sendResponse) => {
+    if (message !== "heard")
+        return false
+    sendResponse(heard)
+    return false
+})
