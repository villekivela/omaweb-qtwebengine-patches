+  if (query.window_id) {
+    only_window =
+        *query.window_id == -2 /* WINDOW_ID_CURRENT */ ? current_window : *query.window_id;
   }
 
   std::vector<URLPattern> url_patterns;
@@ -189,45 +228,53 @@ ExtensionFunction::ResponseAction TabsQueryFunction::Run() {
     }
   }
 
-  TabRegistryQt* registry = TabRegistryQt::Get();
   content::WebContents* active_tab = registry->GetActiveTab(browser_context());
   base::Value::List result;
-  int index = -1;
-  for (content::WebContents* tab : registry->GetTabs(browser_context())) {
-    ++index;
-    const bool active = tab == active_tab;
-    if (query.active && *query.active != active)
-      continue;
-    if (query.highlighted && *query.highlighted != active)
-      continue;
-    if (query.pinned && *query.pinned)
-      continue;
-    if (query.audible && *query.audible != tab->IsCurrentlyAudible())
+  for (int window_id : registry->GetWindowIds(browser_context())) {
+    if (only_window && *only_window != window_id)
       continue;
-    if (query.discarded && *query.discarded)
+    if (query.current_window && *query.current_window != (window_id == current_window))
       continue;
-    if (query.frozen && *query.frozen)
+    if (query.last_focused_window && *query.last_focused_window != (window_id == current_window))
       continue;
-    if (query.index && *query.index != index)
-      continue;
-    if (query.status != tabs::TabStatus::kNone) {
-      const bool loading = tab->IsLoading();
-      if ((query.status == tabs::TabStatus::kLoading) != loading)
+    int index = -1;
+    for (content::WebContents* tab : registry->GetTabsInWindow(browser_context(), window_id)) {
+      ++index;
+      // A window of its own holds one tab, and it is that window's active tab.
+      const bool active = window_id != TabRegistryQt::kWindowId || tab == active_tab;
+      if (query.active && *query.active != active)
         continue;
-    }
-    if (query.title &&
-        !base::MatchPattern(base::UTF16ToUTF8(tab->GetTitle()), *query.title)) {
-      continue;
-    }
-    if (!url_patterns.empty()) {
-      const GURL& url = tab->GetLastCommittedURL();
-      bool matched = false;
-      for (const URLPattern& pattern : url_patterns)
-        matched = matched || pattern.MatchesURL(url);
-      if (!matched)
+      if (query.highlighted && *query.highlighted != active)
+        continue;
+      if (query.pinned && *query.pinned)
+        continue;
+      if (query.audible && *query.audible != tab->IsCurrentlyAudible())
+        continue;
+      if (query.discarded && *query.discarded)
+        continue;
+      if (query.frozen && *query.frozen)
+        continue;
+      if (query.index && *query.index != index)
+        continue;
+      if (query.status != tabs::TabStatus::kNone) {
+        const bool loading = tab->IsLoading();
+        if ((query.status == tabs::TabStatus::kLoading) != loading)
+          continue;
+      }
+      if (query.title &&
+          !base::MatchPattern(base::UTF16ToUTF8(tab->GetTitle()), *query.title)) {
         continue;
+      }
+      if (!url_patterns.empty()) {
+        const GURL& url = tab->GetLastCommittedURL();
+        bool matched = false;
+        for (const URLPattern& pattern : url_patterns)
+          matched = matched || pattern.MatchesURL(url);
+        if (!matched)
+          continue;
+      }
+      result.Append(registry->CreateTabValue(tab));
     }
-    result.Append(registry->CreateTabValue(tab));
   }
   return RespondNow(WithArguments(std::move(result)));
 }
