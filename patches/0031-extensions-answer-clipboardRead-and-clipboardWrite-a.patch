     void tabsWindowsAndScripting();
     void nativeMessaging();
@@ -1432,6 +1434,33 @@ void tst_QWebEngineExtension::anOffscreenDocumentCanBeCreated()
     QTRY_COMPARE(m_page->title(), "offscreen ready"_L1);
 }
 
+void tst_QWebEngineExtension::anExtensionUsesTheClipboardItsPermissionsAllow()
+{
+    // Chrome lets an extension that declares clipboardWrite write, and one that declares
+    // clipboardRead read, without a gesture or a question. A password manager copies from a
+    // document that has neither focus nor a click behind it. Blink asks the frame's content
+    // settings client, which answered no for every frame.
+    QSignalSpy webSpy(m_page, SIGNAL(loadFinished(bool)));
+    m_page->load(QUrl("qrc:///resources/index.html"));
+    QTRY_COMPARE(webSpy.size(), 1);
+    QGuiApplication::clipboard()->setText("from the reader"_L1);
+    QCOMPARE(evaluateJavaScriptSync(m_page, "document.execCommand('copy')").toBool(), false);
+    QCOMPARE(evaluateJavaScriptSync(m_page, "document.execCommand('paste')").toBool(), false);
+    QCOMPARE(QGuiApplication::clipboard()->text(), "from the reader"_L1);
+
+    QWebEngineExtensionInfo extension = loadExtensionSync(resourcesPath() + "clipboard_ext"_L1);
+    QVERIFY2(extension.isLoaded(), qPrintable(extension.error()));
+    m_manager->setExtensionEnabled(extension, true);
+    QWebEnginePage page(m_profile);
+    QSignalSpy loadSpy(&page, SIGNAL(loadFinished(bool)));
+    page.load(QUrl("chrome-extension://"_L1 + extension.id() + "/page.html"_L1));
+    QTRY_COMPARE(loadSpy.size(), 1);
+
+    QCOMPARE(evaluateJavaScriptSync(&page, "paste()"), "from the reader"_L1);
+    QCOMPARE(evaluateJavaScriptSync(&page, "copy('from the extension')").toBool(), true);
+    QTRY_COMPARE(QGuiApplication::clipboard()->text(), "from the extension"_L1);
+}
