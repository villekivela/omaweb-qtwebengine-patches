new file mode 100644
index 0000000000..7e33b83de9
--- /dev/null
+++ b/tests/auto/widgets/extensions/resources/clipboard_ext/page.html
@@ -0,0 +1,7 @@
+<!doctype html>
+<html>
+<body>
+<textarea></textarea>
+<script src="page.js"></script>
+</body>
+</html>
diff --git a/tests/auto/widgets/extensions/resources/clipboard_ext/page.js b/tests/auto/widgets/extensions/resources/clipboard_ext/page.js
new file mode 100644
index 0000000000..813639a293
--- /dev/null
+++ b/tests/auto/widgets/extensions/resources/clipboard_ext/page.js
@@ -0,0 +1,12 @@
+// A password manager copies and pastes through a selected text area.
+const area = document.querySelector("textarea");
+function copy(text) {
+    area.value = text;
+    area.select();
+    return document.execCommand("copy");
+}
+function paste() {
+    area.value = "";
+    area.select();
+    return document.execCommand("paste") ? area.value : "refused";
+}
