diff --git a/src/core/renderer/content_settings_observer_qt.cpp b/src/core/renderer/content_settings_observer_qt.cpp
index 67dee40596..b2ea71e90b 100644
--- a/src/core/renderer/content_settings_observer_qt.cpp
+++ b/src/core/renderer/content_settings_observer_qt.cpp
@@ -10,14 +10,35 @@
 #include "content_settings_observer_qt.h"
 
 #include "content/public/renderer/render_frame.h"
+#include "extensions/buildflags/buildflags.h"
 #include "third_party/blink/public/platform/browser_interface_broker_proxy.h"
 #include "third_party/blink/public/platform/web_security_origin.h"
 #include "third_party/blink/public/web/web_document.h"
 #include "third_party/blink/public/web/web_local_frame.h"
 #include "url/origin.h"
 
+#if BUILDFLAG(ENABLE_EXTENSIONS)
+#include "extensions/common/mojom/api_permission_id.mojom-shared.h"
+#include "extensions/common/mojom/context_type.mojom.h"
+#include "extensions/renderer/dispatcher.h"
+#include "extensions/renderer/extensions_renderer_client.h"
+#include "extensions/renderer/script_context.h"
+#include "extensions/renderer/script_context_set.h"
+#endif
+
 namespace {
 
+#if BUILDFLAG(ENABLE_EXTENSIONS)
+// The extension context of the script running now, if any.
+extensions::ScriptContext *currentExtensionContext()
+{
+    auto *client = extensions::ExtensionsRendererClient::Get();
+    if (!client || !client->dispatcher())
+        return nullptr;
+    return client->dispatcher()->script_context_set().GetCurrent();
+}
+#endif
+
 bool IsUniqueFrame(blink::WebFrame *frame)
 {
     return frame->GetSecurityOrigin().IsOpaque() ||
@@ -98,6 +119,37 @@ void ContentSettingsObserverQt::AllowStorageAccess(StorageType storage_type,
             frame->GetDocument().TopFrameOrigin(), std::move(allowStorageCallBack));
 }
 
+// Based on chrome/renderer/chrome_content_settings_agent_delegate.cc. Blink asks
+// before the asynchronous clipboard requests a permission and before
+// document.execCommand reads or writes, so an extension granted here is never
+// asked about, whether or not its document has a view.
+bool ContentSettingsObserverQt::AllowReadFromClipboard()
+{
+#if BUILDFLAG(ENABLE_EXTENSIONS)
+    extensions::ScriptContext *context = currentExtensionContext();
+    return context && context->HasAPIPermission(extensions::mojom::APIPermissionID::kClipboardRead);
+#else
+    return false;
+#endif
+}
+
+bool ContentSettingsObserverQt::AllowWriteToClipboard()
+{
+#if BUILDFLAG(ENABLE_EXTENSIONS)
+    extensions::ScriptContext *context = currentExtensionContext();
+    if (!context)
+        return false;
+    // Every page of an extension's own could write in Chrome before the
+    // permission existed, and still can there, so it can here too.
+    if (context->effective_context_type() == extensions::mojom::ContextType::kPrivilegedExtension
+        && !context->IsForServiceWorker())
+        return true;
+    return context->HasAPIPermission(extensions::mojom::APIPermissionID::kClipboardWrite);
+#else
+    return false;
+#endif
+}
+
 bool ContentSettingsObserverQt::AllowStorageAccessSync(StorageType storage_type)
 {
     blink::WebLocalFrame *frame = render_frame()->GetWebFrame();
