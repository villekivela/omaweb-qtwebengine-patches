diff --git a/tests/auto/widgets/extensions/resources/offscreen_ext/page.js b/tests/auto/widgets/extensions/resources/offscreen_ext/page.js
new file mode 100644
index 0000000000..e7ae8f9602
--- /dev/null
+++ b/tests/auto/widgets/extensions/resources/offscreen_ext/page.js
@@ -0,0 +1,9 @@
+chrome.runtime.onMessage.addListener((message) => {
+    if (message === "offscreen ready")
+        document.title = "offscreen ready";
+});
+chrome.offscreen.createDocument({
+    url: "offscreen.html",
+    reasons: ["CLIPBOARD"],
+    justification: "test"
+}).catch((error) => document.title = "failed: " + error.message);
diff --git a/tests/auto/widgets/extensions/tst_qwebengineextension.cpp b/tests/auto/widgets/extensions/tst_qwebengineextension.cpp
index 28c6a16e3f..52c2a26be3 100644
--- a/tests/auto/widgets/extensions/tst_qwebengineextension.cpp
+++ b/tests/auto/widgets/extensions/tst_qwebengineextension.cpp
@@ -61,6 +61,7 @@ private Q_SLOTS:
     void everyFunctionTheNamespaceDeclaresCanBeCalled();
     void aPageCanLoadAWebAccessibleResource();
     void aResourceWithADynamicUrlIsReachableOnlyUnderIt();
+    void anOffscreenDocumentCanBeCreated();
     void enableAfterStoragePathChange();
     void tabsWindowsAndScripting();
     void nativeMessaging();
@@ -918,6 +919,21 @@ void tst_QWebEngineExtension::aResourceWithADynamicUrlIsReachableOnlyUnderIt()
     QCOMPARE(evaluateJavaScriptSync(m_page, "window.underFixed"), "threw"_L1);
 }
 
+void tst_QWebEngineExtension::anOffscreenDocumentCanBeCreated()
+{
+    // An offscreen document lives in contents the extension system creates itself, so its view
+    // has no delegate. Its first navigation creates a speculative main frame, whose view Chromium
+    // hides, and hiding a view without a delegate took the browser down.
+    QWebEngineExtensionInfo extension = loadExtensionSync(resourcesPath() + "offscreen_ext"_L1);
+    QVERIFY2(extension.isLoaded(), qPrintable(extension.error()));
+    m_manager->setExtensionEnabled(extension, true);
+
+    QSignalSpy loadSpy(m_page, SIGNAL(loadFinished(bool)));
+    m_page->load(QUrl("chrome-extension://"_L1 + extension.id() + "/page.html"_L1));
+    QTRY_COMPARE(loadSpy.size(), 1);
+    QTRY_COMPARE(m_page->title(), "offscreen ready"_L1);
+}
