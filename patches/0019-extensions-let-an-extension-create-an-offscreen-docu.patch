 src/core/render_widget_host_view_qt.cpp          | 11 +++++++----
 .../resources/offscreen_ext/manifest.json        |  8 ++++++++
 .../resources/offscreen_ext/offscreen.html       |  7 +++++++
 .../resources/offscreen_ext/offscreen.js         |  1 +
 .../extensions/resources/offscreen_ext/page.html |  7 +++++++
 .../extensions/resources/offscreen_ext/page.js   |  9 +++++++++
 .../extensions/tst_qwebengineextension.cpp       | 16 ++++++++++++++++
 7 files changed, 55 insertions(+), 4 deletions(-)
 create mode 100644 tests/auto/widgets/extensions/resources/offscreen_ext/manifest.json
 create mode 100644 tests/auto/widgets/extensions/resources/offscreen_ext/offscreen.html
 create mode 100644 tests/auto/widgets/extensions/resources/offscreen_ext/offscreen.js
 create mode 100644 tests/auto/widgets/extensions/resources/offscreen_ext/page.html
 create mode 100644 tests/auto/widgets/extensions/resources/offscreen_ext/page.js

diff --git a/src/core/render_widget_host_view_qt.cpp b/src/core/render_widget_host_view_qt.cpp
index cd50ba693d..1ad92f2dad 100644
--- a/src/core/render_widget_host_view_qt.cpp
+++ b/src/core/render_widget_host_view_qt.cpp
@@ -384,16 +384,19 @@ void RenderWidgetHostViewQt::ShowWithVisibility(content::PageVisibilityState pag
 
 void RenderWidgetHostViewQt::Hide()
 {
-    Q_ASSERT(m_delegate);
     if (isPopup())
         m_isPopupInitializing = false;
-    m_delegate->hide();
+    // A view in contents the extension system created, such as an offscreen document, has no
+    // delegate, and Chromium hides the view of every speculative main frame it creates.
+    if (m_delegate)
+        m_delegate->hide();
+    else
+        m_deferredShow = false;
 }
 
 bool RenderWidgetHostViewQt::IsShowing()
 {
-    Q_ASSERT(m_delegate);
-    return m_delegate->isVisible();
+    return m_delegate && m_delegate->isVisible();
 }
 
 // Retrieve the bounds of the View, in screen coordinates.
