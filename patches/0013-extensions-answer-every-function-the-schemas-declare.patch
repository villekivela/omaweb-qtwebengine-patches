+#ifndef QTWEBENGINE_BROWSER_EXTENSIONS_API_ACTION_ACTION_API_H_
+#define QTWEBENGINE_BROWSER_EXTENSIONS_API_ACTION_ACTION_API_H_
+
+#include "extensions/browser/extension_function.h"
+
+namespace extensions {
+
+// The extension's own button: its title, icon, popup and badge. QtWebEngine draws no button, so
+// these keep what was asked for and answer with it. See ExtensionUiRegistryQt for why they are
+// answered at all rather than left to throw.
+#define QTWEBENGINE_ACTION_FUNCTION(ClassName, name, histogram)      \
+  class ClassName : public ExtensionFunction {                       \
+    ~ClassName() override {}                                         \
+    ResponseAction Run() override;                                   \
+    DECLARE_EXTENSION_FUNCTION(name, histogram)                      \
+  }
+
+QTWEBENGINE_ACTION_FUNCTION(ActionSetTitleFunction, "action.setTitle", ACTION_SETTITLE);
+QTWEBENGINE_ACTION_FUNCTION(ActionGetTitleFunction, "action.getTitle", ACTION_GETTITLE);
+QTWEBENGINE_ACTION_FUNCTION(ActionSetIconFunction, "action.setIcon", ACTION_SETICON);
+QTWEBENGINE_ACTION_FUNCTION(ActionSetPopupFunction, "action.setPopup", ACTION_SETPOPUP);
+QTWEBENGINE_ACTION_FUNCTION(ActionGetPopupFunction, "action.getPopup", ACTION_GETPOPUP);
+QTWEBENGINE_ACTION_FUNCTION(ActionSetBadgeTextFunction, "action.setBadgeText", ACTION_SETBADGETEXT);
+QTWEBENGINE_ACTION_FUNCTION(ActionGetBadgeTextFunction, "action.getBadgeText", ACTION_GETBADGETEXT);
+QTWEBENGINE_ACTION_FUNCTION(ActionSetBadgeBackgroundColorFunction, "action.setBadgeBackgroundColor",
+                            ACTION_SETBADGEBACKGROUNDCOLOR);
+QTWEBENGINE_ACTION_FUNCTION(ActionGetBadgeBackgroundColorFunction, "action.getBadgeBackgroundColor",
+                            ACTION_GETBADGEBACKGROUNDCOLOR);
+QTWEBENGINE_ACTION_FUNCTION(ActionSetBadgeTextColorFunction, "action.setBadgeTextColor",
+                            ACTION_SETBADGETEXTCOLOR);
+QTWEBENGINE_ACTION_FUNCTION(ActionGetBadgeTextColorFunction, "action.getBadgeTextColor",
+                            ACTION_GETBADGETEXTCOLOR);
+QTWEBENGINE_ACTION_FUNCTION(ActionEnableFunction, "action.enable", ACTION_ENABLE);
+QTWEBENGINE_ACTION_FUNCTION(ActionDisableFunction, "action.disable", ACTION_DISABLE);
+QTWEBENGINE_ACTION_FUNCTION(ActionIsEnabledFunction, "action.isEnabled", ACTION_ISENABLED);
+QTWEBENGINE_ACTION_FUNCTION(ActionGetUserSettingsFunction, "action.getUserSettings",
+                            ACTION_GETUSERSETTINGS);
+QTWEBENGINE_ACTION_FUNCTION(ActionOpenPopupFunction, "action.openPopup", ACTION_OPENPOPUP);
+
+#undef QTWEBENGINE_ACTION_FUNCTION
+
+}  // namespace extensions
+
+#endif  // QTWEBENGINE_BROWSER_EXTENSIONS_API_ACTION_ACTION_API_H_
diff --git a/src/3rdparty/chromium/qtwebengine/browser/extensions/api/commands/commands_api.cc b/src/3rdparty/chromium/qtwebengine/browser/extensions/api/commands/commands_api.cc
new file mode 100644
index 0000000000..7f49f2223f
--- /dev/null
+++ b/src/3rdparty/chromium/qtwebengine/browser/extensions/api/commands/commands_api.cc
@@ -0,0 +1,30 @@
+// Copyright (C) 2026 The Qt Company Ltd.
+// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only
+
+#include "qtwebengine/browser/extensions/api/commands/commands_api.h"
+
+#include "extensions/common/extension.h"
+#include "extensions/common/manifest.h"
+
+namespace extensions {
+
+ExtensionFunction::ResponseAction CommandsGetAllFunction::Run() {
+  base::Value::List commands;
+  const base::Value::Dict* declared = extension()->manifest()->available_values().FindDict(
+      "commands");
+  if (declared) {
+    for (const auto [name, properties] : *declared) {
+      base::Value::Dict command;
+      command.Set("name", name);
+      const std::string* description =
+          properties.is_dict() ? properties.GetDict().FindString("description") : nullptr;
+      command.Set("description", description ? *description : std::string());
+      // No shortcut: nothing in the application has bound one.
+      command.Set("shortcut", std::string());
+      commands.Append(std::move(command));
+    }
+  }
+  return RespondNow(WithArguments(std::move(commands)));
+}
+
+}  // namespace extensions
