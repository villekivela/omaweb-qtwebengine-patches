+void tst_QWebEngineExtension::everyFunctionTheNamespaceDeclaresCanBeCalled()
+{
+    // A function a namespace declares but nothing registers is not inert: the dispatcher refuses
+    // it as an unknown API and the call throws where the extension made it. An extension reads the
+    // namespace, sees the function and calls it, so anything declared has to answer, even if the
+    // answer is that there is nothing to report.
+    QWebEngineExtensionInfo extension =
+            loadExtensionSync(resourcesPath() + "notifications_ext"_L1);
+    QVERIFY2(extension.isLoaded(), qPrintable(extension.error()));
+    m_manager->setExtensionEnabled(extension, true);
+
+    QWebEnginePage popup(m_profile);
+    QSignalSpy popupSpy(&popup, SIGNAL(loadFinished(bool)));
+    popup.load(extension.actionPopupUrl());
+    QTRY_COMPARE(popupSpy.size(), 1);
+
+    // Everything a password manager reaches for while it is starting up, in one pass. Each call is
+    // recorded as its answer or as the message it threw, so a failure names the function.
+    evaluateJavaScriptSync(&popup, R"((async () => {
+        const answers = {};
+        const ask = async (name, call) => {
+            try {
+                answers[name] = await call();
+            } catch (error) {
+                answers[name] = "threw: " + error.message;
+            }
+        };
+        await ask("level", () => chrome.notifications.getPermissionLevel());
+        await ask("commands", async () =>
+            (await chrome.commands.getAll()).map(c => c.name).join(","));
+        await ask("setPopup", () => chrome.action.setPopup({ popup: "popup_page.html" }));
+        await ask("getPopup", () => chrome.action.getPopup({}));
+        await ask("setBadgeText", () => chrome.action.setBadgeText({ text: "7" }));
+        await ask("getBadgeText", () => chrome.action.getBadgeText({}));
+        await ask("setBadgeBackgroundColor",
+                  () => chrome.action.setBadgeBackgroundColor({ color: "#112233" }));
+        await ask("setTitle", () => chrome.action.setTitle({ title: "Vault" }));
+        await ask("getTitle", () => chrome.action.getTitle({}));
+        await ask("setIcon", () => chrome.action.setIcon({ path: "icon.png" }));
