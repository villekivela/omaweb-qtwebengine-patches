diff --git a/src/3rdparty/chromium/qtwebengine/browser/extensions/api/action/action_api.cc b/src/3rdparty/chromium/qtwebengine/browser/extensions/api/action/action_api.cc
new file mode 100644
index 0000000000..966a4a5849
--- /dev/null
+++ b/src/3rdparty/chromium/qtwebengine/browser/extensions/api/action/action_api.cc
@@ -0,0 +1,152 @@
+// Copyright (C) 2026 The Qt Company Ltd.
+// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only
+
+#include "qtwebengine/browser/extensions/api/action/action_api.h"
+
+#include "extensions/common/api/extension_action/action_info.h"
+#include "extensions/common/extension.h"
+#include "qtwebengine/browser/extensions/extension_ui_registry_qt.h"
+
+namespace extensions {
+
+namespace {
+
+// Every action function takes one details object, and the only field that changes which state is
+// read or written is `tabId`. The schema is not compiled, here or in Chrome, so the details are
+// read as the values they arrive as.
+const base::Value::Dict* Details(const base::Value::List& args) {
+  return args.empty() || !args.front().is_dict() ? nullptr : &args.front().GetDict();
+}
+
+int TabIdFrom(const base::Value::List& args) {
+  const base::Value::Dict* details = Details(args);
+  const std::optional<int> tab_id = details ? details->FindInt("tabId") : std::nullopt;
+  return tab_id.value_or(ExtensionUiRegistryQt::kEveryTab);
+}
+
+std::string StringFrom(const base::Value::List& args, const char* field) {
+  const base::Value::Dict* details = Details(args);
+  const std::string* value = details ? details->FindString(field) : nullptr;
+  return value ? *value : std::string();
+}
+
+ActionStateQt& StateFor(ExtensionFunction* function, const base::Value::List& args) {
+  return ExtensionUiRegistryQt::Get()->MutableAction(function->browser_context(),
+                                                     function->extension()->id(),
+                                                     TabIdFrom(args));
+}
+
+const ActionStateQt& ReadStateFor(ExtensionFunction* function, const base::Value::List& args) {
+  return ExtensionUiRegistryQt::Get()->Action(function->browser_context(),
+                                              function->extension()->id(), TabIdFrom(args));
+}
+
+}  // namespace
+
+ExtensionFunction::ResponseAction ActionSetTitleFunction::Run() {
+  StateFor(this, args()).title = StringFrom(args(), "title");
+  return RespondNow(NoArguments());
+}
+
+ExtensionFunction::ResponseAction ActionGetTitleFunction::Run() {
+  const std::string& title = ReadStateFor(this, args()).title;
+  // An extension that has set no title is told the one a reader would see, which is its name.
+  return RespondNow(WithArguments(title.empty() ? extension()->name() : title));
+}
+
+ExtensionFunction::ResponseAction ActionSetIconFunction::Run() {
+  // The icon arrives as a path, a set of paths by size, or decoded image data. What is kept is
+  // whichever the extension gave, unread: nothing draws it yet, and re-encoding what was never
+  // shown would be work in aid of nothing.
+  StateFor(this, args()).icon = StringFrom(args(), "path");
+  return RespondNow(NoArguments());
+}
+
+ExtensionFunction::ResponseAction ActionSetPopupFunction::Run() {
+  const std::string popup = StringFrom(args(), "popup");
+  // Resolved against the extension, because that is the form the extension is answered with and
+  // the form anything opening it would need.
+  StateFor(this, args()).popup = popup.empty() ? std::string() : extension()->GetResourceURL(popup).spec();
+  return RespondNow(NoArguments());
+}
+
+ExtensionFunction::ResponseAction ActionGetPopupFunction::Run() {
+  const ActionStateQt& state = ReadStateFor(this, args());
+  if (!state.popup.empty()) {
+    return RespondNow(WithArguments(state.popup));
+  }
+  // The manifest's popup, which is what the reader would be shown if nothing had set one.
+  const ActionInfo* info = ActionInfo::GetExtensionActionInfo(extension());
+  return RespondNow(
+      WithArguments(info && !info->default_popup_url.is_empty() ? info->default_popup_url.spec()
+                                                               : std::string()));
+}
+
+ExtensionFunction::ResponseAction ActionSetBadgeTextFunction::Run() {
+  StateFor(this, args()).badge_text = StringFrom(args(), "text");
+  return RespondNow(NoArguments());
+}
+
+ExtensionFunction::ResponseAction ActionGetBadgeTextFunction::Run() {
+  return RespondNow(WithArguments(ReadStateFor(this, args()).badge_text));
+}
+
+ExtensionFunction::ResponseAction ActionSetBadgeBackgroundColorFunction::Run() {
+  StateFor(this, args()).badge_background_color = StringFrom(args(), "color");
+  return RespondNow(NoArguments());
+}
+
+ExtensionFunction::ResponseAction ActionGetBadgeBackgroundColorFunction::Run() {
+  // Chrome answers a colour as four numbers. An extension that never set one is told the
+  // transparent it would be drawn with.
+  const std::string& colour = ReadStateFor(this, args()).badge_background_color;
+  base::Value::List rgba;
+  for (int index = 0; index < 4; ++index) {
+    rgba.Append(0);
+  }
+  return RespondNow(colour.empty() ? WithArguments(std::move(rgba)) : WithArguments(colour));
+}
+
+ExtensionFunction::ResponseAction ActionSetBadgeTextColorFunction::Run() {
+  StateFor(this, args()).badge_text_color = StringFrom(args(), "color");
+  return RespondNow(NoArguments());
+}
+
+ExtensionFunction::ResponseAction ActionGetBadgeTextColorFunction::Run() {
+  const std::string& colour = ReadStateFor(this, args()).badge_text_color;
+  base::Value::List rgba;
+  for (int index = 0; index < 4; ++index) {
+    rgba.Append(0);
+  }
+  return RespondNow(colour.empty() ? WithArguments(std::move(rgba)) : WithArguments(colour));
+}
+
+ExtensionFunction::ResponseAction ActionEnableFunction::Run() {
+  StateFor(this, args()).enabled = true;
+  return RespondNow(NoArguments());
+}
+
+ExtensionFunction::ResponseAction ActionDisableFunction::Run() {
+  StateFor(this, args()).enabled = false;
+  return RespondNow(NoArguments());
+}
+
+ExtensionFunction::ResponseAction ActionIsEnabledFunction::Run() {
+  return RespondNow(WithArguments(ReadStateFor(this, args()).enabled));
+}
+
+ExtensionFunction::ResponseAction ActionGetUserSettingsFunction::Run() {
+  base::Value::Dict settings;
+  // There is no toolbar to have pinned it to.
+  settings.Set("isOnToolbar", false);
+  return RespondNow(WithArguments(std::move(settings)));
+}
+
+ExtensionFunction::ResponseAction ActionOpenPopupFunction::Run() {
+  // Opening the popup is the application's to do and it has not been asked for one. This is a
+  // refusal the extension can read, not an unknown API: Chrome refuses this too, whenever there is
+  // no window to open it in.
+  return RespondNow(Error("The application did not open the extension's popup."));
+}
+
+}  // namespace extensions
