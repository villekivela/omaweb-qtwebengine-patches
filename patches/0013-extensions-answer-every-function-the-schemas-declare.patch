diff --git a/src/3rdparty/chromium/qtwebengine/browser/extensions/api/context_menus/context_menus_api.cc b/src/3rdparty/chromium/qtwebengine/browser/extensions/api/context_menus/context_menus_api.cc
new file mode 100644
index 0000000000..293013b138
--- /dev/null
+++ b/src/3rdparty/chromium/qtwebengine/browser/extensions/api/context_menus/context_menus_api.cc
@@ -0,0 +1,108 @@
+// Copyright (C) 2026 The Qt Company Ltd.
+// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only
+
+#include "qtwebengine/browser/extensions/api/context_menus/context_menus_api.h"
+
+#include <algorithm>
+
+#include "base/strings/string_number_conversions.h"
+#include "extensions/common/extension.h"
+#include "qtwebengine/browser/extensions/extension_ui_registry_qt.h"
+
+namespace extensions {
+
+namespace {
+
+// An id is a string or a number, and an extension that gave neither gets one.
+std::string IdFrom(const base::Value& value) {
+  if (value.is_string()) {
+    return value.GetString();
+  }
+  if (value.is_int()) {
+    return base::NumberToString(value.GetInt());
+  }
+  return std::string();
+}
+
+std::string IdOfArgument(const base::Value::List& args, size_t at) {
+  return args.size() > at ? IdFrom(args[at]) : std::string();
+}
+
+}  // namespace
+
+ExtensionFunction::ResponseAction ContextMenusCreateFunction::Run() {
+  if (args().empty() || !args().front().is_dict()) {
+    return RespondNow(Error("A menu item needs its properties."));
+  }
+  const base::Value::Dict& properties = args().front().GetDict();
+
+  ContextMenuItemQt item;
+  if (const base::Value* id = properties.Find("id")) {
+    item.id = IdFrom(*id);
+  }
+  if (item.id.empty()) {
+    static int next = 0;
+    item.id = "qtwebengine-" + base::NumberToString(++next);
+  }
+  if (const std::string* title = properties.FindString("title")) {
+    item.title = *title;
+  }
+  if (const base::Value* parent = properties.Find("parentId")) {
+    item.parent_id = IdFrom(*parent);
+  }
+  item.enabled = properties.FindBool("enabled").value_or(true);
+  item.visible = properties.FindBool("visible").value_or(true);
+
+  std::vector<ContextMenuItemQt>& menu =
+      ExtensionUiRegistryQt::Get()->Menu(browser_context(), extension()->id());
+  auto existing = std::find_if(menu.begin(), menu.end(),
+                               [&item](const ContextMenuItemQt& in) { return in.id == item.id; });
+  if (existing != menu.end()) {
+    return RespondNow(Error("Cannot create item with duplicate id " + item.id));
+  }
+  menu.push_back(std::move(item));
+  return RespondNow(NoArguments());
+}
+
+ExtensionFunction::ResponseAction ContextMenusUpdateFunction::Run() {
+  const std::string id = IdOfArgument(args(), 0);
+  std::vector<ContextMenuItemQt>& menu =
+      ExtensionUiRegistryQt::Get()->Menu(browser_context(), extension()->id());
+  auto item = std::find_if(menu.begin(), menu.end(),
+                           [&id](const ContextMenuItemQt& in) { return in.id == id; });
+  if (item == menu.end()) {
+    return RespondNow(Error("Cannot find menu item with id " + id));
+  }
+  if (args().size() > 1 && args()[1].is_dict()) {
+    const base::Value::Dict& properties = args()[1].GetDict();
+    if (const std::string* title = properties.FindString("title")) {
+      item->title = *title;
+    }
+    if (std::optional<bool> enabled = properties.FindBool("enabled")) {
+      item->enabled = *enabled;
+    }
+    if (std::optional<bool> visible = properties.FindBool("visible")) {
+      item->visible = *visible;
+    }
+  }
+  return RespondNow(NoArguments());
+}
+
+ExtensionFunction::ResponseAction ContextMenusRemoveFunction::Run() {
+  const std::string id = IdOfArgument(args(), 0);
+  std::vector<ContextMenuItemQt>& menu =
+      ExtensionUiRegistryQt::Get()->Menu(browser_context(), extension()->id());
+  const size_t before = menu.size();
+  std::erase_if(menu, [&id](const ContextMenuItemQt& in) { return in.id == id; });
+  if (menu.size() == before) {
+    return RespondNow(Error("Cannot find menu item with id " + id));
+  }
+  return RespondNow(NoArguments());
+}
+
+ExtensionFunction::ResponseAction ContextMenusRemoveAllFunction::Run() {
+  ExtensionUiRegistryQt::Get()->Menu(browser_context(), extension()->id()).clear();
+  return RespondNow(NoArguments());
+}
+
+}  // namespace extensions
