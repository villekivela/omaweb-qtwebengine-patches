index 0000000000..8bb9a0fd2b
--- /dev/null
+++ b/src/3rdparty/chromium/qtwebengine/browser/extensions/extension_ui_registry_qt.cc
@@ -0,0 +1,58 @@
+// Copyright (C) 2026 The Qt Company Ltd.
+// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only
+
+#include "qtwebengine/browser/extensions/extension_ui_registry_qt.h"
+
+#include <tuple>
+
+#include "base/no_destructor.h"
+
+namespace extensions {
+
+// static
+ExtensionUiRegistryQt* ExtensionUiRegistryQt::Get() {
+  static base::NoDestructor<ExtensionUiRegistryQt> registry;
+  return registry.get();
+}
+
+const ActionStateQt& ExtensionUiRegistryQt::Action(content::BrowserContext* context,
+                                                   const ExtensionId& extension_id,
+                                                   int tab_id) const {
+  auto state = actions_.find(Key{context, extension_id, tab_id});
+  if (state == actions_.end() && tab_id != kEveryTab) {
+    state = actions_.find(Key{context, extension_id, kEveryTab});
+  }
+  if (state != actions_.end()) {
+    return state->second;
+  }
+  static const base::NoDestructor<ActionStateQt> unset;
+  return *unset;
+}
+
+ActionStateQt& ExtensionUiRegistryQt::MutableAction(content::BrowserContext* context,
+                                                    const ExtensionId& extension_id, int tab_id) {
+  const Key key{context, extension_id, tab_id};
+  auto state = actions_.find(key);
+  if (state != actions_.end()) {
+    return state->second;
+  }
+  // A tab that has never been written to starts from what the extension set for every tab, so
+  // setting a badge for one tab does not silently clear the title it set for all of them.
+  return actions_[key] = Action(context, extension_id, kEveryTab);
+}
+
+std::vector<ContextMenuItemQt>& ExtensionUiRegistryQt::Menu(content::BrowserContext* context,
+                                                            const ExtensionId& extension_id) {
+  return menus_[Key{context, extension_id, kEveryTab}];
+}
+
+void ExtensionUiRegistryQt::ForgetContext(content::BrowserContext* context) {
+  for (auto it = actions_.begin(); it != actions_.end();) {
+    it = it->first.context == context ? actions_.erase(it) : std::next(it);
+  }
+  for (auto it = menus_.begin(); it != menus_.end();) {
+    it = it->first.context == context ? menus_.erase(it) : std::next(it);
+  }
+}
+
+}  // namespace extensions
diff --git a/src/3rdparty/chromium/qtwebengine/browser/extensions/extension_ui_registry_qt.h b/src/3rdparty/chromium/qtwebengine/browser/extensions/extension_ui_registry_qt.h
new file mode 100644
index 0000000000..cd3c2f7fe1
--- /dev/null
+++ b/src/3rdparty/chromium/qtwebengine/browser/extensions/extension_ui_registry_qt.h
@@ -0,0 +1,82 @@
+// Copyright (C) 2026 The Qt Company Ltd.
+// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only
+
+#ifndef QTWEBENGINE_BROWSER_EXTENSIONS_EXTENSION_UI_REGISTRY_QT_H_
+#define QTWEBENGINE_BROWSER_EXTENSIONS_EXTENSION_UI_REGISTRY_QT_H_
+
+#include <map>
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "extensions/common/extension_id.h"
+
+namespace content {
+class BrowserContext;
+}
+
+namespace extensions {
+
+// What an extension asks the browser's own chrome to show: its action's title, icon, popup and
+// badge, and the items it wants in a context menu.
+//
+// QtWebEngine has no chrome to draw them in. What it must not do is refuse the calls: a function a
+// schema declares and nothing registers is reported as an unknown API and throws where the
+// extension made the call, and a password manager sets a badge and builds a menu on its first
+// pass, before it has done anything a reader asked for. So what is asked for is kept and answered
+// truthfully, and an application that wants to draw any of it reads it here.
+struct ActionStateQt {
+  std::string title;
+  std::string icon;
+  std::string popup;
+  std::string badge_text;
+  std::string badge_background_color;
+  std::string badge_text_color;
+  bool enabled = true;
+};
+
+struct ContextMenuItemQt {
+  std::string id;
+  std::string title;
+  std::string parent_id;
+  bool enabled = true;
+  bool visible = true;
+};
+
+class ExtensionUiRegistryQt {
+ public:
+  static ExtensionUiRegistryQt* Get();
+
+  // An extension's action state for |tab_id|, falling back to the one it set for every tab.
+  // kEveryTab is what a call that named no tab means.
+  static constexpr int kEveryTab = 0;
+  const ActionStateQt& Action(content::BrowserContext* context, const ExtensionId& extension_id,
+                              int tab_id) const;
+  // The state to write into. A call that names a tab starts from what every tab has.
+  ActionStateQt& MutableAction(content::BrowserContext* context, const ExtensionId& extension_id,
+                               int tab_id);
+
+  std::vector<ContextMenuItemQt>& Menu(content::BrowserContext* context,
+                                       const ExtensionId& extension_id);
+
+  void ForgetContext(content::BrowserContext* context);
+
+ private:
+  struct Key {
+    raw_ptr<content::BrowserContext> context;
+    ExtensionId extension_id;
+    int tab_id = kEveryTab;
+
+    bool operator<(const Key& other) const {
+      return std::tie(context, extension_id, tab_id) <
+             std::tie(other.context, other.extension_id, other.tab_id);
+    }
+  };
+
+  std::map<Key, ActionStateQt> actions_;
+  std::map<Key, std::vector<ContextMenuItemQt>> menus_;
+};
+
+}  // namespace extensions
+
+#endif  // QTWEBENGINE_BROWSER_EXTENSIONS_EXTENSION_UI_REGISTRY_QT_H_
