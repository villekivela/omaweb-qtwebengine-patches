+void tst_QWebEnginePage::pushSubscribeAnswersAlikeOffTheRecord_data()
+{
+    QTest::addColumn<bool>("offTheRecord");
+    QTest::newRow("off the record") << true;
+    QTest::newRow("on the record") << false;
+}
+
+// The engine has no push service unless the application switches one on. An
+// on-the-record profile then rejects PushManager.subscribe() at once, and an
+// off-the-record one used to ask the application for the notifications
+// permission first, to hide the missing service from a site, and reject only
+// after the answer. Nothing was ever subscribed, so the question led nowhere,
+// and a site could tell the two profiles apart by it.
+void tst_QWebEnginePage::pushSubscribeAnswersAlikeOffTheRecord()
+{
+    QFETCH(bool, offTheRecord);
+    HttpServer server;
+    connect(&server, &HttpServer::newRequest, &server, [&](HttpReqRep *r) {
+        if (r->requestPath() == "/worker.js") {
+            r->setResponseHeader("Content-Type", "text/javascript");
+            r->setResponseBody("");
+            r->sendResponse();
+        } else if (r->requestPath() == "/") {
+            r->setResponseHeader("Content-Type", "text/html");
+            r->setResponseBody("<html><body></body></html>");
+            r->sendResponse();
+        }
+    });
+    QVERIFY(server.start());
+
+    QWebEngineProfile profile(offTheRecord ? QString() : QStringLiteral("pushSubscribe"));
+    QWebEnginePage page(&profile);
+    int asked = 0;
+    connect(&page, &QWebEnginePage::permissionRequested, &page, [&](QWebEnginePermission) { ++asked; });
+    QSignalSpy loadSpy(&page, &QWebEnginePage::loadFinished);
+    page.load(server.url("/"));
+    QTRY_COMPARE(loadSpy.size(), 1);
+    QVERIFY(evaluateJavaScriptSync(&page, "window.isSecureContext").toBool());
+
+    evaluateJavaScriptSync(&page,
+                           "const key = new Uint8Array(65); key[0] = 4;"
+                           "navigator.serviceWorker.register('/worker.js')"
+                           ".then(() => navigator.serviceWorker.ready)"
+                           ".then(r => r.pushManager.subscribe("
+                           "{userVisibleOnly: true, applicationServerKey: key}))"
+                           ".then(() => window.outcome = 'subscribed',"
+                           " e => window.outcome = e.name + ': ' + e.message);");
+    // The page has its answer, or the engine is waiting on the application.
+    QTRY_VERIFY_WITH_TIMEOUT(asked > 0
+                || evaluateJavaScriptSync(&page, "window.outcome !== undefined").toBool(),
+            10000);
+    QCOMPARE(asked, 0);
+    QCOMPARE(evaluateJavaScriptSync(&page, "window.outcome").toString(),
+             QStringLiteral("AbortError: Registration failed - push service not available"));
+}
+
+// Only a push subscription is turned away off the record. A page that asks to
+// notify is still put to the application, which can answer it.
+void tst_QWebEnginePage::notificationRequestStillReachesTheApplicationOffTheRecord()
+{
+    HttpServer server;
+    connect(&server, &HttpServer::newRequest, &server, [&](HttpReqRep *r) {
+        r->setResponseHeader("Content-Type", "text/html");
+        r->setResponseBody("<html><body></body></html>");
+        r->sendResponse();
+    });
+    QVERIFY(server.start());
+
+    QWebEngineProfile profile;
+    QVERIFY(profile.isOffTheRecord());
+    QWebEnginePage page(&profile);
+    QList<QWebEnginePermission::PermissionType> asked;
+    connect(&page, &QWebEnginePage::permissionRequested, &page, [&](QWebEnginePermission permission) {
+        asked.append(permission.permissionType());
+        permission.grant();
+    });
+    QSignalSpy loadSpy(&page, &QWebEnginePage::loadFinished);
+    page.load(server.url("/"));
+    QTRY_COMPARE(loadSpy.size(), 1);
+
+    evaluateJavaScriptSync(&page,
+                           "Notification.requestPermission().then(a => window.answer = a);");
+    QTRY_VERIFY_WITH_TIMEOUT(
+            evaluateJavaScriptSync(&page, "window.answer !== undefined").toBool(), 10000);
+    QCOMPARE(asked, QList<QWebEnginePermission::PermissionType>{QWebEnginePermission::PermissionType::Notifications});
+    QCOMPARE(evaluateJavaScriptSync(&page, "window.answer").toString(), QStringLiteral("granted"));
+}
