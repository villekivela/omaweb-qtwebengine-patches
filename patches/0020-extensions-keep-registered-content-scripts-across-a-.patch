+
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "extensions/browser/extension_registry.h"
+#include "extensions/browser/extension_registry_observer.h"
+#include "extensions/common/url_pattern.h"
+
+class GURL;
+
+namespace content {
+class BrowserContext;
+class NavigationThrottleRegistry;
+}
+
+namespace extensions {
+
+// Holds back a navigation to a page an enabled extension's content scripts are for while those
+// scripts are still being read, as Chrome's UserScriptListener does for every profile. An extension
+// reads the scripts it registered to persist from the profile's store after it is enabled, so a
+// page opened at once, such as a restored tab, would otherwise load without them. One per profile.
+class UserScriptListenerQt : public ExtensionRegistryObserver
+{
+public:
+    explicit UserScriptListenerQt(content::BrowserContext *context);
+    UserScriptListenerQt(const UserScriptListenerQt &) = delete;
+    UserScriptListenerQt &operator=(const UserScriptListenerQt &) = delete;
+    ~UserScriptListenerQt() override;
+
+    // Adds a throttle that defers the navigation if it has to wait.
+    void CreateAndAddNavigationThrottle(content::NavigationThrottleRegistry &registry);
+
+    // Every extension enabled so far has its scripts loaded.
+    void OnScriptsLoaded();
+
+private:
+    class Throttle;
+
+    bool ShouldDelayRequest(const GURL &url) const;
+    void CollectURLPatterns(const Extension *extension, std::vector<URLPattern> *patterns) const;
+
+    // ExtensionRegistryObserver:
+    void OnExtensionLoaded(content::BrowserContext *browser_context,
+                           const Extension *extension) override;
+    void OnExtensionUnloaded(content::BrowserContext *browser_context, const Extension *extension,
+                             UnloadedExtensionReason reason) override;
+    void OnShutdown(ExtensionRegistry *registry) override;
+
+    raw_ptr<content::BrowserContext> context_;
+    bool user_scripts_ready_ = true;
+    std::vector<URLPattern> url_patterns_;
+    std::vector<base::WeakPtr<Throttle>> throttles_;
+    base::ScopedObservation<ExtensionRegistry, ExtensionRegistryObserver>
+            extension_registry_observation_{ this };
+};
+
+} // namespace extensions
+
+#endif // USER_SCRIPT_LISTENER_QT_H_
