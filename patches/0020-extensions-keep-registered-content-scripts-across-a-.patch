 StateStore *ExtensionSystemQt::dynamic_user_scripts_store()
 {
-    return nullptr;
+    return dynamic_user_scripts_store_.get();
+}
+
+namespace {
+// The version of an extension whose registered scripts the store holds. Chrome reads the version it
+// is updating from out of the install it records, and Qt records none.
+constexpr char kKeptScriptsVersionPref[] = "kept_scripts_version";
+} // namespace
+
+void ExtensionSystemQt::ForgetScriptsOfAnOlderVersion(const Extension &extension)
+{
+    if (!dynamic_user_scripts_store_)
+        return;
+    ExtensionPrefs *prefs = ExtensionPrefs::Get(browser_context_);
+    const std::string version = extension.version().GetString();
+    std::string kept;
+    if (prefs->ReadPrefAsString(extension.id(), kKeptScriptsVersionPref, &kept) && kept != version) {
+        // What Chrome's store and user-script manager do when an update is about to be installed:
+        // the scripts and the patterns kept so a navigation can wait for them. Both go before the
+        // new version is loaded, so its loader finds nothing to read.
+        dynamic_user_scripts_store_->RemoveExtensionValue(extension.id(),
+                                                          scripting::kRegisteredScriptsStorageKey);
+        scripting::ClearPersistentScriptURLPatterns(browser_context_, extension.id());
+    }
+    prefs->UpdateExtensionPref(extension.id(), kKeptScriptsVersionPref, base::Value(version));
+}
+
+void ExtensionSystemQt::ForgetKeptScripts(const ExtensionId &id)
+{
+    if (!dynamic_user_scripts_store_)
+        return;
+    scripting::ClearPersistentScriptURLPatterns(browser_context_, id);
+    ExtensionPrefs::Get(browser_context_)->UpdateExtensionPref(id, kKeptScriptsVersionPref,
+                                                               std::nullopt);
 }
 
 scoped_refptr<value_store::ValueStoreFactory> ExtensionSystemQt::store_factory()
@@ -301,6 +338,18 @@ void ExtensionSystemQt::Init(bool extensions_enabled)
     initialized_ = true;
 
     service_worker_manager_ = std::make_unique<ServiceWorkerManager>(browser_context_);
+    // Content scripts an extension registers to persist across sessions are kept in the
+    // profile, as Chrome keeps them. The store comes first: the user-script manager tells the
+    // store its key when it is built, and the store clears only the keys it was told of when an
+    // extension is uninstalled. An off-the-record profile has no store, so nothing is ever written
+    // to the storage path it can still name. Its loader refuses every extension today, so this
+    // matters only if that changes.
+    if (!browser_context_->IsOffTheRecord()) {
+        dynamic_user_scripts_store_ = std::make_unique<StateStore>(
+                browser_context_, store_factory_, StateStore::BackendType::SCRIPTS,
+                /*deferred_load=*/false);
+        user_script_listener_ = std::make_unique<UserScriptListenerQt>(browser_context_);
+    }
     user_script_manager_ = std::make_unique<UserScriptManager>(browser_context_);
     quota_service_ = std::make_unique<QuotaService>();
 #if QT_CONFIG(webengine_extensions)
