+void tst_QWebEngineExtension::anUpdateForgetsWhatTheOldVersionRegistered()
+{
+    // As in Chrome, a new version starts with none of the old one's registrations. An application
+    // updates an unpacked extension by replacing its files and loading the same path again, and an
+    // extension that registers the same ids at every start gets "Duplicate script ID" if the old
+    // ones come back. If the old script were still kept, a page it is for would wait until it was
+    // read and then run it, so the page shows whether it came back.
+    HttpServer server;
+    server.setResourceDirs({ resourcesPath() });
+    QVERIFY(server.start());
+    QTemporaryDir storage(QDir::tempPath() + "/tst_QWebEngineExtension-XXXXXX"_L1);
+    QTemporaryDir unpacked(QDir::tempPath() + "/tst_QWebEngineExtension-XXXXXX"_L1);
+    const QDir fixture(resourcesPath() + "kept_scripts_ext"_L1);
+    for (const QString &name : fixture.entryList(QDir::Files))
+        QVERIFY(QFile::copy(fixture.filePath(name), unpacked.filePath(name)));
+    const QString registerKept = "chrome.scripting.registerContentScripts([{id: 'kept', "
+                                 "matches: ['"_L1
+            + server.url("/*"_L1).toString() + "'], js: ['marker.js']}])"_L1;
+
+    ScriptingSession session;
+    openScriptingSession(session, storage.path(), false, unpacked.path());
+    if (QTest::currentTestFailed())
+        return;
+    QCOMPARE(scripting(session.page.get(), registerKept), "null"_L1);
+    QTRY_VERIFY(QDir(storage.filePath("Extension Scripts"_L1)).exists());
+    session.close();
+
+    QFile manifest(unpacked.filePath("manifest.json"_L1));
+    QVERIFY(manifest.open(QIODevice::ReadOnly));
+    const QByteArray v1 = manifest.readAll();
+    manifest.close();
+    QByteArray v2 = v1;
+    v2.replace("\"version\": \"1.0\"", "\"version\": \"2.0\"");
+    QVERIFY(v2 != v1);
+    QVERIFY(manifest.open(QIODevice::WriteOnly | QIODevice::Truncate));
+    QCOMPARE(manifest.write(v2), v2.size());
+    manifest.close();
+
+    openScriptingSession(session, storage.path(), false, unpacked.path());
+    if (QTest::currentTestFailed())
+        return;
+    QWebEnginePage page(session.profile.get());
+    QSignalSpy loadSpy(&page, SIGNAL(loadFinished(bool)));
+    page.load(server.url("/index.html"_L1));
+    QTRY_COMPARE(loadSpy.size(), 1);
+    QCOMPARE(evaluateJavaScriptSync(&page, "document.documentElement.dataset.kept ?? ''"_L1)
+                     .toString(),
+             QString());
+    QCOMPARE(registeredIds(session.page.get()), QStringList());
+    QCOMPARE(scripting(session.page.get(), registerKept), "null"_L1);
+}
