+void tst_QWebEngineExtension::anOffTheRecordProfileKeepsNoScriptStore()
+{
+    // An off-the-record profile given a storage path, which is the shape of a Private window in
+    // a browser that sets one for every profile. It refuses to load an extension, so nothing can
+    // be registered in it, and nothing of the kind reaches the disk.
+    QTemporaryDir storage(QDir::tempPath() + "/tst_QWebEngineExtension-XXXXXX"_L1);
+    QWebEngineProfileBuilder profileBuilder;
+    profileBuilder.setPersistentStoragePath(storage.path());
+    std::unique_ptr<QWebEngineProfile> profile(profileBuilder.createProfile(QString()));
+    QVERIFY(profile->isOffTheRecord());
+    QWebEngineExtensionManager *manager = profile->extensionManager();
+    QSignalSpy spy(manager, SIGNAL(loadFinished(QWebEngineExtensionInfo)));
+    manager->loadExtension(resourcesPath() + "kept_scripts_ext"_L1);
+    QTRY_COMPARE(spy.size(), 1);
+    QWebEngineExtensionInfo extension = spy.takeFirst().at(0).value<QWebEngineExtensionInfo>();
+    QVERIFY2(!extension.isLoaded(), "an off-the-record profile loaded an extension");
+    QVERIFY(!extension.error().isEmpty());
+    profile.reset();
+
+    // A regular profile's store is written on the same file thread, after anything the
+    // off-the-record profile asked of it, so once that store is there the other would be too.
+    QTemporaryDir regular(QDir::tempPath() + "/tst_QWebEngineExtension-XXXXXX"_L1);
+    ScriptingSession session;
+    openScriptingSession(session, regular.path());
+    if (QTest::currentTestFailed())
+        return;
+    QCOMPARE(scripting(session.page.get(),
+                       "chrome.scripting.registerContentScripts(["
+                       "{id: 'regular', matches: ['http://*/*'], js: ['marker.js']}])"_L1),
+             "null"_L1);
+    QTRY_VERIFY(QDir(regular.filePath("Extension Scripts"_L1)).exists());
+
+    QDirIterator kept(storage.path(), { "Extension Scripts"_L1 }, QDir::Dirs,
+                      QDirIterator::Subdirectories);
+    QVERIFY2(!kept.hasNext(), qPrintable(kept.hasNext() ? kept.next() : QString()));
+}
