+void tst_QWebEngineExtension::aPageOpenedAsTheExtensionIsEnabledRunsItsKeptScripts()
+{
+    // A browser restoring its tabs opens them as soon as the extension is on, while the extension
+    // is still reading what it kept. Chrome holds those navigations until the scripts are read,
+    // so the first load of each tab already runs them, and so must this.
+    HttpServer server;
+    server.setResourceDirs({ resourcesPath() });
+    QVERIFY(server.start());
+    QTemporaryDir storage(QDir::tempPath() + "/tst_QWebEngineExtension-XXXXXX"_L1);
+    QTemporaryDir unpacked(QDir::tempPath() + "/tst_QWebEngineExtension-XXXXXX"_L1);
+    const QDir fixture(resourcesPath() + "kept_scripts_ext"_L1);
+    for (const QString &name : fixture.entryList(QDir::Files))
+        QVERIFY(QFile::copy(fixture.filePath(name), unpacked.filePath(name)));
+    // A small script is read before a page from this machine arrives, so the page runs it even
+    // when nothing holds it. With 32 MB of comment the page arrives first; 8 MB was not enough.
+    QFile marker(unpacked.filePath("marker.js"_L1));
+    QVERIFY(marker.open(QIODevice::Append));
+    const QByteArray line = "// " + QByteArray(1021, 'x') + '\n';
+    for (int i = 0; i < 32 * 1024; ++i)
+        QCOMPARE(marker.write(line), line.size());
+    marker.close();
+    ScriptingSession session;
+    openScriptingSession(session, storage.path(), false, unpacked.path());
+    if (QTest::currentTestFailed())
+        return;
+    QCOMPARE(scripting(session.page.get(),
+                       "chrome.scripting.registerContentScripts([{id: 'kept', matches: ['"_L1
+                               + server.url("/*"_L1).toString()
+                               + "'], js: ['marker.js'], runAt: 'document_start'}])"_L1),
+             "null"_L1);
+    QTRY_VERIFY(QDir(storage.filePath("Extension Scripts"_L1)).exists());
+    session.close();
+
+    QWebEngineProfileBuilder profileBuilder;
+    profileBuilder.setPersistentStoragePath(storage.path());
+    session.profile.reset(profileBuilder.createProfile("KeptScripts"_L1));
+    QWebEngineExtensionManager *manager = session.profile->extensionManager();
+    QSignalSpy spy(manager, SIGNAL(loadFinished(QWebEngineExtensionInfo)));
+    manager->loadExtension(unpacked.path());
+    QTRY_COMPARE(spy.size(), 1);
+    QWebEngineExtensionInfo extension = spy.takeFirst().at(0).value<QWebEngineExtensionInfo>();
+    QVERIFY2(extension.isLoaded(), qPrintable(extension.error()));
+    // A page of the same site first, so its process is already running when the restored load
+    // comes and nothing but the scripts can make it slower than they are.
+    QWebEnginePage page(session.profile.get());
+    QSignalSpy loadSpy(&page, SIGNAL(loadFinished(bool)));
+    page.load(server.url("/index.html?warm"_L1));
+    QTRY_COMPARE(loadSpy.size(), 1);
+
+    manager->setExtensionEnabled(extension, true);
+    page.load(server.url("/index.html"_L1));
+    QTRY_COMPARE(loadSpy.size(), 2);
+    QCOMPARE(evaluateJavaScriptSync(&page, "document.documentElement.dataset.kept ?? ''"_L1)
+                     .toString(),
+             "yes"_L1);
+}
