+// Copyright (C) 2026 The Qt Company Ltd.
+// SPDX-License-Identifier: LicenseRef-Qt-Commercial OR LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only
+// Qt-Security score:significant reason:default
+
+// Based on Chrome's chrome/browser/extensions/user_script_listener.cc, which is not in this tree,
+// for one profile rather than for every profile the browser has loaded.
+
+#include "user_script_listener_qt.h"
+
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/navigation_throttle.h"
+#include "content/public/browser/navigation_throttle_registry.h"
+#include "extensions/browser/scripting_utils.h"
+#include "extensions/common/extension.h"
+#include "extensions/common/manifest_handlers/content_scripts_handler.h"
+#include "extensions/common/permissions/api_permission.h"
+#include "extensions/common/permissions/permissions_data.h"
+#include "extensions/common/url_pattern_set.h"
+
+namespace extensions {
+
+class UserScriptListenerQt::Throttle : public content::NavigationThrottle
+{
+public:
+    explicit Throttle(content::NavigationThrottleRegistry &registry) : NavigationThrottle(registry)
+    {
+    }
+
+    void ResumeIfDeferred()
+    {
+        should_defer_ = false;
+        if (did_defer_)
+            Resume();
+    }
+
+    ThrottleCheckResult WillStartRequest() override
+    {
+        if (should_defer_) {
+            did_defer_ = true;
+            return DEFER;
+        }
+        return PROCEED;
+    }
+
+    const char *GetNameForLogging() override { return "UserScriptListenerQt::Throttle"; }
+
+    base::WeakPtr<Throttle> AsWeakPtr() { return weak_ptr_factory_.GetWeakPtr(); }
+
+private:
+    bool should_defer_ = true;
+    bool did_defer_ = false;
+    base::WeakPtrFactory<Throttle> weak_ptr_factory_{ this };
+};
+
+UserScriptListenerQt::UserScriptListenerQt(content::BrowserContext *context) : context_(context)
+{
+    extension_registry_observation_.Observe(ExtensionRegistry::Get(context));
+}
+
+UserScriptListenerQt::~UserScriptListenerQt() = default;
+
+void UserScriptListenerQt::CreateAndAddNavigationThrottle(
+        content::NavigationThrottleRegistry &registry)
+{
+    if (!ShouldDelayRequest(registry.GetNavigationHandle().GetURL()))
+        return;
+    auto throttle = std::make_unique<Throttle>(registry);
+    throttles_.push_back(throttle->AsWeakPtr());
+    registry.AddThrottle(std::move(throttle));
+}
+
+void UserScriptListenerQt::OnScriptsLoaded()
+{
+    user_scripts_ready_ = true;
+    for (const base::WeakPtr<Throttle> &throttle : throttles_) {
+        if (throttle)
+            throttle->ResumeIfDeferred();
+    }
+    throttles_.clear();
+}
+
+bool UserScriptListenerQt::ShouldDelayRequest(const GURL &url) const
+{
+    if (user_scripts_ready_)
+        return false;
+    for (const URLPattern &pattern : url_patterns_) {
+        if (pattern.MatchesURL(url))
+            return true;
+    }
+    return false;
+}
+
+void UserScriptListenerQt::CollectURLPatterns(const Extension *extension,
+                                              std::vector<URLPattern> *patterns) const
+{
+    for (const std::unique_ptr<UserScript> &script :
+         ContentScriptsInfo::GetContentScripts(extension)) {
+        patterns->insert(patterns->end(), script->url_patterns().begin(),
+                         script->url_patterns().end());
+    }
+    // The scripts an extension registered to persist are known by their patterns, which are kept
+    // in its prefs for this, while the scripts themselves are still being read from the store. The
+    // user-script manager reads them only for an extension that may still run them, so a page waits
+    // only then: waiting for a read that never starts would hold it for good.
+    const PermissionsData *permissions = extension->permissions_data();
+    if (!permissions->HasAPIPermission(mojom::APIPermissionID::kScripting)
+        && !permissions->HasAPIPermission(mojom::APIPermissionID::kUserScripts)) {
+        return;
+    }
+    URLPatternSet dynamic_patterns =
+            scripting::GetPersistentScriptURLPatterns(context_, extension->id());
+    patterns->insert(patterns->end(), dynamic_patterns.begin(), dynamic_patterns.end());
+}
+
+void UserScriptListenerQt::OnExtensionLoaded(content::BrowserContext *browser_context,
+                                             const Extension *extension)
+{
+    std::vector<URLPattern> new_patterns;
+    CollectURLPatterns(extension, &new_patterns);
+    if (new_patterns.empty())
+        return;
+    // The user-script manager reads this extension's scripts now, and says when every extension
+    // it is reading for has its scripts, which is when OnScriptsLoaded() is called.
+    user_scripts_ready_ = false;
+    url_patterns_.insert(url_patterns_.end(), new_patterns.begin(), new_patterns.end());
+}
+
+void UserScriptListenerQt::OnExtensionUnloaded(content::BrowserContext *browser_context,
+                                               const Extension *extension,
+                                               UnloadedExtensionReason reason)
+{
+    std::vector<URLPattern> patterns;
+    for (const scoped_refptr<const Extension> &enabled :
+         ExtensionRegistry::Get(context_)->enabled_extensions()) {
+        if (enabled.get() != extension)
+            CollectURLPatterns(enabled.get(), &patterns);
+    }
+    url_patterns_ = std::move(patterns);
+}
+
+void UserScriptListenerQt::OnShutdown(ExtensionRegistry *registry)
+{
+    extension_registry_observation_.Reset();
+}
+
+} // namespace extensions
