+// Writes what is pending and returns once it is on disk. The file is written in the background and
+// read on the UI thread, so a store made next on the same path could otherwise read it before the
+// last write of the one before it, and start without the preferences that one kept. The thread pool
+// outlives every profile, so the write always runs.
+void PrefServiceAdapter::commitAndWait()
+{
+    DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+    if (!m_prefService)
+        return;
+    base::WaitableEvent written;
+    m_prefService->CommitPendingWrite(
+            base::OnceClosure(),
+            base::BindOnce(&base::WaitableEvent::Signal, base::Unretained(&written)));
+    base::ScopedAllowBlocking allowBlock;
+    written.Wait();
+}
