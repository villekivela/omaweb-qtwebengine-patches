 #include "qtwebengine/common/extensions/api/windows.h"
 
@@ -43,6 +45,53 @@ std::string NoWindowError(int window_id) {
 
 }  // namespace
 
+ExtensionFunction::ResponseAction WindowsCreateFunction::Run() {
+  std::optional<windows::Create::Params> params = windows::Create::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  // QtWebEngine has one window per browser context, so a window an extension
+  // asks for is a page the application opens. Which surface it opens in is the
+  // application's decision, not this one's.
+  std::vector<std::string> urls;
+  if (params->create_data && params->create_data->url) {
+    if (params->create_data->url->as_string)
+      urls.push_back(*params->create_data->url->as_string);
+    else if (params->create_data->url->as_strings)
+      urls = *params->create_data->url->as_strings;
+  }
+  if (urls.empty())
+    urls.push_back(url::kAboutBlankURL);
+
+  content::WebContents* opened = nullptr;
+  for (const std::string& candidate : urls) {
+    GURL url = GURL(candidate);
+    if (!url.is_valid() && extension())
+      url = extension()->GetResourceURL(candidate);
+    if (!url.is_valid())
+      return RespondNow(Error(ErrorUtils::FormatErrorMessage("Invalid url: \"*\".", candidate)));
+    if (url.SchemeIs(url::kJavaScriptScheme))
+      return RespondNow(Error("JavaScript URLs are not allowed in chrome.windows.create."));
+    content::WebContents* contents =
+        TabRegistryQt::Get()->OpenPage(browser_context(), url, true);
+    if (!contents)
+      return RespondNow(Error("The application did not open a window."));
+    if (!opened)
+      opened = contents;
+  }
+
+  windows::Window window;
+  window.id = TabRegistryQt::kWindowId;
+  window.focused = true;
+  window.incognito = browser_context()->IsOffTheRecord();
+  window.type = windows::WindowType::kNormal;
+  window.state = windows::WindowState::kNormal;
+  window.always_on_top = false;
+  std::vector<api::tabs::Tab> tabs;
+  tabs.push_back(TabRegistryQt::Get()->CreateTab(opened));
+  window.tabs = std::move(tabs);
+  return RespondNow(WithArguments(window.ToValue()));
+}
