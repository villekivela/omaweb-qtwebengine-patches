+// An extension asking for a tab uses the door a page's own window.open() uses.
+// The application is handed the new page through adoptNewWindow with the
+// address the extension asked for, and decides there what opening it means:
+// its own surfaces, its own rules, its own refusal.
+content::WebContents *ExtensionsBrowserClientQt::OpenPage(content::BrowserContext *context,
+                                                          const GURL &url, bool active)
+{
+    // The delegate of a page already on show is what carries the request to the
+    // application, so a context showing nothing cannot open anything.
+    content::WebContents *source = GetActiveTab(context);
+    if (!source) {
+        std::vector<content::WebContents *> tabs = GetTabs(context);
+        source = tabs.empty() ? nullptr : tabs.front();
+    }
+    if (!source || !source->GetDelegate())
+        return nullptr;
+
+    content::WebContents::CreateParams params(context);
+    std::unique_ptr<content::WebContents> created = content::WebContents::Create(params);
+    content::WebContents *contents = created.get();
+
+    // The page is handed over before it goes anywhere. Navigating first builds
+    // its render view while the view still has no client, and the adoption then
+    // walks into a view delegate that was never set.
+    bool blocked = false;
+    source->GetDelegate()->AddNewContents(
+            source, std::move(created), url,
+            active ? WindowOpenDisposition::NEW_FOREGROUND_TAB
+                   : WindowOpenDisposition::NEW_BACKGROUND_TAB,
+            blink::mojom::WindowFeatures(), /* user_gesture = */ true, &blocked);
+    if (blocked)
+        return nullptr;
+
+    content::NavigationController::LoadURLParams load(url);
+    load.transition_type = ui::PAGE_TRANSITION_AUTO_TOPLEVEL;
+    contents->GetController().LoadURLWithParams(load);
+    return contents;
+}
