index fe267560c9..bb52d21705 100644
--- a/src/3rdparty/chromium/qtwebengine/browser/extensions/api/tabs/tabs_api.cc
+++ b/src/3rdparty/chromium/qtwebengine/browser/extensions/api/tabs/tabs_api.cc
@@ -109,6 +109,36 @@ static std::string TabNotFoundError(int tab_id) {
   return ErrorUtils::FormatErrorMessage("No tab with id: *.", base::NumberToString(tab_id));
 }
 
+ExtensionFunction::ResponseAction TabsCreateFunction::Run() {
+  std::optional<tabs::Create::Params> params = tabs::Create::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  GURL url;
+  std::string error;
+  if (params->create_properties.url) {
+    if (!PrepareURLForNavigation(*params->create_properties.url, extension(), &url, &error))
+      return RespondNow(Error(std::move(error)));
+    if (url.SchemeIs(url::kJavaScriptScheme))
+      return RespondNow(Error("JavaScript URLs are not allowed in chrome.tabs.create."));
+  } else {
+    url = GURL(url::kAboutBlankURL);
+  }
+
+  const bool active = params->create_properties.active.value_or(true);
+  content::WebContents* contents =
+      TabRegistryQt::Get()->OpenPage(browser_context(), url, active);
+  if (!contents)
+    return RespondNow(Error("The application did not open a tab."));
+
+  base::Value::Dict tab = TabRegistryQt::Get()->CreateTabValue(contents);
+  // The navigation has not committed yet, so the tab has no url. Chrome
+  // answers with the address it was asked for as pendingUrl, and an extension
+  // that follows the tab it just opened reads that.
+  if (!tab.FindString("pendingUrl"))
+    tab.Set("pendingUrl", url.spec());
+  return RespondNow(WithArguments(std::move(tab)));
+}
