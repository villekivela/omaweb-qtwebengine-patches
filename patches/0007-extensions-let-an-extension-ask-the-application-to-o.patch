+void tst_QWebEngineExtension::anExtensionOpensAPage()
+{
+    // An extension asking for a tab arrives where a page's own window.open()
+    // arrives, so the application decides what opening one means. Here that is
+    // a second page, which the extension is then told about.
+    HttpServer server;
+    server.setResourceDirs({ resourcesPath() });
+    QVERIFY(server.start());
+
+    QWebEngineExtensionInfo extension = loadExtensionSync(resourcesPath() + "tabs_ext"_L1);
+    QVERIFY(extension.isLoaded());
+    m_manager->setExtensionEnabled(extension, true);
+
+    QSignalSpy loadSpy(m_page, SIGNAL(loadFinished(bool)));
+    m_page->load(server.url("/index.html"_L1));
+    QTRY_COMPARE(loadSpy.size(), 1);
+    QTRY_VERIFY(evaluateJavaScriptSync(m_page, "!!document.getElementById('testNode')").toBool());
+
+    std::unique_ptr<QWebEnginePage> opened;
+    connect(m_page, &QWebEnginePage::newWindowRequested, this,
+            [&opened, this](QWebEngineNewWindowRequest &request) {
+                opened = std::make_unique<QWebEnginePage>(m_profile);
+                request.openIn(opened.get());
+            });
+
+    evaluateJavaScriptSync(m_page, "window.postMessage({ omawebOpen: true }, '*')");
+    QTRY_VERIFY(opened);
+    QTRY_VERIFY(evaluateJavaScriptSync(m_page, "!!document.getElementById('openedNode')").toBool());
+    QTRY_COMPARE(opened->url().path(), "/index.html"_L1);
+}
