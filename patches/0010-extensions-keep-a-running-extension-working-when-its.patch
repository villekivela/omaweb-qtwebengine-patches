+void tst_QWebEngineExtension::loadingTheSamePathTwiceLeavesOneWorkingExtension()
+{
+    // An application that asks for the same package twice in a row, which Omaweb did until it
+    // learnt not to, is asking for one extension, not a broken one. The Omarchy VM found that a
+    // second load of a running extension left its worker and popup with no `chrome` at all.
+    // A page first, so the second load lands in a profile with a renderer running, which is the
+    // state the VM was in.
+    QSignalSpy loadSpy(m_page, SIGNAL(loadFinished(bool)));
+    m_page->load(QUrl("qrc:///resources/index.html"));
+    QTRY_COMPARE(loadSpy.size(), 1);
+
+    // Loaded, enabled and running, and then asked for again: the second ask comes a tick after
+    // the first was answered, which is how a signal answered twice asks.
+    QWebEngineExtensionInfo extension =
+            loadExtensionSync(resourcesPath() + "localized_worker_ext"_L1);
+    QVERIFY(extension.isLoaded());
+    m_manager->setExtensionEnabled(extension, true);
+    m_page->load(QUrl("qrc:///resources/index.html"));
+    QTRY_COMPARE(loadSpy.size(), 2);
+    QTRY_COMPARE(evaluateJavaScriptSync(m_page, "document.getElementById('testNode')?.textContent"),
+                 "hello from the worker"_L1);
+
+    QSignalSpy spy(m_manager, SIGNAL(loadFinished(QWebEngineExtensionInfo)));
+    m_manager->loadExtension(resourcesPath() + "localized_worker_ext"_L1);
+    QTRY_COMPARE(spy.size(), 1);
+    QWebEngineExtensionInfo again = spy.takeFirst().value(0).value<QWebEngineExtensionInfo>();
+    QCOMPARE(again.id(), extension.id());
+    m_manager->setExtensionEnabled(again, true);
+    // However the second ask was answered, the list has one of it.
+    int count = 0;
+    for (const QWebEngineExtensionInfo &info : m_manager->extensions()) {
+        if (info.id() == extension.id())
+            ++count;
+    }
+    QCOMPARE(count, 1);
+
+    m_page->load(QUrl("qrc:///resources/index.html"));
+    QTRY_COMPARE(loadSpy.size(), 3);
+    QTRY_COMPARE(evaluateJavaScriptSync(m_page, "document.getElementById('testNode')?.textContent"),
+                 "hello from the worker"_L1);
+}
