From dd97947c802844b8a3d594b9d5194024ce7867fa Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Ville=20Kivela=CC=88?= <vkivela@hotmail.com>
Date: Mon, 21 Sep 2026 12:35:01 +0300
Subject: [PATCH 10/14] extensions: keep a running extension working when its
 path is loaded again

Loading a path that was already loaded sent the extension round as a
reload: the registrar disabled it with DISABLE_RELOAD and handed the
reload to a delegate whose body was empty. The extension stayed disabled
with its worker gone, while the manager reported it loaded. An
application that asked twice, which Omaweb did, got a popup with no
`chrome` and a worker that had never started.

The same path loaded again is the same extension, updated in place. A
running one goes through the registrar's AddExtension, which swaps the
copy and activates it as Chrome does for an update; one the application
never enabled is swapped and stays disabled, so loading twice does not
enable. The reload delegate reads the path again and hands the copy
back, so reloadExtension() finishes what it starts too.

The existing reload test counted extensions and checked isLoaded, and
so never noticed. The new one asks the worker afterwards.
---
 src/core/extensions/extension_loader.cpp      | 45 +++++++++++++++++--
 src/core/extensions/extension_loader.h        |  9 +++-
 .../extensions/tst_qwebengineextension.cpp    | 43 ++++++++++++++++++
 3 files changed, 92 insertions(+), 5 deletions(-)

diff --git a/src/core/extensions/extension_loader.cpp b/src/core/extensions/extension_loader.cpp
index eafb641225..a40ab37fd3 100644
--- a/src/core/extensions/extension_loader.cpp
+++ b/src/core/extensions/extension_loader.cpp
@@ -82,10 +82,49 @@ void ExtensionLoader::loadExtension(const base::FilePath &path)
 
 void ExtensionLoader::addExtension(scoped_refptr<const Extension> extension)
 {
-    if (extensions().Contains(extension->id()))
-        m_extensionRegistrar->ReloadExtensionWithQuietFailure(extension->id());
-    else
+    // The same path loaded again is the same extension, updated in place. The
+    // registrar swaps a running one for the new copy and activates it, which is
+    // what Chrome does for an update; one the application never enabled is
+    // swapped and stays disabled, so loading twice does not enable. Sending it
+    // round as a reload instead disabled it and waited on a reload delegate
+    // that did nothing, and the second load of a running extension left it
+    // with no worker.
+    const std::string &id = extension->id();
+    if (m_extensionRegistry->enabled_extensions().Contains(id)) {
+        m_extensionRegistrar->AddExtension(extension);
+    } else if (extensions().Contains(id)) {
+        m_extensionRegistrar->RemoveExtension(id, UnloadedExtensionReason::UPDATE);
         m_extensionRegistry->AddDisabled(extension);
+    } else {
+        m_extensionRegistry->AddDisabled(extension);
+    }
+}
+
+void ExtensionLoader::LoadExtensionForReload(const ExtensionId &extension_id,
+                                             const base::FilePath &path)
+{
+    Q_UNUSED(extension_id);
+    GetExtensionFileTaskRunner()->PostTaskAndReplyWithResult(
+            FROM_HERE, base::BindOnce(&loadExtensionOnFileThread, path),
+            base::BindOnce(&ExtensionLoader::reloadFinished, m_weakFactory.GetWeakPtr()));
+}
+
+void ExtensionLoader::LoadExtensionForReloadWithQuietFailure(const ExtensionId &extension_id,
+                                                             const base::FilePath &path)
+{
+    LoadExtensionForReload(extension_id, path);
+}
+
+void ExtensionLoader::reloadFinished(const LoadingInfo &loadingInfo)
+{
+    if (!loadingInfo.error.empty()) {
+        m_manager->onExtensionLoadError(toQt(loadingInfo.path), loadingInfo.error);
+        return;
+    }
+    // The registrar knows this id is reloading and puts the copy back in the
+    // state it took it from.
+    m_extensionRegistrar->AddExtension(loadingInfo.extension);
+    m_manager->onExtensionLoaded(loadingInfo.extension.get());
 }
 
 void ExtensionLoader::reloadExtension(const std::string &id)
