diff --git a/tests/auto/widgets/extensions/resources/offscreen_text_ext/offscreen.js b/tests/auto/widgets/extensions/resources/offscreen_text_ext/offscreen.js
new file mode 100644
index 0000000000..92a6900e6d
--- /dev/null
+++ b/tests/auto/widgets/extensions/resources/offscreen_text_ext/offscreen.js
@@ -0,0 +1,6 @@
+// A password manager copies through a text area it selects, and then takes it away again.
+const area = document.querySelector("textarea");
+area.value = "password";
+area.select();
+area.remove();
+chrome.runtime.sendMessage("offscreen selected");
