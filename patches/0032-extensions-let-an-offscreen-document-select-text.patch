diff --git a/tests/auto/widgets/extensions/resources/offscreen_text_ext/page.js b/tests/auto/widgets/extensions/resources/offscreen_text_ext/page.js
new file mode 100644
index 0000000000..9241881ff1
--- /dev/null
+++ b/tests/auto/widgets/extensions/resources/offscreen_text_ext/page.js
@@ -0,0 +1,6 @@
+chrome.runtime.onMessage.addListener((message) => document.title = message);
+chrome.offscreen.createDocument({
+    url: "offscreen.html",
+    reasons: ["CLIPBOARD"],
+    justification: "test"
+}).catch((error) => document.title = "failed: " + error.message);
diff --git a/tests/auto/widgets/extensions/tst_qwebengineextension.cpp b/tests/auto/widgets/extensions/tst_qwebengineextension.cpp
index 0f70809f0b..57e864ab70 100644
--- a/tests/auto/widgets/extensions/tst_qwebengineextension.cpp
+++ b/tests/auto/widgets/extensions/tst_qwebengineextension.cpp
@@ -75,6 +75,7 @@ private Q_SLOTS:
     void aPageCanLoadAWebAccessibleResource();
     void aResourceWithADynamicUrlIsReachableOnlyUnderIt();
     void anOffscreenDocumentCanBeCreated();
+    void anOffscreenDocumentCanSelectText();
     void anExtensionUsesTheClipboardItsPermissionsAllow();
     void enableAfterStoragePathChange();
     void tabsWindowsAndScripting();
@@ -1434,6 +1435,25 @@ void tst_QWebEngineExtension::anOffscreenDocumentCanBeCreated()
     QTRY_COMPARE(m_page->title(), "offscreen ready"_L1);
 }
 
+void tst_QWebEngineExtension::anOffscreenDocumentCanSelectText()
+{
+    // An offscreen document's view has no delegate. Selecting text in it, and taking the text
+    // area away again, reports a text input state, a selection and a focused node to that view,
+    // and each of those reached for the missing delegate.
+    QWebEngineExtensionInfo extension = loadExtensionSync(resourcesPath() + "offscreen_text_ext"_L1);
+    QVERIFY2(extension.isLoaded(), qPrintable(extension.error()));
+    m_manager->setExtensionEnabled(extension, true);
+
+    QSignalSpy loadSpy(m_page, SIGNAL(loadFinished(bool)));
+    m_page->load(QUrl("chrome-extension://"_L1 + extension.id() + "/page.html"_L1));
+    QTRY_COMPARE(loadSpy.size(), 1);
+    QTRY_COMPARE(m_page->title(), "offscreen selected"_L1);
+    // The view hears of the selection after the document has moved on, so the page is given
+    // time for it to arrive.
+    QTest::qWait(500);
+    QCOMPARE(evaluateJavaScriptSync(m_page, "document.title"), "offscreen selected"_L1);
+}
