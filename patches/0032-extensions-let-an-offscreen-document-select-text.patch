diff --git a/src/core/render_widget_host_view_qt.cpp b/src/core/render_widget_host_view_qt.cpp
index 1ad92f2dad..340672c5f0 100644
--- a/src/core/render_widget_host_view_qt.cpp
+++ b/src/core/render_widget_host_view_qt.cpp
@@ -687,6 +687,11 @@ void RenderWidgetHostViewQt::OnUpdateTextInputStateCalled(content::TextInputMana
     Q_UNUSED(updated_view);
     Q_UNUSED(did_update_state);
 
+    // A view in contents the extension system created, such as an offscreen document, has no
+    // delegate and no input method to tell.
+    if (!m_delegate)
+        return;
+
     const ui::mojom::TextInputState *state = text_input_manager->GetTextInputState();
     if (!state) {
         // Do not reset input method state here because an editable node might be still focused and
@@ -734,6 +739,9 @@ void RenderWidgetHostViewQt::OnSelectionBoundsChanged(content::TextInputManager
 {
     Q_UNUSED(updated_view);
 
+    if (!m_delegate)
+        return;
+
     m_imState |= ImStateFlags::TextSelectionBoundsUpdated;
     if (m_imState == ImStateFlags::AllFlags
         || (m_imState == ImStateFlags::TextSelectionFlags
@@ -766,6 +774,9 @@ void RenderWidgetHostViewQt::OnTextSelectionChanged(content::TextInputManager *t
     }
 #endif // BUILDFLAG(IS_OZONE)
 
+    if (!m_delegate)
+        return;
+
     m_imState |= ImStateFlags::TextSelectionUpdated;
     if (m_imState == ImStateFlags::AllFlags
         || (m_imState == ImStateFlags::TextSelectionFlags
@@ -1060,7 +1071,7 @@ const viz::LocalSurfaceId &RenderWidgetHostViewQt::GetLocalSurfaceId() const
 void RenderWidgetHostViewQt::FocusedNodeChanged(bool is_editable_node, const gfx::Rect& node_bounds_in_screen)
 {
     Q_UNUSED(node_bounds_in_screen);
-    if (!is_editable_node) {
+    if (!is_editable_node && m_delegate) {
         m_delegate->inputMethodStateChanged(false /*editorVisible*/, false /*passwordInput*/);
         m_delegate->setInputMethodHints(Qt::ImhNone);
     }
