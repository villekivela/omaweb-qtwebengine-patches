 }
 
+void tst_QWebEnginePermission::clickedWriteIsNotAsked()
+{
+    // A copy button writes text during a click, and Chrome grants that sanitized write by default.
+    // Without JavascriptCanAccessClipboard, which would also let execCommand("copy") write with no
+    // gesture, it reached the application as a ClipboardReadWrite request.
+    QWebEngineView view;
+    QWebEnginePage page(m_profile.get(), &view);
+    view.setPage(&page);
+    int asked = 0;
+    connect(&page, &QWebEnginePage::permissionRequested, &page, [&](QWebEnginePermission p) {
+        ++asked;
+        p.deny();
+    });
+
+    QSignalSpy spy(&page, &QWebEnginePage::loadFinished);
+    page.setHtml("<html><body style='margin: 0'>"
+                 "<button style='width: 100vw; height: 100vh' onclick='copy()'>copy</button>"
+                 "<script>var state; function copy() { navigator.clipboard.writeText('copied')"
+                 ".then(() => state = 'written', (e) => state = e.name); }</script>"
+                 "</body></html>"_L1,
+                 QUrl("https://www.example.com/copy.html"));
+    QTRY_COMPARE(spy.size(), 1);
+    view.resize(300, 300);
+    view.show();
+    QVERIFY(QTest::qWaitForWindowExposed(&view));
+    view.activateWindow();
+    QTRY_VERIFY(evaluateJavaScriptSync(&page, "document.hasFocus()").toBool());
+    QGuiApplication::clipboard()->clear();
+
+    // The write without a gesture is the ClipboardReadWrite permission, and is still asked.
+    evaluateJavaScriptSync(&page, "copy()"_L1);
+    QTRY_COMPARE(evaluateJavaScriptSync(&page, "state"), "NotAllowedError"_L1);
+    QCOMPARE(asked, 1);
+    QCOMPARE(QGuiApplication::clipboard()->text(), QString());
+
+    QTest::mouseClick(view.focusProxy(), Qt::LeftButton, {}, QPoint{100, 100});
+    QTRY_COMPARE(evaluateJavaScriptSync(&page, "state"), "written"_L1);
+    QCOMPARE(QGuiApplication::clipboard()->text(), "copied"_L1);
+    QCOMPARE(asked, 1);
+}
+
 QTEST_MAIN(tst_QWebEnginePermission)
 #include "tst_qwebenginepermission.moc"
