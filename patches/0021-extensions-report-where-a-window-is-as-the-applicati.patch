diff --git a/tests/auto/widgets/extensions/resources/windows_ext/page.js b/tests/auto/widgets/extensions/resources/windows_ext/page.js
new file mode 100644
index 0000000000..5e8bd4468d
--- /dev/null
+++ b/tests/auto/widgets/extensions/resources/windows_ext/page.js
@@ -0,0 +1,31 @@
+// Every answer that carries a window says where it is, as Chrome's does. An
+// extension places a window of its own from these four numbers, and one that is
+// missing makes the arithmetic NaN, which windows.create refuses.
+const place = window => ({
+    left: window.left,
+    top: window.top,
+    width: window.width,
+    height: window.height,
+    integers: [window.left, window.top, window.width, window.height].every(Number.isInteger),
+})
+
+;(async () => {
+    const result = {}
+    result.get = place(await chrome.windows.get(chrome.windows.WINDOW_ID_CURRENT))
+    result.getCurrent = place(await chrome.windows.getCurrent())
+    result.getLastFocused = place(await chrome.windows.getLastFocused())
+    result.getAll = place((await chrome.windows.getAll({ populate: true }))[0])
+    result.worker = place(await chrome.runtime.sendMessage("getCurrent"))
+    if (location.hash === "#create")
+        result.create = place(await chrome.windows.create({ url: "blank.html" }))
+    result.integers = Object.values(result).every(window => window.integers)
+    const node = document.createElement("div")
+    node.id = "result"
+    node.textContent = JSON.stringify(result)
+    document.body.appendChild(node)
+})().catch(error => {
+    const node = document.createElement("div")
+    node.id = "result"
+    node.textContent = JSON.stringify({ error: String(error) })
+    document.body.appendChild(node)
+})
diff --git a/tests/auto/widgets/extensions/resources/windows_ext/service_worker.js b/tests/auto/widgets/extensions/resources/windows_ext/service_worker.js
new file mode 100644
index 0000000000..8447b884ae
--- /dev/null
+++ b/tests/auto/widgets/extensions/resources/windows_ext/service_worker.js
@@ -0,0 +1,8 @@
+// A worker has no tab behind it, so the window it is told about is the one the
+// application answers for no page at all.
+chrome.runtime.onMessage.addListener((message, sender, sendResponse) => {
+    if (message !== "getCurrent")
+        return false;
+    chrome.windows.getCurrent().then(sendResponse)
+    return true;
+})
