+// Where a window the extension was told about is, from the four numbers chrome.windows reports.
+static QRect placeOf(const QVariant &window)
+{
+    const QVariantMap map = window.toMap();
+    return QRect(map["left"_L1].toInt(), map["top"_L1].toInt(), map["width"_L1].toInt(),
+                 map["height"_L1].toInt());
+}
+
+static QVariantMap windowsReport(QWebEnginePage *page)
+{
+    if (!QTest::qWaitFor([page] {
+            return evaluateJavaScriptSync(page, "!!document.getElementById('result')").toBool();
+        }))
+        return {};
+    return evaluateJavaScriptSync(page, "JSON.parse(document.getElementById('result').textContent)")
+            .toMap();
+}
+
+void tst_QWebEngineExtension::aWindowIsWhereTheApplicationSaysItIs()
+{
+    // chrome.windows reports a window's position and size, and only the application knows them,
+    // so the engine asks it: about the page the call came from, or about no page for a worker.
+    // Every answer that carries a window carries the four numbers, windows.create's included.
+    HttpServer server;
+    server.setResourceDirs({ resourcesPath() });
+    QVERIFY(server.start());
+
+    QWebEngineExtensionInfo extension = loadExtensionSync(resourcesPath() + "windows_ext"_L1);
+    QVERIFY(extension.isLoaded());
+    m_manager->setExtensionEnabled(extension, true);
+
+    QList<const QObject *> asked;
+    m_manager->setWindowGeometryProvider([&asked](const QObject *page) {
+        asked.append(page);
+        return page ? QRect(11, 22, 640, 480) : QRect(33, 44, 1024, 768);
+    });
+    auto forget = qScopeGuard([this] { m_manager->setWindowGeometryProvider({}); });
+
+    // windows.create opens its page through a tab, the way a page's own window.open() does.
+    QSignalSpy loadSpy(m_page, SIGNAL(loadFinished(bool)));
+    m_page->load(server.url("/index.html"_L1));
+    QTRY_COMPARE(loadSpy.size(), 1);
+    std::unique_ptr<QWebEnginePage> opened;
+    connect(m_page, &QWebEnginePage::newWindowRequested, this,
+            [&opened, this](QWebEngineNewWindowRequest &request) {
+                opened = std::make_unique<QWebEnginePage>(m_profile);
+                request.openIn(opened.get());
+            });
+
+    QWebEnginePage extensionPage(m_profile);
+    extensionPage.load(QUrl("chrome-extension://"_L1 + extension.id() + "/page.html#create"_L1));
+    const QVariantMap result = windowsReport(&extensionPage);
+    QVERIFY2(!result.isEmpty(), "the extension page never reported");
+    QVERIFY2(!result.contains("error"_L1), qPrintable(result.value("error"_L1).toString()));
+    QVERIFY(result["integers"_L1].toBool());
+    QCOMPARE(placeOf(result["get"_L1]), QRect(11, 22, 640, 480));
+    QCOMPARE(placeOf(result["getCurrent"_L1]), QRect(11, 22, 640, 480));
+    QCOMPARE(placeOf(result["getLastFocused"_L1]), QRect(11, 22, 640, 480));
+    QCOMPARE(placeOf(result["getAll"_L1]), QRect(11, 22, 640, 480));
+    QCOMPARE(placeOf(result["create"_L1]), QRect(11, 22, 640, 480));
+    QCOMPARE(placeOf(result["worker"_L1]), QRect(33, 44, 1024, 768));
+    QVERIFY(asked.contains(&extensionPage));
+    QVERIFY(opened);
+    QVERIFY(asked.contains(opened.get()));
+    QVERIFY(asked.contains(nullptr));
+}
+
+void tst_QWebEngineExtension::withoutAnAnswerAWindowIsWhereItsViewIs()
+{
+    // An application that does not answer still gets numbers an extension can place a window
+    // with: the top left of the screen, and the size of the view the call came from. A worker's
+    // call comes from no view, so it gets the size of the tab on show.
+    HttpServer server;
+    server.setResourceDirs({ resourcesPath() });
+    QVERIFY(server.start());
+
+    QWebEngineExtensionInfo extension = loadExtensionSync(resourcesPath() + "windows_ext"_L1);
+    QVERIFY(extension.isLoaded());
+    m_manager->setExtensionEnabled(extension, true);
+
+    QWebEnginePage tab(m_profile);
+    QWebEngineView tabView;
+    tabView.setPage(&tab);
+    tabView.resize(400, 300);
+    tabView.show();
+    QVERIFY(QTest::qWaitForWindowExposed(&tabView));
+    QSignalSpy loadSpy(&tab, SIGNAL(loadFinished(bool)));
+    tab.load(server.url("/index.html"_L1));
+    QTRY_COMPARE(loadSpy.size(), 1);
+
+    QWebEnginePage extensionPage(m_profile);
+    QWebEngineView view;
+    view.setPage(&extensionPage);
+    view.resize(320, 240);
+    view.show();
+    QVERIFY(QTest::qWaitForWindowExposed(&view));
+    extensionPage.load(QUrl("chrome-extension://"_L1 + extension.id() + "/page.html"_L1));
+    const QVariantMap result = windowsReport(&extensionPage);
+    QVERIFY2(!result.isEmpty(), "the extension page never reported");
+    QVERIFY2(!result.contains("error"_L1), qPrintable(result.value("error"_L1).toString()));
+    QVERIFY(result["integers"_L1].toBool());
+    QCOMPARE(placeOf(result["get"_L1]), QRect(0, 0, 320, 240));
+    QCOMPARE(placeOf(result["getCurrent"_L1]), QRect(0, 0, 320, 240));
+    QCOMPARE(placeOf(result["getLastFocused"_L1]), QRect(0, 0, 320, 240));
+    QCOMPARE(placeOf(result["getAll"_L1]), QRect(0, 0, 320, 240));
+    QCOMPARE(placeOf(result["worker"_L1]), QRect(0, 0, 400, 300));
+}
+
+// Outside the provider, because the provider is gone by the time it reads them.
+static std::weak_ptr<int> s_providerCapture;
+static bool s_providerOutlivedItsReplacement = false;
+
+void tst_QWebEngineExtension::aProviderCanReplaceItselfWhileItIsAsked()
+{
+    // An application may change its answer from inside it, such as on its first call. The engine
+    // holds on to the provider it is calling, so what the provider captured outlives the call.
+    QWebEngineExtensionInfo extension = loadExtensionSync(resourcesPath() + "windows_ext"_L1);
+    QVERIFY(extension.isLoaded());
+    m_manager->setExtensionEnabled(extension, true);
+
+    auto capture = std::make_shared<int>(0);
+    s_providerCapture = capture;
+    s_providerOutlivedItsReplacement = false;
+    QWebEngineExtensionManager *manager = m_manager;
+    m_manager->setWindowGeometryProvider([manager, capture](const QObject *) {
+        manager->setWindowGeometryProvider({});
+        s_providerOutlivedItsReplacement = !s_providerCapture.expired();
+        return QRect(11, 22, 640, 480);
+    });
+    capture.reset();
+    auto forget = qScopeGuard([this] { m_manager->setWindowGeometryProvider({}); });
+
+    QWebEnginePage extensionPage(m_profile);
+    QWebEngineView view;
+    view.setPage(&extensionPage);
+    view.resize(320, 240);
+    view.show();
+    QVERIFY(QTest::qWaitForWindowExposed(&view));
+    extensionPage.load(QUrl("chrome-extension://"_L1 + extension.id() + "/page.html"_L1));
+    const QVariantMap result = windowsReport(&extensionPage);
+    QVERIFY2(!result.isEmpty(), "the extension page never reported");
+    QVERIFY2(!result.contains("error"_L1), qPrintable(result.value("error"_L1).toString()));
+    QVERIFY(s_providerOutlivedItsReplacement);
+    QCOMPARE(placeOf(result["get"_L1]), QRect(11, 22, 640, 480));
+    QCOMPARE(placeOf(result["getCurrent"_L1]), QRect(0, 0, 320, 240));
+}
+
 QTEST_MAIN(tst_QWebEngineExtension)
 #include "tst_qwebengineextension.moc"
