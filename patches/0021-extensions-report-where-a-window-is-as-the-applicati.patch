diff --git a/src/core/api/qwebengineextensionmanager.cpp b/src/core/api/qwebengineextensionmanager.cpp
index f2f0914899..70b18f3e53 100644
--- a/src/core/api/qwebengineextensionmanager.cpp
+++ b/src/core/api/qwebengineextensionmanager.cpp
@@ -183,5 +183,30 @@ bool QWebEngineExtensionManager::event(QEvent *e)
     return QObject::event(e);
 }
 
+/*!
+    Sets the function that answers where the window holding a page is on screen,
+    for the windows an extension reads through \c chrome.windows.
+
+    \a provider is called with the object holding the page the extension's call
+    came from: a QWebEnginePage, or a WebEngineView in Qt Quick. It is called with
+    \c nullptr for a call that no page is behind, such as one from an extension's
+    service worker. It answers with the window's frame geometry in device-independent
+    pixels. A platform that cannot tell a window its position answers \c 0 for
+    \c x and \c y.
+
+    The provider is called on the thread the profile lives on, while the extension
+    waits for its answer, so it must answer at once.
+
+    Without a provider, or when it answers with an invalid QRect, a window is reported
+    at \c{0, 0} with the size of the view the call came from.
+
+    Pass an empty function to stop answering.
+*/
+void QWebEngineExtensionManager::setWindowGeometryProvider(
+        std::function<QRect(const QObject *page)> provider)
+{
+    d_ptr->setWindowGeometryProvider(std::move(provider));
+}
+
 QT_END_NAMESPACE
 #endif // QT_CONFIG(webengine_extensions)
