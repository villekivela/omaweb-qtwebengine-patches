index 3de7934ac9..6dda1a4882 100644
--- a/src/core/extensions/extensions_browser_client_qt.cpp
+++ b/src/core/extensions/extensions_browser_client_qt.cpp
@@ -57,6 +57,7 @@
 #include "extensions_api_client_qt.h"
 #include "extensions_browser_client_qt.h"
 #include "extension_host_delegate_qt.h"
+#include "extension_manager.h"
 #include "content/public/browser/web_contents.h"
 #include "profile_adapter.h"
 #include "profile_adapter_client.h"
@@ -438,6 +439,52 @@ content::WebContents *ExtensionsBrowserClientQt::OpenPage(content::BrowserContex
     return contents;
 }
 
+// The page object the application knows |web_contents| by, or null when the
+// application holds no page for it.
+static QtWebEngineCore::WebContentsAdapterClient *
+clientFor(QtWebEngineCore::ProfileAdapter *adapter, content::WebContents *web_contents)
+{
+    if (!adapter || !web_contents)
+        return nullptr;
+    for (QtWebEngineCore::WebContentsAdapterClient *client : adapter->webContentsAdapterClients()) {
+        QtWebEngineCore::WebContentsAdapter *contents = client->webContentsAdapter();
+        if (contents && contents->isInitialized() && contents->webContents() == web_contents)
+            return client;
+    }
+    return nullptr;
+}
+
+// Where a window is on screen is the application's to say: it is asked about
+// the view or page holding |web_contents|, or about none when no page is behind
+// the call. Without an answer the window is at the top left of the screen and
+// as large as the view the call came from, or the active tab's for a call with
+// no page, so an extension always has four numbers to place a window with.
+gfx::Rect ExtensionsBrowserClientQt::GetWindowBounds(content::BrowserContext *context,
+                                                     content::WebContents *web_contents)
+{
+    auto *profile = static_cast<QtWebEngineCore::ProfileQt *>(context);
+    QtWebEngineCore::ProfileAdapter *adapter = profile->profileAdapter();
+    QtWebEngineCore::WebContentsAdapterClient *asking = clientFor(adapter, web_contents);
+
+    // A copy, because a provider may replace itself while it is called.
+    QtWebEngineCore::ExtensionManager *manager = profile->extensionManager();
+    const QtWebEngineCore::ExtensionManager::WindowGeometryProvider provider =
+            manager ? manager->windowGeometryProvider()
+                    : QtWebEngineCore::ExtensionManager::WindowGeometryProvider();
+    if (provider) {
+        const QRect answer = provider(asking ? asking->holdingQObject() : nullptr);
+        if (answer.isValid())
+            return gfx::Rect(answer.x(), answer.y(), answer.width(), answer.height());
+    }
+
+    // A call from contents the application holds no page for, a worker's or the extension
+    // system's own, is sized like the tab on show.
+    if (!asking)
+        asking = clientFor(adapter, GetActiveTab(context));
+    const QSize size = asking ? asking->viewportRect().size().toSize() : QSize(0, 0);
+    return gfx::Rect(0, 0, size.width(), size.height());
+}
+
 ScriptExecutor *ExtensionsBrowserClientQt::GetScriptExecutorForTab(content::WebContents &web_contents)
 {
     return TabRegistryQt::Get()->GetScriptExecutor(&web_contents);
