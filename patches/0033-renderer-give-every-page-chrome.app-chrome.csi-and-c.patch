+// Chrome's renderer gives every page chrome.app, chrome.csi and chrome.loadTimes, and a page can
+// tell a script's stand-in from them by reading a function's source. The expected answers are
+// Chromium 154's for a page that is not an installed app, in the main world and in a same-origin,
+// an about:blank and a srcdoc frame.
+void tst_QWebEnginePage::windowChromeAnswersAsChromeDoes()
+{
+    HttpServer server;
+    connect(&server, &HttpServer::newRequest, &server, [&](HttpReqRep *r) {
+        r->setResponseHeader("Content-Type", "text/html");
+        if (r->requestPath() == "/frame")
+            r->setResponseBody("<html><body>frame</body></html>");
+        else
+            r->setResponseBody("<html><body><iframe src=\"/frame\"></iframe>"
+                               "<iframe src=\"about:blank\"></iframe>"
+                               "<iframe srcdoc=\"<p>srcdoc</p>\"></iframe></body></html>");
+        r->sendResponse();
+    });
+    QVERIFY(server.start());
+
+    QWebEnginePage page;
+    QSignalSpy loadSpy(&page, &QWebEnginePage::loadFinished);
+    page.load(server.url("/"));
+    QTRY_COMPARE(loadSpy.size(), 1);
+
+    const auto answer = [&](const QString &window) {
+        return evaluateJavaScriptSync(&page, QStringLiteral(
+                "(() => { const c = %1.chrome; if (!c) return 'no chrome'; return ["
+                "Object.keys(c).sort().join(','), typeof c.app,"
+                "c.app && Object.getOwnPropertyNames(c.app).sort().join(','),"
+                "c.app && c.app.isInstalled, c.app && c.app.getDetails.toString(),"
+                "c.app && String(c.app.getDetails()), c.app && c.app.runningState(),"
+                "c.app && JSON.stringify(c.app.InstallState),"
+                "typeof c.csi, c.csi && c.csi.toString(),"
+                "c.csi && Object.keys(c.csi()).sort().join(','),"
+                "typeof c.loadTimes, c.loadTimes && c.loadTimes.toString(),"
+                "c.loadTimes && typeof c.loadTimes().requestTime].join(' | '); })()")
+                .arg(window)).toString();
+    };
+    const QString chrome = QStringLiteral(
+            "app,csi,loadTimes | object"
+            " | InstallState,RunningState,getDetails,getIsInstalled,installState,isInstalled,"
+            "runningState"
+            " | false | function getDetails() { [native code] } | null | cannot_run"
+            " | {\"DISABLED\":\"disabled\",\"INSTALLED\":\"installed\","
+            "\"NOT_INSTALLED\":\"not_installed\"}"
+            " | function | function () { [native code] } | onloadT,pageT,startE,tran"
+            " | function | function () { [native code] } | number");
+    QCOMPARE(answer(QStringLiteral("window")), chrome);
+    QCOMPARE(answer(QStringLiteral("window.frames[0]")), chrome);
+    QCOMPARE(answer(QStringLiteral("window.frames[1]")), chrome);
+    QCOMPARE(answer(QStringLiteral("window.frames[2]")), chrome);
+
+    // The one answer that comes from the browser.
+    evaluateJavaScriptSync(&page, "chrome.app.installState(s => window.installState = s)");
+    QTRY_COMPARE(evaluateJavaScriptSync(&page, "window.installState").toString(),
+                 QStringLiteral("not_installed"));
+}
