index 0000000000..968723bb6d
--- /dev/null
+++ b/tests/auto/widgets/extensions/resources/clipboard_ext/page.js
@@ -0,0 +1,21 @@
+// A password manager copies and pastes through a selected text area.
+const area = document.querySelector("textarea");
+function copy(text) {
+    area.value = text;
+    area.select();
+    return document.execCommand("copy");
+}
+function paste() {
+    area.value = "";
+    area.select();
+    return document.execCommand("paste") ? area.value : "refused";
+}
+// An offscreen document is not a privileged page, so it writes only with clipboardWrite.
+function copyOffscreen() {
+    chrome.runtime.onMessage.addListener((message) => document.title = message);
+    chrome.offscreen.createDocument({
+        url: "offscreen.html",
+        reasons: ["CLIPBOARD"],
+        justification: "test"
+    }).catch((error) => document.title = "failed: " + error.message);
+}
