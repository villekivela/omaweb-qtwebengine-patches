+#include "qtwebengine/browser/extensions/api/web_navigation/web_navigation_api.h"
+
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/render_process_host.h"
+#include "content/public/browser/web_contents.h"
+#include "extensions/browser/extension_api_frame_id_map.h"
+#include "qtwebengine/browser/extensions/tab_registry_qt.h"
+#include "qtwebengine/common/extensions/api/web_navigation.h"
+
+namespace extensions {
+
+namespace {
+
+namespace GetFrame = api::web_navigation::GetFrame;
+namespace GetAllFrames = api::web_navigation::GetAllFrames;
+
+// Chrome reports only frames whose URL an extension may see; a frame that has not committed
+// anything yet has none.
+bool IsReportable(content::RenderFrameHost* frame) {
+  const GURL& url = frame->GetLastCommittedURL();
+  return url.is_valid() && !url.is_empty();
+}
+
+// What both functions say about a frame, filled the same way so the two never disagree.
+template <typename Details>
+void Describe(content::RenderFrameHost* frame, Details* details) {
+  details->url = frame->GetLastCommittedURL().spec();
+  details->error_occurred = frame->IsErrorDocument();
+  details->document_id = ExtensionApiFrameIdMap::GetDocumentId(frame).ToString();
+  if (content::RenderFrameHost* parent = frame->GetParentOrOuterDocument()) {
+    details->parent_document_id = ExtensionApiFrameIdMap::GetDocumentId(parent).ToString();
+  }
+  details->frame_type = ExtensionApiFrameIdMap::GetFrameType(frame);
+  details->document_lifecycle = ExtensionApiFrameIdMap::GetDocumentLifecycle(frame);
+}
+
+}  // namespace
+
+ExtensionFunction::ResponseAction WebNavigationGetFrameFunction::Run() {
+  std::optional<GetFrame::Params> params = GetFrame::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  content::RenderFrameHost* frame = nullptr;
+  if (params->details.document_id) {
+    ExtensionApiFrameIdMap::DocumentId document_id =
+        ExtensionApiFrameIdMap::DocumentIdFromString(*params->details.document_id);
+    if (!document_id)
+      return RespondNow(Error("Invalid documentId."));
+    frame = ExtensionApiFrameIdMap::Get()->GetRenderFrameHostByDocumentId(document_id);
+    if (!frame)
+      return RespondNow(WithArguments(base::Value()));
+    // Found by a global lookup, so it may belong to another profile.
+    content::WebContents* contents = content::WebContents::FromRenderFrameHost(frame);
+    if (!contents || contents->GetBrowserContext() != browser_context())
+      return RespondNow(WithArguments(base::Value()));
+    const int tab_id = TabRegistryQt::Get()->GetTabId(contents);
+    const int frame_id = ExtensionApiFrameIdMap::GetFrameId(frame);
+    if ((params->details.tab_id && *params->details.tab_id != tab_id) ||
+        (params->details.frame_id && *params->details.frame_id != frame_id)) {
+      return RespondNow(WithArguments(base::Value()));
+    }
+  } else {
+    if (!params->details.tab_id || !params->details.frame_id) {
+      return RespondNow(Error("Either documentId or both tabId and frameId must be specified."));
+    }
+    content::WebContents* contents =
+        TabRegistryQt::Get()->GetWebContents(browser_context(), *params->details.tab_id);
+    if (!contents)
+      return RespondNow(WithArguments(base::Value()));
+    frame = ExtensionApiFrameIdMap::Get()->GetRenderFrameHostById(contents,
+                                                                  *params->details.frame_id);
+  }
+
+  if (!frame || !IsReportable(frame))
+    return RespondNow(WithArguments(base::Value()));
+
+  GetFrame::Results::Details details;
+  Describe(frame, &details);
+  details.parent_frame_id = ExtensionApiFrameIdMap::GetParentFrameId(frame);
+  return RespondNow(ArgumentList(GetFrame::Results::Create(details)));
+}
+
+ExtensionFunction::ResponseAction WebNavigationGetAllFramesFunction::Run() {
+  std::optional<GetAllFrames::Params> params = GetAllFrames::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+
+  content::WebContents* contents =
+      TabRegistryQt::Get()->GetWebContents(browser_context(), params->details.tab_id);
+  if (!contents)
+    return RespondNow(WithArguments(base::Value()));
+
+  std::vector<GetAllFrames::Results::DetailsType> frames;
+  contents->ForEachRenderFrameHostWithAction([contents, &frames](
+                                                 content::RenderFrameHost* frame) {
+    // An inner WebContents is not part of this tab's frame tree, as far as an extension is told.
+    if (content::WebContents::FromRenderFrameHost(frame) != contents)
+      return content::RenderFrameHost::FrameIterationAction::kSkipChildren;
+    // A frame kept for back/forward is not a frame the page is showing.
+    if (frame->IsInLifecycleState(content::RenderFrameHost::LifecycleState::kInBackForwardCache))
+      return content::RenderFrameHost::FrameIterationAction::kSkipChildren;
+    if (!IsReportable(frame))
+      return content::RenderFrameHost::FrameIterationAction::kContinue;
+
+    GetAllFrames::Results::DetailsType details;
+    Describe(frame, &details);
+    details.frame_id = ExtensionApiFrameIdMap::GetFrameId(frame);
+    details.parent_frame_id = ExtensionApiFrameIdMap::GetParentFrameId(frame);
+    details.process_id = frame->GetProcess()->GetDeprecatedID();
+    frames.push_back(std::move(details));
+    return content::RenderFrameHost::FrameIterationAction::kContinue;
+  });
+
+  return RespondNow(ArgumentList(GetAllFrames::Results::Create(frames)));
+}
+
+}  // namespace extensions
