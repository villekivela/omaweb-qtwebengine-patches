+void tst_QWebEngineExtension::aMessageSentWhileTheWorkerIsStartingIsDelivered()
+{
+    // A real password manager's worker takes seconds to start, and the first page a browser
+    // opens sends it a message before it is listening. Chrome parks the message until the worker
+    // is ready. The fixture's worker spends its first moments busy, so the content script's
+    // message lands in exactly that window.
+    QWebEngineExtensionInfo extension = loadExtensionSync(resourcesPath() + "slow_worker_ext"_L1);
+    QVERIFY(extension.isLoaded());
+    m_manager->setExtensionEnabled(extension, true);
+
+    QSignalSpy loadSpy(m_page, SIGNAL(loadFinished(bool)));
+    m_page->load(QUrl("qrc:///resources/index.html"));
+    QTRY_COMPARE(loadSpy.size(), 1);
+    QTRY_COMPARE_WITH_TIMEOUT(
+            evaluateJavaScriptSync(m_page, "document.getElementById('testNode')?.textContent"),
+            "pong after a slow start"_L1, 10000);
+}
+
+void tst_QWebEngineExtension::aWorkerThatListensLateCanReachThePageThatAlreadyAsked()
+{
+    // Bitwarden's worker registers its message listener inside asynchronous set-up, long after
+    // its script has evaluated, so the first page's message finds no listener and is dropped, in
+    // Chrome as here. Chrome users never notice because the worker then reaches back into every
+    // open tab with tabs.query and scripting.executeScript. That recovery runs on the tabs and
+    // scripting namespaces this series provides, and it has to find the page that was open first.
+    HttpServer server;
+    server.setResourceDirs({ resourcesPath() });
+    QVERIFY(server.start());
+
+    QWebEngineExtensionInfo extension =
+            loadExtensionSync(resourcesPath() + "late_listener_ext"_L1);
+    QVERIFY(extension.isLoaded());
+    m_manager->setExtensionEnabled(extension, true);
+
+    QSignalSpy loadSpy(m_page, SIGNAL(loadFinished(bool)));
+    m_page->load(server.url("/index.html"_L1));
+    QTRY_COMPARE(loadSpy.size(), 1);
+    // The first message is lost, as it is in Chrome: nothing was listening.
+    QTRY_COMPARE(evaluateJavaScriptSync(m_page, "document.getElementById('firstTry')?.textContent"),
+                 "lost"_L1);
+    QTRY_COMPARE_WITH_TIMEOUT(
+            evaluateJavaScriptSync(m_page, "document.getElementById('injected')?.textContent"),
+            "reached by the worker"_L1, 10000);
+}
