+#ifndef QTWEBENGINE_BROWSER_EXTENSIONS_API_WEB_NAVIGATION_WEB_NAVIGATION_API_H_
+#define QTWEBENGINE_BROWSER_EXTENSIONS_API_WEB_NAVIGATION_WEB_NAVIGATION_API_H_
+
+#include "extensions/browser/extension_function.h"
+
+namespace extensions {
+
+// The frames of a tab, read off the tab's WebContents. Chrome answers these from a per-document
+// navigation state its tab-strip observer maintains; QtWebEngine has no tab strip, and the frame
+// itself already knows its URL and whether it is an error document, so the answer comes from
+// there. A password manager reaches back into every frame of every open tab this way when its
+// worker has finished starting, and a page that was open first is only reached if this answers.
+class WebNavigationGetFrameFunction : public ExtensionFunction {
+  ~WebNavigationGetFrameFunction() override {}
+  ResponseAction Run() override;
+  DECLARE_EXTENSION_FUNCTION("webNavigation.getFrame", WEBNAVIGATION_GETFRAME)
+};
+
+class WebNavigationGetAllFramesFunction : public ExtensionFunction {
+  ~WebNavigationGetAllFramesFunction() override {}
+  ResponseAction Run() override;
+  DECLARE_EXTENSION_FUNCTION("webNavigation.getAllFrames", WEBNAVIGATION_GETALLFRAMES)
+};
+
+}  // namespace extensions
+
+#endif  // QTWEBENGINE_BROWSER_EXTENSIONS_API_WEB_NAVIGATION_WEB_NAVIGATION_API_H_
