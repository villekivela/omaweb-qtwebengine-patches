diff --git a/tests/auto/widgets/extensions/resources/late_listener_ext/service_worker.js b/tests/auto/widgets/extensions/resources/late_listener_ext/service_worker.js
new file mode 100644
index 0000000000..cae021ec62
--- /dev/null
+++ b/tests/auto/widgets/extensions/resources/late_listener_ext/service_worker.js
@@ -0,0 +1,29 @@
+// A worker that, like a real password manager's, registers its listener only
+// after asynchronous set-up, and then reaches back into every page that was
+// already open, because any message those pages sent in the meantime was lost.
+// It reaches them the way Bitwarden does: every frame of every tab, by
+// webNavigation.getAllFrames, then scripting.executeScript into each.
+setTimeout(async () => {
+    chrome.runtime.onMessage.addListener((message, _, sendResponse) => {
+        sendResponse("late")
+        return true
+    })
+    const tabs = await chrome.tabs.query({})
+    for (const tab of tabs) {
+        if (!tab.id || !tab.url?.startsWith("http"))
+            continue
+        const frames = await new Promise(resolve =>
+            chrome.webNavigation.getAllFrames({ tabId: tab.id }, resolve))
+        for (const frame of frames ?? []) {
+            chrome.scripting.executeScript({
+                target: { tabId: tab.id, frameIds: [frame.frameId] },
+                func: () => {
+                    let node = document.createElement("div")
+                    node.id = "injected"
+                    node.textContent = "reached by the worker"
+                    document.documentElement.appendChild(node)
+                }
+            })
+        }
+    }
+}, 1500)
