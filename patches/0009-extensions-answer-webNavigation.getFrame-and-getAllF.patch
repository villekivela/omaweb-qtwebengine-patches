diff --git a/tests/auto/widgets/extensions/resources/slow_worker_ext/service_worker.js b/tests/auto/widgets/extensions/resources/slow_worker_ext/service_worker.js
new file mode 100644
index 0000000000..e4695f17f1
--- /dev/null
+++ b/tests/auto/widgets/extensions/resources/slow_worker_ext/service_worker.js
@@ -0,0 +1,10 @@
+// A worker that takes its time to start, the way a real password manager's
+// does: its top level runs for a while before the listener is registered.
+// A message sent by a page in that window has to wait for it, not vanish.
+const started = Date.now()
+while (Date.now() - started < 1500) {}
+chrome.runtime.onMessage.addListener((message, _, sendResponse) => {
+    if (message === "ping")
+        sendResponse("pong after a slow start")
+    return true
+})
